{
  "version": 1,
  "fast": {
    "enabled": true,
    "modes": ["light", "standard", "legacy-refactor"]
  },
  "auto": {
    "enabled": true,
    "modes": ["light", "standard", "legacy-refactor"]
  },
  "areas": [
    {"name": "駆動", "common": true,
     "paths": ["plugins/ndf/src/ndf/core/plan/**", "plugins/ndf/src/ndf/progress/**", "plugins/ndf/src/ndf/domains/relay/**",
               "plugins/ndf/src/ndf/domains/cross*/**"]},
    {"name": "共通の部品と結果の契約", "common": true, "paths": ["plugins/ndf/src/ndf/**"]},
    {"name": "hook", "common": true, "paths": ["plugins/ndf/hooks/**", "plugins/ndf/src/ndf/domains/hooks/guards/**"]},
    {"name": "リリースの手順", "common": true,
     "paths": ["plugins/ndf/src/ndf/domains/release/**",
               "plugins/ndf/src/ndf/domains/worktree/**", "scripts/build-runtime-plugins.sh"]}
  ],
  "boundary_paths": ["plugins/ndf/src/ndf/adapters/github.py", "plugins/ndf/src/ndf/adapters/git.py",
                     "plugins/ndf/skills/google-workspace/**", ".github/workflows/**", "**/.env*"],
  "triggers": {"score": 10, "common_weight": 2, "lines": 3000, "escapes": 1, "hours": 24},
  "loop": {
    "enabled": true,
    "budget": {"laps": 1000, "hours": 10000}
  }
}
