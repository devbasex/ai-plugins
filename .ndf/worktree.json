{
  "version": 1,
  "base_branch": "develop",
  "production_branch": "main",
  "guard": {
    "allow_paths": [
      "issues/",
      "docs/",
      ".claude/",
      ".codex/",
      ".kiro/",
      ".agents/",
      ".serena/",
      ".ndf/",
      ".gitignore"
    ]
  },
  "branch_flow": {
    "start": "base",
    "integrate": "check",
    "doc_prs": "base",
    "promotion": "whole",
    "reviews": {
      "impl": {
        "checks": [],
        "diff": "none"
      },
      "sprint": {
        "checks": [
          "cross-refactoring",
          "cross-review"
        ],
        "diff": "unchecked"
      }
    }
  }
}
