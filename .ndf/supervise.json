{
  "version": 1,
  "test": {
    "command": "uv run --frozen --project . --all-extras pytest {paths} -q -n 4",
    "all": ".",
    "no_reports": "-p no:playwright-kit"
  },
  "sync_checks": [
    {"name": "build", "command": "bash scripts/build-runtime-plugins.sh"},
    {"name": "frontmatter", "command": "python3 scripts/check-skill-frontmatter.py"},
    {"name": "line-limit", "command": "python3 scripts/check-doc-line-limit.py"},
    {"name": "links", "command": "python3 scripts/check-markdown-links.py"},
    {"name": "instructions", "command": "python3 plugins/ndf/scripts/instructions-check.py --root ."},
    {"name": "validate", "command": "bash scripts/validate-runtime-plugins.sh"},
    {"name": "lint", "command": "bash scripts/check-lint.sh"}
  ],
  "queue": {
    "shared": [
      {"path": "plugins/ndf/scripts/lib/README.md", "touched_by": ["plugins/ndf/scripts/lib/"]}
    ]
  },
  "release": {
    "form": "package-plugin",
    "plugin": "ndf",
    "runtimes": ["claude", "codex", "kiro"]
  }
}
