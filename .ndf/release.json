{
  "$schema": "https://raw.githubusercontent.com/devbasex/ai-plugins/main/plugins/ndf/skills/release/schemas/release.schema.json",
  "version": 1,
  "steps": [
    {
      "name": "版数の記載をそろえる",
      "stage": "production",
      "command": ["python3", "scripts/sync-version-mentions.py", "--root", "."],
      "writes": ["README.md", "docs/versioning-and-distribution.md", "plugins/ndf/README.md", ".claude-plugin/marketplace.json", "plugins/playwright-kit/plugin.json"],
      "timeout_seconds": 300
    },
    {
      "name": "トークン消費の記録",
      "stage": "production",
      "command": ["python3", "scripts/token-usage-snapshot.py", "--released", "{version}"],
      "writes": ["docs/metrics/ndf-token-usage/"],
      "guide": "docs/metrics/ndf-token-usage/README.md",
      "timeout_seconds": 600
    }
  ]
}
