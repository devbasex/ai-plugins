      "values": ["auto", "manual"]
    },
    {
      "id": "release-form",
      "source": {"files": "plugins/ndf-next/skills/release/references/form-*.md", "prefix": "form-"},
      "values": ["desktop", "document", "mobile", "package-plugin", "page", "procedure", "service", "slide", "spreadsheet"]
    }
  ],
  "removed": []
}
