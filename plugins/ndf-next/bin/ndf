#!/usr/bin/env bash
# エントリポイント。uv.lock が固定する依存の仮想環境を用意し、`bin/start.py` で欠けを確かめてから `python -m ndf` を呼ぶ。
# 仮想環境はプラグインの外（`<キャッシュのホーム>/<プラグイン名>/venv/<版>`）に置き、版ごとに分ける。
# プラグインの根はこのファイルの実体の位置から求め、子へ CLAUDE_PLUGIN_ROOT で渡す（ほかのプラグインの値を引き継がない）。
#
# 見つけ方: 呼ぶ側はパスを書かず、名前 `ndf` で呼ぶ。
# - Claude Code は、有効なプラグインの `bin/` を Bash の PATH へ足すので、`ndf` で見つかる
# - それ以外（Codex・端末）は、PATH の上に置いたこのファイルへのシンボリックリンクで呼ぶ。リンクをたどって
#   実体の位置から根を求めるので、リンクの置き場は問わない
#
# uv が無いとき: 版を固定した uv（UV_VERSION）を `<キャッシュのホーム>/<プラグイン名>/uv/<版>` へ入れてから続ける。
# - 公式のインストーラを取り、埋めたハッシュ（UV_INSTALLER_SHA256）と照合してから実行する。インストーラは
#   各アーカイブのハッシュを持ち、展開の前に照合するので、ここでインストーラを固定すると導入物まで固定される
# - 取得と導入は呼ぶごとの一時ディレクトリで行い、できた uv を名前の変更（mv）で置く。同時に起動しても
#   互いのインストーラを上書き・削除しない
# 入れられない（curl が無い・ネットワークが無い・ハッシュが違うなど）ときは、理由を結果 JSON（stopped・deps_missing）で出し、
# 終了コードの表（contracts/facts/exit-codes.json）の deps_missing の終了コードで止まる。
#
# 呼び出し元の CLAUDE_PLUGIN_ROOT は、子へ自分の根を渡す前に NDF_CALLER_PLUGIN_ROOT へ写す。Python 側は
# それを読み、ほかのプラグインの根なら旧い状態の置き場を退避しない（identity.py）。
set -euo pipefail

UV_VERSION="0.13.7"
# https://github.com/astral-sh/uv/releases/download/0.13.7/uv-installer.sh の sha256（astral.sh の配信と同じ中身）
UV_INSTALLER_SHA256="d263ee68314cf5bea36b08e6bd9e2c4563240d7adb73756cf33af5c199b92db4"

# このファイルの実体のパス（シンボリックリンクをたどる。bash 3.2 と macOS の readlink で動く形）
self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  dir="$(cd -P "$(dirname "$self")" && pwd)"
  self="$(readlink "$self")"
  case "$self" in /*) ;; *) self="$dir/$self" ;; esac
done
root="$(cd -P "$(dirname "$self")/.." && pwd)"
manifest="$root/.claude-plugin/plugin.json"
if ! meta="$(python3 -c 'import json, sys; d = json.load(open(sys.argv[1])); print(d["name"]); print(d["version"])' "$manifest" 2>&1)"; then
  printf '%s\n' "plugin.json を読めない: $manifest: $meta" >&2
  exit 2
fi
{ read -r name; read -r version; } <<<"$meta"
cache_home="${XDG_CACHE_HOME:-$HOME/.cache}/$name"

# 依存の欠けを結果 JSON 1 行で出して止まる（Python の ndf を起こせないので、ここで組む）
# 終了コードは終了コードの表の deps_missing の行から引き、python3 の終了コードをそのまま返す
stop_deps_missing() {
  printf '%s\n' "$1" >&2
  local code=0
  python3 -c '
import json, sys
detail, table = sys.argv[1], sys.argv[2]
print(json.dumps({"tool": "cli", "status": "stopped", "summary": detail, "items": [], "metrics": {}, "cause": {"kind": "deps_missing", "detail": detail}}, ensure_ascii=False))
with open(table, encoding="utf-8") as f:
    sys.exit(next(row["code"] for row in json.load(f)["rows"] if row["id"] == "deps_missing"))
' "$1" "$root/contracts/facts/exit-codes.json" || code=$?
  exit "$code"
}

uv_bin="$(command -v uv || true)"
if [ -z "$uv_bin" ]; then
  uv_dir="$cache_home/uv/$UV_VERSION"
  uv_bin="$uv_dir/uv"
  if [ ! -x "$uv_bin" ]; then
    if ! command -v curl >/dev/null 2>&1; then
      stop_deps_missing "uv が無く、入れるための curl も無い（https://docs.astral.sh/uv/ から uv $UV_VERSION を入れる）"
    fi
    mkdir -p "$cache_home/uv"
    work="$(mktemp -d "$cache_home/uv/.install.XXXXXX")"
    installer="$work/install.sh"
    if ! log="$(curl -LsSf "https://astral.sh/uv/$UV_VERSION/install.sh" -o "$installer" 2>&1)" \
      || ! log="$(python3 -c '
import hashlib, sys
path, want = sys.argv[1], sys.argv[2]
with open(path, "rb") as f:
    got = hashlib.sha256(f.read()).hexdigest()
if got != want:
    sys.exit(f"インストーラのハッシュが違う（{got}）")
' "$installer" "$UV_INSTALLER_SHA256" 2>&1)" \
      || ! log="$(env UV_UNMANAGED_INSTALL="$work/bin" sh "$installer" 2>&1)" || [ ! -x "$work/bin/uv" ] \
      || ! log="$(mkdir -p "$uv_dir" && mv -f "$work/bin/uv" "$uv_bin" 2>&1)"; then
      rm -rf "$work"
      stop_deps_missing "uv が無く、uv $UV_VERSION を $uv_dir へ入れられない（ネットワークを確かめる）: $(printf '%s' "$log" | tail -n 1)"
    fi
    rm -rf "$work"
  fi
fi

export NDF_CALLER_PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-}"
export CLAUDE_PLUGIN_ROOT="$root"
export UV_PROJECT_ENVIRONMENT="$cache_home/venv/$version"
export PYTHONPATH="$root/src${PYTHONPATH:+:$PYTHONPATH}"
# -P: 呼び出し元のディレクトリとこのディレクトリを import の探索先に入れない（利用先の ndf.py・json.py を読まない）。
# start.py は依存の環境の欠けを確かめてから `python -m ndf` と同じに呼ぶ（欠けていれば入れ直しの手順で止まる。#2447）
exec "$uv_bin" run --frozen --no-dev --quiet --project "$root" python -P "$root/bin/start.py" "$@"
