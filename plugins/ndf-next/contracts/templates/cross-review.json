{
  "template": "cross-review",
  "purpose": "review",
  "summary": "レビュー: レビューの起動 → push（レビューが直したコミットを載せる）。レビューが終わり切らなくても（incomplete）push まで進める",
  "params": ["repo", "worktree", "branch", "review", "worker"],
  "plan": {
    "name": "cross-review-{{branch}}",
    "repo": "{{repo}}",
    "worktree": "{{worktree}}",
    "steps": [
      {"id": "review", "run": ["{{review}}"], "on_cause": {"incomplete": "push"}},
      {"use": "push", "on_fail": "fix-push", "next": "end"},
      {"use": "fix-push"}
    ]
  }
}
