{
  "summary": "雛形どうしで共有するステップ。雛形のステップは {\"use\": \"<名前>\"} で 1 つを引き、並べた鍵で上書きする（上書きは鍵ごとに置き換える）",
  "steps": {
    "test": {
      "id": "test",
      "run": ["ndf", "route", "test", "--result", "{state_dir}/test.json", "--", "{{test_command}}"]
    },
    "test-repeat": {
      "id": "test-repeat",
      "run": ["ndf", "route", "repeat", "--result", "{state_dir}/test.json", "--log", "{state_dir}/test-causes.jsonl"],
      "next": "fix"
    },
    "worker": {
      "id": "work",
      "run": ["{{worker}}", "impl"]
    },
    "push": {
      "id": "push",
      "run": ["git", "push", "origin", "HEAD:refs/heads/{{branch}}"],
      "probe": ["sh", "-c", "test \"$(git ls-remote origin \"refs/heads/$0\" | cut -f1)\" = \"$(git rev-parse HEAD)\"", "{{branch}}"],
      "exit_cause": {"1": "push_rejected"},
      "on_cause": {"push_rejected": "retry"},
      "retry": {"push_rejected": {"attempts": 1, "interval": 30}}
    },
    "pr": {
      "id": "pr",
      "run": [
        "sh", "-c",
        "gh pr create --base \"$1\" --head \"$0\" --title \"$2\" --body-file \"$3\" >&2 || exit 1; n=$(gh pr view \"$0\" --json number --jq .number) && [ -n \"$n\" ] || exit 1; printf '{\"status\": \"ok\", \"summary\": \"PR #%s\", \"items\": [{\"kind\": \"pr\", \"number\": %s}]}\\n' \"$n\" \"$n\"",
        "{{branch}}", "{{base}}", "{{title}}", "{{body_file}}"
      ],
      "probe": [
        "sh", "-c",
        "n=$(gh pr list --head \"$0\" --state open --json number --jq '.[0].number // empty'); [ -n \"$n\" ] || exit 1; printf '{\"status\": \"ok\", \"summary\": \"PR #%s\", \"items\": [{\"kind\": \"pr\", \"number\": %s}]}\\n' \"$n\" \"$n\"",
        "{{branch}}"
      ]
    },
    "work-start": {
      "id": "work-start",
      "run": ["sh", "-c", "[ -s \"$0\" ] || git rev-parse HEAD > \"$0\"", "{state_dir}/work-start"]
    },
    "changes-check": {
      "id": "changes-check",
      "run": ["sh", "-c", "s=$(cat \"$0\") && [ -n \"$s\" ] || exit 2; git diff --quiet \"$s\" HEAD; r=$?; [ \"$r\" -eq 0 ] && exit 1; [ \"$r\" -eq 1 ] && exit 0; exit 2", "{state_dir}/work-start"],
      "exit_cause": {"1": "not_applicable", "2": "precondition"},
      "on_cause": {"not_applicable": "end"}
    },
    "conflict-check": {
      "id": "conflict-check",
      "run": ["sh", "-c", "test \"$(gh pr view \"$0\" --json mergeStateStatus --jq .mergeStateStatus)\" != DIRTY", "{{branch}}"],
      "exit_cause": {"1": "base_conflict"},
      "on_cause": {"base_conflict": "base-sync"}
    },
    "ci": {
      "id": "ci",
      "run": [
        "bash", "-c",
        "set -o pipefail; pr=$(gh pr view \"$1\" --json number --jq .number) || exit 1; out=$2; shift 2; ndf ci watch --pr \"$pr\" \"$@\" | tee \"$out\"",
        "ci", "{{branch}}", "{state_dir}/ci.json", "--budget", "{{ci_budget}}", "--required={{required}}", "--test={{tests}}"
      ],
      "on_cause": {"test_failed": "repeat-check", "base_conflict": "base-sync"}
    },
    "repeat-check": {
      "id": "repeat-check",
      "run": ["ndf", "route", "repeat", "--result", "{state_dir}/ci.json", "--log", "{state_dir}/ci-causes.jsonl"],
      "next": "ci-fix"
    },
    "ci-fix": {
      "id": "ci-fix",
      "run": ["{{worker}}", "ci-fix"],
      "next": "ci-local"
    },
    "ci-local": {
      "id": "ci-local",
      "run": ["ndf", "route", "test", "--nodes-from", "{state_dir}/ci.json", "--", "{{test_command}}"],
      "on_cause": {"test_failed": "repeat-check"},
      "next": "push"
    },
    "base-sync": {
      "id": "base-sync",
      "run": ["git", "pull", "--no-rebase", "--no-edit", "origin", "{{base}}"],
      "exit_cause": {"1": "base_conflict"},
      "on_cause": {"base_conflict": "fix-base"},
      "next": "push"
    },
    "fix-base": {
      "id": "fix-base",
      "run": ["{{worker}}", "fix-base"],
      "next": "push"
    },
    "fix-push": {
      "id": "fix-push",
      "run": ["{{worker}}", "fix-push"],
      "next": "push"
    },
    "merge-gate": {
      "id": "merge-gate",
      "run": ["{{gate}}"],
      "on_answer": {"approved": "merge", "rejected": "end"}
    },
    "merge": {
      "id": "merge",
      "run": [
        "sh", "-c",
        "h=$(git rev-parse HEAD) || exit 2; gh pr merge \"$0\" \"--$1\" --match-head-commit \"$h\" >&2 || exit 1; s=$(gh pr view \"$0\" --json state --jq .state) || exit 1; [ \"$s\" = MERGED ] && exit 0; printf '{\"status\": \"stopped\", \"summary\": \"PR はまだマージされていない（%s。マージキューの待ち）\", \"cause\": {\"kind\": \"ci_pending\", \"detail\": \"マージキューの待ち\"}}\\n' \"$s\"; exit 1",
        "{{branch}}", "{{merge_method}}"
      ],
      "probe": ["sh", "-c", "test \"$(gh pr view \"$0\" --json state --jq .state)\" = MERGED", "{{branch}}"],
      "exit_cause": {"2": "precondition"}
    }
  }
}
