{
  "template": "release-verification",
  "purpose": "release_verification",
  "summary": "リリース後テスト: worker が出した版（入力の version）を実際に使って受け入れ条件を確かめる",
  "params": ["repo", "worker"],
  "plan": {
    "name": "release-verification",
    "repo": "{{repo}}",
    "steps": [
      {"id": "work", "run": ["{{worker}}", "release-verification"]}
    ]
  }
}
