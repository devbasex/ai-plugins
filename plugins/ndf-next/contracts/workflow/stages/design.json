{
  "document": {
    "dsl": "1.0.3",
    "namespace": "ndf",
    "name": "design",
    "version": "1.0.0"
  },
  "input": {
    "schema": {
      "resource": {
        "endpoint": "file:///workflow/stage-io.schema.json#/$defs/stage-in"
      }
    }
  },
  "output": {
    "schema": {
      "resource": {
        "endpoint": "file:///workflow/stage-io.schema.json#/$defs/stage-out"
      }
    }
  },
  "metadata": {
    "ndf": {
      "stage": "設計",
      "phase": "design",
      "inputs": [
        "issues",
        "worktree"
      ],
      "outputs": [
        "design_pr"
      ]
    }
  },
  "do": [
    {
      "design": {
        "call": "ndf.plan",
        "with": {
          "plan": "design"
        },
        "metadata": {
          "ndf": {
            "kind": "work",
            "range": "none"
          }
        },
        "output": {
          "schema": {
            "resource": {
              "endpoint": "file:///workflow/stage-io.schema.json#/$defs/report"
            }
          }
        }
      }
    },
    {
      "design-review": {
        "call": "ndf.plan",
        "with": {
          "plan": "cross-review"
        },
        "metadata": {
          "ndf": {
            "kind": "review",
            "range": "sprint_diff",
            "subject": "design"
          }
        },
        "output": {
          "schema": {
            "resource": {
              "endpoint": "file:///workflow/stage-io.schema.json#/$defs/report"
            }
          }
        }
      }
    },
    {
      "design-gate": {
        "listen": {
          "to": {
            "one": {
              "with": {
                "type": "answered"
              }
            }
          }
        },
        "metadata": {
          "ndf": {
            "kind": "gate",
            "range": "none",
            "gate": "design",
            "modes": [
              "documentation",
              "legacy-refactor",
              "standard"
            ]
          }
        },
        "output": {
          "schema": {
            "resource": {
              "endpoint": "file:///workflow/stage-io.schema.json#/$defs/gate-answer"
            }
          }
        }
      }
    },
    {
      "design-merge": {
        "call": "ndf.plan",
        "with": {
          "plan": "design-merge"
        },
        "metadata": {
          "ndf": {
            "kind": "merge",
            "range": "none"
          }
        },
        "output": {
          "schema": {
            "resource": {
              "endpoint": "file:///workflow/stage-io.schema.json#/$defs/report"
            }
          }
        }
      }
    }
  ]
}
