{
  "document": {
    "dsl": "1.0.3",
    "namespace": "ndf",
    "name": "layout-review",
    "version": "1.0.0"
  },
  "input": {
    "schema": {
      "resource": {
        "endpoint": "file:///workflow/stage-io.schema.json#/$defs/stage-in"
      }
    }
  },
  "output": {
    "schema": {
      "resource": {
        "endpoint": "file:///workflow/stage-io.schema.json#/$defs/stage-out"
      }
    }
  },
  "metadata": {
    "ndf": {
      "stage": "体裁レビュー",
      "phase": "close",
      "inputs": [
        "version"
      ]
    }
  },
  "do": [
    {
      "layout-review": {
        "call": "ndf.plan",
        "with": {
          "plan": "layout-review"
        },
        "metadata": {
          "ndf": {
            "kind": "verify",
            "range": "released"
          }
        },
        "output": {
          "schema": {
            "resource": {
              "endpoint": "file:///workflow/stage-io.schema.json#/$defs/report"
            }
          }
        }
      }
    }
  ]
}
