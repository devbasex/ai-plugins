{
  "version": 1,
  "summary": "進行表の状態・事象の種類と書き手の表・承認ゲートの語・ブランチの接頭辞。事象を追記する関数（ndf.progress.store.append_events）が、書く前にこの表で書き手と遷移を確かめる",
  "row_states": {
    "sprint": ["pending", "running", "finished", "failed", "disabled", "cancelled"],
    "lane": ["pending", "running", "completed", "cancelled"]
  },
  "table_states": {
    "sprint": {"initial": "running", "states": ["running", "completed", "cancelled"]},
    "plan": {"initial": "pending", "states": ["pending", "running", "completed", "cancelled"]}
  },
  "terminal": ["finished", "disabled", "cancelled", "completed"],
  "labels": {
    "pending": "未着手",
    "running": "実行中",
    "finished": "終了",
    "failed": "失敗",
    "disabled": "無効",
    "cancelled": "中止",
    "completed": "完了"
  },
  "actors": {
    "conductor": "レーンの conductor（進行表のスクリプト ndf progress を打つ）",
    "workflow": "進行表のワークフロー（耐久ワークフロー。工程を流す）",
    "organizer": "オーガナイザー",
    "durable": "計画の耐久ワークフロー（レーンを起こす）"
  },
  "events": [
    {"level": "sprint", "kind": "created", "actors": ["conductor"], "scope": "row", "from": ["new"], "state": "pending"},
    {"level": "sprint", "kind": "execution", "actors": ["workflow"], "scope": "table"},
    {"level": "sprint", "kind": "started", "actors": ["workflow"], "scope": "row", "from": ["pending"], "state": "running"},
    {"level": "sprint", "kind": "finished", "actors": ["workflow"], "scope": "row", "from": ["running"], "state": "finished"},
    {"level": "sprint", "kind": "failed", "actors": ["workflow"], "scope": "row", "from": ["running"], "state": "failed"},
    {"level": "sprint", "kind": "skipped", "actors": ["workflow"], "scope": "row", "from": ["pending"], "state": "disabled"},
    {"level": "sprint", "kind": "step_recorded", "actors": ["workflow"], "scope": "row", "from": ["running"]},
    {"level": "sprint", "kind": "outputs_recorded", "actors": ["workflow", "conductor"], "scope": "row", "from": ["running", "finished"]},
    {"level": "sprint", "kind": "disabled", "actors": ["conductor"], "scope": "row", "from": ["pending", "failed"], "state": "disabled"},
    {"level": "sprint", "kind": "enabled", "actors": ["conductor"], "scope": "row", "from": ["disabled"], "state": "pending"},
    {"level": "sprint", "kind": "retry", "actors": ["conductor"], "scope": "row", "from": ["failed"], "state": "pending"},
    {"level": "sprint", "kind": "manual_finished", "actors": ["conductor"], "scope": "row", "from": ["pending", "failed", "disabled"], "state": "finished"},
    {"level": "sprint", "kind": "scope_changed", "actors": ["conductor"], "scope": "table"},
    {"level": "sprint", "kind": "mode_raised", "actors": ["conductor"], "scope": "table"},
    {"level": "sprint", "kind": "carried", "actors": ["conductor"], "scope": "row", "from": ["new"], "state": ["finished", "disabled"]},
    {"level": "sprint", "kind": "answered", "actors": ["organizer", "conductor"], "scope": "row", "from": ["running", "failed"]},
    {"level": "sprint", "kind": "cancelled", "actors": ["conductor"], "scope": "any", "from": ["pending", "running", "failed"], "state": "cancelled"},
    {"level": "sprint", "kind": "completed", "actors": ["workflow"], "scope": "table", "state": "completed"},
    {"level": "lane", "kind": "created", "actors": ["conductor", "organizer"], "scope": "row", "from": ["new"], "state": "pending"},
    {"level": "lane", "kind": "row_added", "actors": ["conductor", "workflow", "organizer"], "scope": "row", "from": ["new"], "state": "pending"},
    {"level": "lane", "kind": "row_moved", "actors": ["conductor", "workflow", "organizer"], "scope": "row", "from": ["pending"]},
    {"level": "lane", "kind": "row_cancelled", "actors": ["conductor", "workflow", "organizer"], "scope": "row", "from": ["pending"], "state": "cancelled"},
    {"level": "lane", "kind": "row_started", "actors": ["conductor"], "scope": "row", "from": ["pending"], "state": "running"},
    {"level": "lane", "kind": "row_ended", "actors": ["workflow", "conductor"], "scope": "row", "from": ["running"], "state": ["completed", "cancelled"]},
    {"level": "plan", "kind": "created", "actors": ["organizer"], "scope": "row", "from": ["new"]},
    {"level": "plan", "kind": "lane_added", "actors": ["organizer"], "scope": "row", "from": ["new"]},
    {"level": "plan", "kind": "lane_changed", "actors": ["organizer"], "scope": "row"},
    {"level": "plan", "kind": "request_opened", "actors": ["organizer", "workflow"], "scope": "row", "from": ["new"]},
    {"level": "plan", "kind": "request_closed", "actors": ["organizer"], "scope": "row"},
    {"level": "plan", "kind": "plan_started", "actors": ["organizer"], "scope": "table", "state": "running"},
    {"level": "plan", "kind": "plan_completed", "actors": ["durable"], "scope": "table", "state": "completed"},
    {"level": "plan", "kind": "plan_cancelled", "actors": ["organizer"], "scope": "table", "state": "cancelled"}
  ],
  "reason_required": ["disabled", "enabled", "retry", "manual_finished", "scope_changed", "mode_raised", "cancelled", "request_closed"],
  "gates": {
    "design": "設計 Pull Request のマージ",
    "release": "本番系へ届く操作"
  },
  "branch_prefixes": {
    "sprint": "sprint/",
    "issue": "feat/",
    "design": "design/",
    "release": "release/"
  }
}
