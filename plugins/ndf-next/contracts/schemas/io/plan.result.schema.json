{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "io/plan.result.schema.json",
  "title": "ndf plan の結果 JSON",
  "description": "ndf plan が標準出力の最後の 1 行に出す結果 JSON。共通の欄は結果の契約（result.schema.json）が持ち、ここは metrics と items の形だけを足す。載せた項目のほかの項目は受け流す",
  "allOf": [
    {
      "$ref": "../result.schema.json"
    }
  ],
  "properties": {
    "tool": {
      "const": "plan"
    },
    "metrics": {
      "type": "object",
      "description": "ndf plan の計測値",
      "properties": {
        "waited_seconds": {
          "description": "コードが出す項目 waited_seconds（値の無い経路では null）",
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "items": {
      "type": "array",
      "description": "ndf plan の項目の並び",
      "items": {
        "type": "object",
        "properties": {}
      }
    }
  }
}
