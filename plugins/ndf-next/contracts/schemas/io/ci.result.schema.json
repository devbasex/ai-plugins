{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "io/ci.result.schema.json",
  "title": "ndf ci の結果 JSON",
  "description": "ndf ci が標準出力の最後の 1 行に出す結果 JSON。共通の欄は結果の契約（result.schema.json）が持ち、ここは metrics と items の形だけを足す。載せた項目のほかの項目は受け流す",
  "allOf": [
    {
      "$ref": "../result.schema.json"
    }
  ],
  "properties": {
    "tool": {
      "const": "ci"
    },
    "metrics": {
      "type": "object",
      "description": "ndf ci の計測値",
      "properties": {}
    },
    "items": {
      "type": "array",
      "description": "ndf ci の項目の並び",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "description": "コードが出す項目 kind（値の無い経路では null）",
            "type": [
              "string",
              "null"
            ]
          },
          "number": {
            "description": "コードが出す項目 number（値の無い経路では null）"
          }
        }
      }
    }
  }
}
