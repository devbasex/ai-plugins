{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ci.result.schema.json",
  "title": "ndf ci の結果 JSON",
  "description": "ndf ci が標準出力の最後の 1 行に出す結果 JSON。共通の欄は結果のコントラクト（result.schema.json）が持ち、ここは metrics と items の形だけを足す。metrics と items の要素は閉じていて、載せた項目のほかの項目を持つと通らない",
  "allOf": [
    {
      "$ref": "../result.schema.json"
    }
  ],
  "properties": {
    "tool": {
      "const": "ci"
    },
    "metrics": {
      "type": "object",
      "description": "ndf ci の計測値",
      "additionalProperties": false,
      "properties": {
        "rounds": {
          "type": "integer",
          "description": "読んだ回数（watch）"
        },
        "elapsed": {
          "type": "number",
          "description": "待った秒（watch）"
        },
        "queued_for": {
          "type": "number",
          "description": "ランナーの割り当てを待った秒（watch）"
        },
        "failed_tests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "落ちたテストの node id（watch が test_failed で止まったときだけ）"
        },
        "test_files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "落ちたテストのファイル（同上）"
        },
        "log_error": {
          "type": "string",
          "description": "落ちたテストのログを読めなかった理由（読めなかったときだけ）"
        }
      }
    },
    "items": {
      "type": "array",
      "description": "ndf ci の項目の並び",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "check",
              "pr"
            ],
            "description": "check は通らなかったチェック、pr はマージした（しようとした）PR"
          },
          "name": {
            "type": "string",
            "description": "チェックの名前（check）"
          },
          "result": {
            "type": "string",
            "description": "チェックの結論か missing・stale（check）"
          },
          "job": {
            "type": "integer",
            "description": "ジョブの id（check。分かるときだけ）"
          },
          "test": {
            "type": "boolean",
            "description": "テストのチェックか（check）"
          },
          "number": {
            "type": "integer",
            "description": "PR の番号（pr）"
          }
        },
        "required": [
          "kind"
        ]
      }
    }
  }
}
