{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "io/answer.result.schema.json",
  "title": "ndf answer の結果 JSON",
  "description": "ndf answer が標準出力の最後の 1 行に出す結果 JSON。共通の欄は結果の契約（result.schema.json）が持ち、ここは metrics と items の形だけを足す。載せた項目のほかの項目は受け流す",
  "allOf": [
    {
      "$ref": "../result.schema.json"
    }
  ],
  "properties": {
    "tool": {
      "const": "answer"
    },
    "metrics": {
      "type": "object",
      "description": "ndf answer の計測値",
      "properties": {
        "gate": {
          "description": "結果の gate"
        },
        "head": {
          "description": "結果の head"
        },
        "table_id": {
          "description": "結果の table_id"
        }
      }
    },
    "items": {
      "type": "array",
      "description": "ndf answer の項目の並び",
      "items": {
        "type": "object",
        "properties": {}
      }
    }
  }
}
