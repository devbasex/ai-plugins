{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "answer.result.schema.json",
  "title": "ndf answer の結果 JSON",
  "description": "ndf answer が標準出力の最後の 1 行に出す結果 JSON。共通の欄は結果のコントラクト（result.schema.json）が持ち、ここは metrics と items の形だけを足す。metrics と items の要素は閉じていて、載せた項目のほかの項目を持つと通らない",
  "allOf": [
    {
      "$ref": "../result.schema.json"
    }
  ],
  "properties": {
    "tool": {
      "const": "answer"
    },
    "metrics": {
      "type": "object",
      "description": "ndf answer の計測値",
      "additionalProperties": false,
      "properties": {
        "machine_id": {
          "type": "string",
          "description": "ステートマシンの ID"
        },
        "rev": {
          "type": "integer",
          "description": "スプリントの定義の改訂（next・wait・work・show）"
        },
        "state": {
          "type": [
            "string",
            "null"
          ],
          "description": "ステートマシンの状態（next・wait・work・show）"
        },
        "move": {
          "type": "string",
          "description": "次の 1 手の種類（next・wait・work）"
        },
        "stage": {
          "type": "string",
          "description": "手の工程（next・wait・work。工程の手のときだけ）"
        },
        "step": {
          "type": "string",
          "description": "手のステップ（next・wait・work。ステップの手のときだけ）"
        },
        "gate": {
          "type": [
            "object",
            "string"
          ],
          "description": "承認ゲートの質問（gate で返すとき。ask は区分と表示名）か、承認ゲートの区分（head）"
        },
        "head": {
          "type": "string",
          "description": "承認で見た head（head）"
        },
        "seqs": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "書いた事象の番号（回答）"
        },
        "gate_id": {
          "type": "string",
          "description": "回答した質問の id（回答）"
        },
        "carried_row": {
          "type": [
            "string",
            "null"
          ],
          "description": "外した課題を入れたレーンの行（回答）"
        },
        "replayed": {
          "type": "boolean",
          "description": "同じ冪等のキーの回答が書いてあったか（回答）"
        },
        "release_request": {
          "type": "object",
          "description": "出したリリースのリクエスト（リリース承認ゲートで返すとき）"
        }
      }
    },
    "items": {
      "type": "array",
      "description": "ndf answer の項目の並び",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "seq": {
            "type": "integer",
            "description": "回答の事象の番号（list）"
          },
          "at": {
            "type": "string",
            "description": "回答した時刻（list）"
          },
          "stage": {
            "type": [
              "string",
              "null"
            ],
            "description": "回答した工程（list）"
          },
          "step": {
            "type": [
              "string",
              "null"
            ],
            "description": "回答したステップ（list）"
          },
          "gate": {
            "type": [
              "string",
              "null"
            ],
            "description": "承認ゲートの区分（list）"
          },
          "gate_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "質問の id（list）"
          },
          "answer": {
            "type": "string",
            "description": "回答の語（list）"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ],
            "description": "変更要求の指摘（list）"
          },
          "head": {
            "type": [
              "string",
              "null"
            ],
            "description": "見た head（list）"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "回答の理由（list）"
          },
          "by": {
            "type": "string",
            "description": "回答した者（list）"
          }
        }
      }
    }
  }
}
