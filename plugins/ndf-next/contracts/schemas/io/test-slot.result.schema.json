{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "io/test-slot.result.schema.json",
  "title": "ndf test-slot の結果 JSON",
  "description": "ndf test-slot が標準出力の最後の 1 行に出す結果 JSON。共通の欄は結果の契約（result.schema.json）が持ち、ここは metrics と items の形だけを足す。載せた項目のほかの項目は受け流す",
  "allOf": [
    {
      "$ref": "../result.schema.json"
    }
  ],
  "properties": {
    "tool": {
      "const": "test-slot"
    },
    "metrics": {
      "type": "object",
      "description": "ndf test-slot の計測値",
      "properties": {
        "available_mib": {
          "description": "結果の available_mib"
        },
        "waited_seconds": {
          "description": "結果の waited_seconds",
          "type": "number"
        }
      }
    },
    "items": {
      "type": "array",
      "description": "ndf test-slot の項目の並び",
      "items": {
        "type": "object",
        "properties": {}
      }
    }
  }
}
