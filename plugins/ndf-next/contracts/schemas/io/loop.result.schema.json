{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "io/loop.result.schema.json",
  "title": "ndf loop の結果 JSON",
  "description": "ndf loop が標準出力の最後の 1 行に出す結果 JSON。共通の欄は結果の契約（result.schema.json）が持ち、ここは metrics と items の形だけを足す。載せた項目のほかの項目は受け流す",
  "allOf": [
    {
      "$ref": "../result.schema.json"
    }
  ],
  "properties": {
    "tool": {
      "const": "loop"
    },
    "metrics": {
      "type": "object",
      "description": "ndf loop の計測値",
      "properties": {
        "answer": {
          "description": "結果の answer"
        },
        "head": {
          "description": "結果の head"
        },
        "lap": {
          "description": "結果の lap"
        },
        "outcome": {
          "description": "結果の outcome"
        },
        "remaining": {
          "description": "結果の remaining",
          "type": "array"
        },
        "streak": {
          "description": "結果の streak"
        }
      }
    },
    "items": {
      "type": "array",
      "description": "ndf loop の項目の並び",
      "items": {
        "type": "object",
        "properties": {}
      }
    }
  }
}
