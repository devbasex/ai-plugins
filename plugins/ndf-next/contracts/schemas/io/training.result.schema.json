{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "io/training.result.schema.json",
  "title": "ndf training の結果 JSON",
  "description": "ndf training が標準出力の最後の 1 行に出す結果 JSON。共通の欄は結果の契約（result.schema.json）が持ち、ここは metrics と items の形だけを足す。載せた項目のほかの項目は受け流す",
  "allOf": [
    {
      "$ref": "../result.schema.json"
    }
  ],
  "properties": {
    "tool": {
      "const": "training"
    },
    "metrics": {
      "type": "object",
      "description": "ndf training の計測値",
      "properties": {}
    },
    "items": {
      "type": "array",
      "description": "ndf training の項目の並び",
      "items": {
        "type": "object",
        "properties": {
          "args": {
            "description": "結果の args"
          }
        }
      }
    }
  }
}
