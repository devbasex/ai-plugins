    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subcommand": {
          "const": "start",
          "description": "下位の命令（入れ子は空白でつなぐ）"
        },
        "--cwd": {
          "type": "string",
          "description": "対象のリポジトリの中の位置（既定はカレントディレクトリ）"
        },
        "name": {
          "type": "string",
          "x-ndf-positional": true
        },
        "--session": {
          "type": "string",
          "description": "打ったセッションの識別子"
        },
        "--row": {
          "type": "string",
          "description": "結び付けるレーンの行のステートマシンの ID（`ndf progress new --loop` の結果）"
        }
      },
      "required": [
        "subcommand",
        "name",
        "--session"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subcommand": {
          "const": "stop",
          "description": "下位の命令（入れ子は空白でつなぐ）"
        },
        "--cwd": {
          "type": "string",
          "description": "対象のリポジトリの中の位置（既定はカレントディレクトリ）"
        },
        "name": {
          "type": "string",
          "x-ndf-positional": true
