{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "io/cross-review.result.schema.json",
  "title": "ndf cross-review の結果 JSON",
  "description": "ndf cross-review が標準出力の最後の 1 行に出す結果 JSON。共通の欄は結果の契約（result.schema.json）が持ち、ここは metrics と items の形だけを足す。載せた項目のほかの項目は受け流す",
  "allOf": [
    {
      "$ref": "../result.schema.json"
    }
  ],
  "properties": {
    "tool": {
      "const": "cross-review"
    },
    "metrics": {
      "type": "object",
      "description": "ndf cross-review の計測値",
      "properties": {}
    },
    "items": {
      "type": "array",
      "description": "ndf cross-review の項目の並び",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "description": "結果の kind",
            "type": "string"
          },
          "path": {
            "description": "結果の path"
          },
          "points_to": {
            "description": "結果の points_to",
            "type": "string"
          }
        }
      }
    }
  }
}
