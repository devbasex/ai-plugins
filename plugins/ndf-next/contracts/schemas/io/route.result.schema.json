{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "route.result.schema.json",
  "title": "ndf route の結果 JSON",
  "description": "ndf route が標準出力の最後の 1 行に出す結果 JSON。共通の欄は結果の契約（result.schema.json）が持ち、ここは metrics と items の形だけを足す。metrics と items の要素は閉じていて、載せた項目のほかの項目を持つと通らない",
  "allOf": [
    {
      "$ref": "../result.schema.json"
    }
  ],
  "properties": {
    "tool": {
      "const": "route"
    },
    "metrics": {
      "type": "object",
      "description": "ndf route の計測値",
      "additionalProperties": false,
      "properties": {
        "failed_tests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "CI で落ちたテストの node id（test）"
        },
        "runs": {
          "type": "integer",
          "description": "手元で打った範囲のテストのコマンドの数（test --failed-from）"
        },
        "failed_runs": {
          "type": "integer",
          "description": "落ちたコマンドの数（test --failed-from）"
        },
        "exit_code": {
          "type": "integer",
          "description": "テストのコマンドの終了コード（test が落ちたとき）"
        },
        "templates": {
          "type": "integer",
          "description": "雛形の数（templates）"
        },
        "streak": {
          "type": "integer",
          "description": "同じ原因の続いた回数（streak）"
        },
        "same_cause": {
          "type": "integer",
          "description": "同じ原因の上限（streak）"
        }
      }
    },
    "items": {
      "type": "array",
      "description": "ndf route の項目の並び",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "path",
              "template",
              "test_run"
            ],
            "description": "項目の種類"
          },
          "path": {
            "type": "string",
            "description": "書いたプラン（path）"
          },
          "name": {
            "type": "string",
            "description": "雛形の名前（template）"
          },
          "purpose": {
            "type": "string",
            "description": "雛形の目的（template）"
          },
          "params": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "雛形の引数（template）"
          },
          "suite": {
            "type": "string",
            "description": "テストの suite（test_run）"
          },
          "command": {
            "type": "string",
            "description": "打ったコマンド（test_run）"
          },
          "exit_code": {
            "type": "integer",
            "description": "終了コード（test_run）"
          },
          "passed": {
            "type": "boolean",
            "description": "通ったか（test_run）"
          }
        },
        "required": [
          "kind"
        ]
      }
    }
  }
}
