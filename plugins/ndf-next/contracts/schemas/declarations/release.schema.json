{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "declarations/release.schema.json",
  "title": "リリースの手順の宣言（.ndf/release.json）",
  "description": "リリースの段階ごとに打つコマンドの並び。無ければ何もしない",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "steps"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "編集のときの補完に使うスキーマの位置。読み手は参照しない"
    },
    "version": {
      "type": "integer",
      "enum": [
        1
      ],
      "description": "宣言の形の版。読み手は知らない版を読まない"
    },
    "steps": {
      "type": "array",
      "description": "コマンドの並び。書いた順に実行し、最初に落ちたコマンドで止める",
      "items": {
        "type": "object",
        "required": [
          "name",
          "stage",
          "command",
          "writes"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "出力と完了報告に出す名前"
          },
          "stage": {
            "type": "string",
            "enum": [
              "production",
              "verification",
              "any"
            ],
            "description": "走らせる段階。production はリリース、verification は開発版のデプロイ、any は両方"
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "引数の配列。シェルを通さず、リポジトリの根を作業ディレクトリにして実行する。{version} を配る版で置き換える（置き換えるのはこの 1 つだけ）"
          },
          "writes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "書いてよいパスの前置き（根からの相対。絶対パスと .. は使えない）。外を変えたらコマンドは失敗になる。[] は何も書かないコマンド"
          },
          "guide": {
            "type": "string",
            "minLength": 1,
            "description": "エージェントが判断する部分の手引き（根からの相対パス）。コマンドが 0 で終わったら読んで従う"
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "default": 600,
            "description": "コマンド 1 つの時間の上限"
          }
        }
      }
    }
  },
  "x-ndf-place": "worktree",
  "x-ndf-read-by": [
    {
      "by": "ndf release-steps",
      "when": "リリースの手順で、段階に合うコマンドを順に打つとき"
    }
  ],
  "examples": [
    {
      "version": 1,
      "steps": [
        {
          "name": "記録",
          "stage": "production",
          "command": [
            "python3",
            "scripts/record.py"
          ],
          "writes": [
            "docs/metrics/"
          ]
        }
      ]
    }
  ]
}
