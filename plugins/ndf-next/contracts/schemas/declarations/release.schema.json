{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "declarations/release.schema.json",
  "title": "リリースの手順の宣言（.ndf/release.json）",
  "description": "リリースの段階ごとに打つコマンドの並び。無ければ何もしない",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "編集のときの補完に使うスキーマの位置。読み手は参照しない"
    },
    "version": {
      "type": "integer",
      "enum": [
        1
      ],
      "description": "宣言の形の版。読み手は知らない版を読まない"
    },
    "steps": {
      "type": "array",
      "description": "コマンドの並び。書いた順に実行し、最初に落ちたコマンドで止める。無ければ手順なし",
      "items": {
        "type": "object",
        "required": [
          "name",
          "stage",
          "command"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "出力と完了報告に出す名前"
          },
          "stage": {
            "type": "string",
            "enum": [
              "production",
              "dev",
              "verify"
            ],
            "description": "走らせる段階。production は本番の組み立て、dev は開発版の組み立て、verify はリリース後のテスト"
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "引数の配列。シェルを通さず、リポジトリの根を作業ディレクトリにして実行する。{version} を配る版で置き換える（置き換えるのはこの 1 つだけ）"
          },
          "writes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "コマンドが書くパスの前置きの申告（根からの相対。絶対パスと .. は使えない）。[] は何も書かないコマンドの申告。読み手（手順の実行）はこの値で書き込みを検査せず、成否はコマンドの終了コードだけで決まる。範囲の外への書き込みを防ぐ保証には使えない",
            "default": []
          },
          "guide": {
            "type": "string",
            "minLength": 1,
            "description": "エージェントが判断する部分の手引き（根からの相対パス）。コマンドが 0 で終わったら読んで従う"
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "default": 600,
            "description": "コマンド 1 つの時間の上限"
          }
        }
      }
    },
    "undistributed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "リリース対象に関わらないファイルの形（プラグインの根からの gitignore の形）。無ければテスト"
    },
    "bump_undistributed": {
      "type": "boolean",
      "default": false,
      "description": "リリース対象に関わらない変化だけのプラグインも版を上げるか"
    },
    "version_files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "版上げで、プラグインの名前を含む行の版を書き換えるファイル"
    },
    "changelog": {
      "type": "string",
      "default": "CHANGELOG.md",
      "description": "CHANGELOG のファイル（リポジトリの根から）"
    },
    "version_store": {
      "description": "バージョンの置き場（#3572 の決定 22）。kind が plugin ならマーケットプレイスの登録とプラグインの定義（と version_files）、json なら path の JSON のファイルの key の値を name の単位のバージョンにする。ブランチ戦略が github-flow なら要る。書かなければ、ほかの行では plugin を使う。読み手は ndf.domains.release.version_store.of",
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "plugin",
            "json"
          ],
          "type": "string"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "バージョンを持つ JSON のファイル（リポジトリの根から。json）"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "description": "バージョンの鍵（json）"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "タグと CHANGELOG の見出しに使う単位の名前（json）"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "json"
              }
            }
          },
          "then": {
            "required": [
              "path",
              "key",
              "name"
            ]
          }
        }
      ]
    }
  },
  "x-ndf-place": "worktree",
  "x-ndf-read-by": [
    {
      "by": "ndf release-steps",
      "when": "リリースの手順で、段階に合うコマンドを順に打つとき"
    }
  ],
  "examples": [
    {
      "version": 1,
      "steps": [
        {
          "name": "記録",
          "stage": "production",
          "command": [
            "python3",
            "scripts/record.py"
          ],
          "writes": [
            "docs/metrics/"
          ]
        }
      ]
    }
  ]
}
