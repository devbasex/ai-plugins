{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "declarations/code-metrics.schema.json",
  "title": "コードの測り方の宣言（.ndf/code-metrics.json）",
  "description": "リファクタリングが言語ごとに使う測りの Tool。null はその言語を測らない",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "tools"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "編集のときの補完に使うスキーマの位置。読み手は参照しない"
    },
    "version": {
      "type": "integer",
      "enum": [
        1
      ],
      "description": "宣言の形の版。読み手は知らない版を読まない"
    },
    "tools": {
      "type": "object",
      "description": "言語 → 測りの Tool の名前。言語は python・javascript・typescript・php・go・ruby・java・kotlin・swift・rust・c・cpp・csharp・lua・shell、Tool は lizard・ruff-complexipy（python だけ）・null（測らない）。形が違えば読み手は宣言の全体を使わず既定で測る",
      "propertyNames": {
        "enum": [
          "python",
          "javascript",
          "typescript",
          "php",
          "go",
          "ruby",
          "java",
          "kotlin",
          "swift",
          "rust",
          "c",
          "cpp",
          "csharp",
          "lua",
          "shell"
        ]
      },
      "additionalProperties": {
        "enum": [
          "lizard",
          null
        ]
      },
      "properties": {
        "python": {
          "enum": [
            "ruff-complexipy",
            "lizard",
            null
          ]
        }
      }
    }
  },
  "x-ndf-place": "worktree",
  "x-ndf-read-by": [
    {
      "by": "ndf refactor",
      "when": "リファクタリングでコードを測るとき"
    }
  ],
  "examples": [
    {
      "version": 1,
      "tools": {
        "python": "ruff-complexipy",
        "go": null
      }
    }
  ]
}
