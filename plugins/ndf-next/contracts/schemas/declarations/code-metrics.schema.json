{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "declarations/code-metrics.schema.json",
  "title": "コードの測り方の宣言（.ndf/code-metrics.json）",
  "description": "構造改善が言語ごとに使う測りの Tool。null はその言語を測らない",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "tools"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "編集のときの補完に使うスキーマの位置。読み手は参照しない"
    },
    "version": {
      "type": "integer",
      "enum": [
        1
      ],
      "description": "宣言の形の版。読み手は知らない版を読まない"
    },
    "tools": {
      "type": "object",
      "description": "言語 → 測りの Tool の名前（null は測らない）",
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  },
  "x-ndf-read-by": [
    {
      "by": "ndf refactor",
      "when": "構造改善でコードを測るとき"
    }
  ],
  "examples": [
    {
      "version": 1,
      "tools": {
        "python": "radon",
        "go": null
      }
    }
  ]
}
