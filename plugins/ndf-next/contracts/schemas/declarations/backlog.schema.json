{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "declarations/backlog.schema.json",
  "title": "棚卸しの宣言（.ndf/backlog.json）",
  "description": "棚卸しの品質の枠と、深さごとの頻度・閾値・上限",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "編集のときの補完に使うスキーマの位置。読み手は参照しない"
    },
    "version": {
      "type": "integer",
      "enum": [
        1
      ],
      "description": "宣言の形の版。読み手は知らない版を読まない"
    },
    "quality": {
      "type": "object",
      "description": "品質の枠。無ければ枠を取らない",
      "properties": {
        "label": {
          "type": "string",
          "description": "品質の課題のラベル",
          "default": "quality"
        },
        "ratio": {
          "type": "number",
          "description": "枠の割合",
          "minimum": 0,
          "maximum": 1,
          "default": 0.2
        },
        "min": {
          "type": "integer",
          "description": "枠の最小の件数",
          "minimum": 0,
          "default": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "label",
        "ratio",
        "min"
      ]
    },
    "depths": {
      "type": "object",
      "description": "深さ（review・overhaul・research など）→ その深さの設定",
      "additionalProperties": {
        "type": "object",
        "description": "深さ 1 つの設定",
        "properties": {
          "seconds": {
            "type": "integer",
            "description": "1 回の秒の上限",
            "minimum": 1
          },
          "every": {
            "type": "integer",
            "description": "頻度（周回の数）",
            "minimum": 1
          },
          "threshold": {
            "type": "number",
            "description": "閾値"
          },
          "limit": {
            "type": "integer",
            "description": "件数の上限",
            "minimum": 0
          }
        }
      }
    }
  },
  "x-ndf-read-by": [
    {
      "by": "ndf issues",
      "when": "棚卸しの順位を付けるときと、深さの秒の上限を決めるとき"
    }
  ],
  "examples": [
    {
      "quality": {
        "label": "quality",
        "ratio": 0.2,
        "min": 1
      }
    }
  ]
}
