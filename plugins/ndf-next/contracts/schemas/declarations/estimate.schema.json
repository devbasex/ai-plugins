{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "declarations/estimate.schema.json",
  "title": "見積もりの宣言（.ndf/estimate.json）",
  "description": "見積もりに使う実績の置き場と、読む範囲",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "編集のときの補完に使うスキーマの位置。読み手は参照しない"
    },
    "version": {
      "type": "integer",
      "enum": [
        1
      ],
      "description": "宣言の形の版。読み手は知らない版を読まない"
    },
    "records_dir": {
      "type": "string",
      "description": "実績の記録の置き場（リポジトリの根から）"
    },
    "window": {
      "type": "integer",
      "description": "読む実績の件数",
      "minimum": 1
    },
    "min_samples": {
      "type": "integer",
      "description": "見積もりに要る最小の件数",
      "minimum": 1
    }
  },
  "x-ndf-place": "worktree",
  "x-ndf-read-by": [
    {
      "by": "ndf issues",
      "when": "棚卸しの見積もりのとき"
    },
    {
      "by": "ndf refactor",
      "when": "リファクタリングの予算を決めるとき"
    }
  ],
  "examples": [
    {
      "version": 1,
      "window": 20,
      "min_samples": 3
    }
  ]
}
