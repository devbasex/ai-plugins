{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "release-verification.schema.json",
  "title": "リリース後テストの記録",
  "description": "リリース後テストの結果を機械が読む形。課題を閉じる判定はこの記録の version と issues だけを読み、PR のコメントの見出しや本文の文から読まない。version はプラグイン名や v の前置きを持たない版数で、本番の版と文字列のまま照合できる",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "issues"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    },
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "result", "evidence"],
        "properties": {
          "number": {"type": "integer", "minimum": 1},
          "result": {"enum": ["passed", "failed", "not_run"]},
          "evidence": {"type": "string", "pattern": "\\S"}
        }
      }
    }
  }
}
