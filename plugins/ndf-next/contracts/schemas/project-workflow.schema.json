{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-workflow.schema.json",
  "title": "プロジェクトの宣言の workflow",
  "description": ".ndf/project.json の workflow の形。読む側は ndf.progress.invoke（launch を雛形の差し込み review・rebuild・refactor へ写す）と ndf.progress.command（stages を工程の有効と無効へ写す）",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "stages": {
      "type": "object",
      "description": "工程の名前 → 有効と理由。無効にするときは reason が要る",
      "additionalProperties": {
        "type": "object",
        "required": ["enabled"],
        "properties": {
          "enabled": {"type": "boolean"},
          "reason": {"type": "string", "minLength": 1}
        },
        "if": {"properties": {"enabled": {"const": false}}},
        "then": {"required": ["reason"]}
      }
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "description": "工程から呼ぶプランの雛形の起動。値は語の並びで、雛形の差し込みの同じ名前の値になる（#3092・#3473）",
      "properties": {
        "review": {"$ref": "#/$defs/command"},
        "rebuild": {"$ref": "#/$defs/command"},
        "refactor": {"$ref": "#/$defs/command"}
      }
    }
  },
  "$defs": {
    "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
