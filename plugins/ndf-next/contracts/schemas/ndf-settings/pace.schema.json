{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ndf-settings/pace.schema.json",
  "title": "進め方の設定（.ndf/pace.json）",
  "description": "進め方（fast・auto）の許可と、共通の層の範囲・レッドラインのパス・閾値・開発ループの設定",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "編集のときの補完に使うスキーマの位置。読み手は参照しない"
    },
    "version": {
      "type": "integer",
      "enum": [
        1
      ],
      "description": "設定の形のバージョン。読み手は知らないバージョンを読まない"
    },
    "fast": {
      "type": "object",
      "description": "進め方の許可",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "この進め方を使ってよいか",
          "default": false
        },
        "modes": {
          "type": "array",
          "description": "この進め方を使ってよいモード",
          "items": {
            "type": "string"
          }
        },
        "verify": {
          "type": "string",
          "description": "この進め方で出した後に打つ導入の確かめのコマンド"
        }
      },
      "additionalProperties": false
    },
    "auto": {
      "type": "object",
      "description": "進め方の許可",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "この進め方を使ってよいか",
          "default": false
        },
        "modes": {
          "type": "array",
          "description": "この進め方を使ってよいモード",
          "items": {
            "type": "string"
          }
        },
        "verify": {
          "type": "string",
          "description": "この進め方で出した後に打つ導入の確かめのコマンド"
        }
      },
      "additionalProperties": false
    },
    "areas": {
      "type": "array",
      "description": "共通の層の範囲の並び",
      "items": {
        "type": "object",
        "description": "範囲 1 つ",
        "properties": {
          "name": {
            "type": "string",
            "description": "範囲の名前"
          },
          "common": {
            "type": "boolean",
            "description": "共通の層か"
          },
          "paths": {
            "type": "array",
            "description": "範囲の glob",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "paths"
        ]
      }
    },
    "boundary_paths": {
      "type": "array",
      "description": "レッドラインのパス（触れる変更は人の承認が要る）の glob",
      "items": {
        "type": "string"
      }
    },
    "triggers": {
      "type": "object",
      "description": "進め方を切り替える閾値",
      "properties": {
        "score": {
          "type": "integer",
          "description": "点数の閾値"
        },
        "common_weight": {
          "type": "integer",
          "description": "共通の層の重み"
        },
        "lines": {
          "type": "integer",
          "description": "変更の行数の閾値"
        },
        "escapes": {
          "type": "integer",
          "description": "すり抜けの件数の閾値"
        },
        "hours": {
          "type": "integer",
          "description": "時間の閾値"
        }
      },
      "additionalProperties": false
    },
    "loop": {
      "type": "object",
      "description": "開発ループの設定",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "開発ループを使ってよいか",
          "default": false
        },
        "budget": {
          "type": "object",
          "description": "開発ループの予算。各単位は正の数か null",
          "properties": {
            "laps": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "description": "ループの回数の上限。書かない・null なら無制限",
              "default": null
            },
            "hours": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "description": "時間の上限（時間。小数を書ける）。書かない・null なら無制限",
              "default": null
            },
            "usd": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "description": "費用の上限（USD）。書かない・null なら無制限",
              "default": null
            }
          },
          "additionalProperties": false
        },
        "same_failure": {
          "type": "integer",
          "description": "同じ失敗が続いたら止める回数",
          "minimum": 1,
          "default": 2
        },
        "max_issues": {
          "type": "integer",
          "description": "ループの 1 回で選ぶ課題の件数の上限",
          "minimum": 1,
          "default": 3
        },
        "reorder_width": {
          "type": "integer",
          "description": "選定で並べ替えの対象にする候補の件数",
          "minimum": 0,
          "default": 0
        }
      },
      "additionalProperties": false
    },
    "parallel": {
      "type": "object",
      "description": "並列の計画の設定",
      "properties": {
        "answer_limit": {
          "type": "object",
          "description": "並列の計画の回答待ちのリクエストの閾値",
          "properties": {
            "plan": {
              "type": "integer",
              "description": "計画の閾値",
              "minimum": 1,
              "default": 8
            },
            "lane": {
              "type": "integer",
              "description": "レーンの閾値",
              "minimum": 1,
              "default": 3
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "business_hours": {
      "type": "object",
      "description": "業務時間（日をまたがない）。不正なら警告して設定なしとして扱う",
      "properties": {
        "timezone": {
          "type": "string",
          "description": "IANA の時間帯の名前"
        },
        "days": {
          "type": "array",
          "description": "曜日",
          "items": {
            "type": "string",
            "enum": [
              "mon",
              "tue",
              "wed",
              "thu",
              "fri",
              "sat",
              "sun"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "start": {
          "type": "string",
          "description": "始まり（HH:MM。00:00〜23:59。end より前）",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "end": {
          "type": "string",
          "description": "終わり（HH:MM。00:00〜23:59）",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        }
      },
      "additionalProperties": false,
      "required": [
        "timezone",
        "days",
        "start",
        "end"
      ]
    }
  },
  "x-ndf-location": "worktree",
  "x-ndf-read-by": [
    {
      "by": "ndf answer",
      "when": "承認ゲートでレッドラインのパスを照らすとき"
    },
    {
      "by": "ndf loop",
      "when": "開発ループの選定と予算を決めるとき"
    }
  ],
  "examples": [
    {
      "version": 1,
      "fast": {
        "enabled": true,
        "modes": [
          "light"
        ]
      },
      "boundary_paths": [
        ".github/workflows/**"
      ],
      "loop": {
        "enabled": true,
        "budget": {
          "laps": 10
        }
      }
    }
  ]
}
