{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "result.schema.json",
  "title": "結果 JSON",
  "description": "副命令と作業が標準出力へ 1 行で出す結果。cause.kind が止まった理由の表にあること・終了コードが種類のものと同じことは、読み手（ndf.contracts.result）が表と照らす",
  "type": "object",
  "additionalProperties": false,
  "required": ["tool", "status", "summary", "items", "metrics"],
  "properties": {
    "tool": {"type": "string", "minLength": 1},
    "status": {"enum": ["ok", "gate", "stopped"]},
    "summary": {"type": "string"},
    "items": {"type": "array", "items": {"type": "object"}},
    "metrics": {"type": "object"},
    "gaps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/gap"}},
    "process": {"type": "array", "items": {"$ref": "#/$defs/process"}},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
    "warnings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "presentation_path": {"type": "string", "minLength": 1},
    "next": {"$ref": "#/$defs/command", "description": "次に打つコマンド。打つ側は argv をそのまま打つ"},
    "outputs": {"$ref": "#/$defs/outputs"},
    "run_id": {"type": "string", "minLength": 1},
    "original_result": {
      "description": "実行の記録に書けずに stopped へ置き換えた結果の、本体の元の結果 JSON（#2338 の決定 3）。本体が例外で終わったときは null",
      "type": ["object", "null"]
    },
    "cause": {"$ref": "#/$defs/cause"},
    "routes": {
      "description": "答えごとに次に打つコマンド。キーは答えの語彙（facts/answers.json の id。読み手が表と照らす）。値が null なら何も打たない",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"oneOf": [{"$ref": "#/$defs/command"}, {"type": "null"}]}
    }
  },
  "allOf": [
    {
      "description": "stopped は必ず cause を持ち、ok と gate は持たない",
      "if": {"properties": {"status": {"const": "stopped"}}},
      "then": {"required": ["cause"]},
      "else": {"not": {"required": ["cause"]}}
    },
    {
      "description": "承認ゲートの結果は答えごとの行き先 routes を持つ。ok は routes を持たない",
      "if": {"properties": {"status": {"const": "gate"}}},
      "then": {"required": ["routes"]},
      "else": {"if": {"properties": {"status": {"const": "ok"}}}, "then": {"not": {"required": ["routes"]}}}
    },
    {
      "description": "gaps を持つことと、cause.kind が incomplete であることは同じ",
      "if": {"required": ["cause"], "properties": {"cause": {"required": ["kind"], "properties": {"kind": {"const": "incomplete"}}}}},
      "then": {"required": ["gaps"]},
      "else": {"not": {"required": ["gaps"]}}
    }
  ],
  "$defs": {
    "text": {"type": "string", "pattern": "\\S"},
    "command": {
      "description": "そのまま打てるコマンド。argv は置き換えの要らない引数の配列で、先頭はエントリポイントの短い名前 ndf（パスと版を含まない）。ask は打つ側が埋める鍵で、鍵ごとに --<鍵> <値> を末尾へ足して打つ",
      "type": "object",
      "additionalProperties": false,
      "required": ["argv"],
      "properties": {
        "argv": {"type": "array", "minItems": 2, "prefixItems": [{"const": "ndf"}], "items": {"type": "string", "minLength": 1}},
        "ask": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}}
      }
    },
    "outputs": {
      "description": "工程どうしで渡す値。鍵はスプリントの文脈の閉じた語彙で、鍵ごとに型を持つ。読み手は items と metrics から渡す値を判定しない",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "issues": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
        "mode": {"type": "string", "minLength": 1},
        "pace": {"type": "string", "minLength": 1},
        "worktree": {"type": "string", "minLength": 1},
        "branch": {"type": "string", "minLength": 1},
        "design_pr": {"type": "integer", "minimum": 1},
        "pr": {"type": "integer", "minimum": 1},
        "delivery": {"type": "object"},
        "gaps": {
          "description": "ステップが残した欠け（レビューの incomplete）。後のステップが ok でも、プランの結果は incomplete のまま、この欠けを持つ。後のステップの空の配列が前の欠けを消す",
          "type": "array",
          "items": {"$ref": "#/$defs/gap"}
        },
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"}
      }
    },
    "gap": {
      "description": "欠け 1 件",
      "type": "object",
      "required": ["kind", "name", "reason"],
      "properties": {"kind": {"$ref": "#/$defs/text"}, "name": {"$ref": "#/$defs/text"}, "reason": {"$ref": "#/$defs/text"}}
    },
    "process": {
      "description": "過程 1 件",
      "type": "object",
      "required": ["run", "result"],
      "properties": {"run": {"$ref": "#/$defs/text"}, "result": {"$ref": "#/$defs/text"}}
    },
    "decision": {
      "description": "判断 1 件",
      "type": "object",
      "required": ["decision", "basis"],
      "properties": {"decision": {"$ref": "#/$defs/text"}, "basis": {"$ref": "#/$defs/text"}}
    },
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "detail"],
      "properties": {
        "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "detail": {"type": "string", "pattern": "\\S"},
        "instance": {"type": "string", "minLength": 1},
        "retry_after": {"type": "number", "minimum": 0}
      }
    }
  }
}
