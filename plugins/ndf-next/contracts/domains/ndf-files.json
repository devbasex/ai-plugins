{
  "summary": "NDF の工程が書くファイル（宣言・計測値・実行の記録・文書・受け渡し）の置き場・持ち主・消す時点。工程はこの表に無いパスへ書かない。同じ事実は 1 つの宣言だけが持つ（テストのコマンドは project.json の test だけが持ち、supervise.json は持たない）。実行で変わる計測値は追跡する宣言へ書き戻さず、状態の置き場へ書く。外の呼び手（サービスのランナー）が読むファイルは列 reader と fields に持ち、入れ替えの後も同じ置き場・同じ形で書く。読み手は知らない項目を受け流す",
  "owner": "D2（contracts/domains）",
  "columns": {
    "place": {"type": "string", "summary": "置き場", "ref": "domains/places"},
    "path": {"type": "string", "summary": "置き場からの相対パス。<名前> は実行ごとに決まる部分（<n> は Issue の番号、<repo> はリポジトリの鍵、<id> は実行の識別子）"},
    "kind": {"type": "string", "summary": "中身の種類。declaration は人が決める宣言、measured は実行で変わる計測値、record は実行の記録、document は工程が書く文書、exchange はプロセスの間の受け渡し"},
    "tracked": {"type": "boolean", "summary": "git が追跡するファイル。追跡しない置き場の下では偽"},
    "writer": {"type": "string", "summary": "書き手（人か、書く子 Issue の記号）"},
    "ends": {"type": "string", "summary": "消す時点。kept は残す（人か、置き場を渡した外の呼び手が消す）、replaced は書くたびに置き換える、cleanup は後片付けの工程が消す、run は書いた実行が終わるときに消す、archived は後片付けの工程が issues/old へ移す"},
    "keys": {"type": "array", "summary": "宣言の最上位のキー（version と $schema を除く）。宣言の読み手はこの表に無いキーを読まない", "optional": true},
    "main_keys": {"type": "array", "summary": "Pull Request の変更で動かせないよう、メインディレクトリ（既定ブランチのworktree）の宣言から読むキー（認可・本番チャネル・ブランチの運用）。worktreeの宣言の同じキーは読まない", "optional": true},
    "reader": {"type": "string", "summary": "このファイルを読む外の呼び手。service はサービス（Factory）のランナー", "optional": true},
    "fields": {"type": "array", "summary": "外の呼び手が頼る項目。書き手はこの項目の名前と意味を変えない。ほかの項目は足してよい", "optional": true}
  },
  "rows": [
    {"id": "project", "place": "ndf", "path": "project.json", "kind": "declaration", "tracked": true, "writer": "人と解析（M7）", "ends": "kept", "keys": ["languages", "test", "ci", "services", "delivery", "issues", "checks", "ndf_policies", "instructions", "materials", "docs", "analysis"]},
    {"id": "project-measured", "place": "measured", "path": "<repo>/project.json", "kind": "measured", "tracked": false, "writer": "解析とテストの実行（M7）", "ends": "replaced", "keys": ["file_counts", "test_durations"]},
    {"id": "supervise", "place": "ndf", "path": "supervise.json", "kind": "declaration", "tracked": true, "writer": "人", "ends": "kept", "keys": ["sync_checks", "format", "release"]},
    {"id": "release", "place": "ndf", "path": "release.json", "kind": "declaration", "tracked": true, "writer": "人", "ends": "kept", "keys": ["steps"]},
    {"id": "worktree", "place": "ndf", "path": "worktree.json", "kind": "declaration", "tracked": true, "writer": "人", "ends": "kept", "keys": ["base_branch", "production_branch", "branch_flow", "guard", "tool_paths"], "main_keys": ["production_branch", "branch_flow"]},
    {"id": "worktree-local", "place": "ndf", "path": "worktree.local.json", "kind": "declaration", "tracked": false, "writer": "人（各自の機械の値。worktree.json のキーを上書きする）", "ends": "kept"},
    {"id": "glossary", "place": "ndf", "path": "glossary.json", "kind": "declaration", "tracked": true, "writer": "人", "ends": "kept", "keys": ["format", "source", "document", "check"]},
    {"id": "instructions", "place": "ndf", "path": "instructions.json", "kind": "declaration", "tracked": true, "writer": "人と解析（M7）", "ends": "kept", "keys": ["files", "imports", "released", "decisions", "pending_marker", "budget"]},
    {"id": "mvv", "place": "ndf", "path": "mvv.json", "kind": "declaration", "tracked": true, "writer": "人の承認（M7）", "ends": "kept", "keys": ["body", "settings", "versions"]},
    {"id": "mvv-body", "place": "ndf", "path": "mvv.md", "kind": "declaration", "tracked": true, "writer": "人の承認（M7）", "ends": "kept"},
    {"id": "pace", "place": "ndf", "path": "pace.json", "kind": "declaration", "tracked": true, "writer": "人", "ends": "kept", "keys": ["fast", "auto", "areas", "boundary_paths", "triggers", "loop"]},
    {"id": "review", "place": "ndf", "path": "review.json", "kind": "declaration", "tracked": true, "writer": "人", "ends": "kept", "keys": ["focus"]},
    {"id": "backlog", "place": "ndf", "path": "backlog.json", "kind": "declaration", "tracked": true, "writer": "人", "ends": "kept", "keys": ["quality", "depths"]},
    {"id": "backlog-candidates", "place": "backlog-state", "path": "<repo>/candidates.json", "kind": "record", "tracked": false, "writer": "棚卸し（M6）", "ends": "replaced"},
    {"id": "backlog-rank", "place": "backlog-state", "path": "<repo>/rank.json", "kind": "record", "tracked": false, "writer": "棚卸し（M6）", "ends": "replaced"},
    {"id": "backlog-rejected", "place": "backlog-state", "path": "<repo>/rejected.json", "kind": "record", "tracked": false, "writer": "棚卸し（M6）", "ends": "kept"},
    {"id": "backlog-estimates", "place": "backlog-state", "path": "<repo>/estimates.json", "kind": "record", "tracked": false, "writer": "棚卸し（M6）", "ends": "kept"},
    {"id": "backlog-before", "place": "backlog-state", "path": "<repo>/before-<id>.json", "kind": "record", "tracked": false, "writer": "棚卸し（M6）", "ends": "kept"},
    {"id": "backlog-depths", "place": "backlog-state", "path": "<repo>/depths.jsonl", "kind": "record", "tracked": false, "writer": "棚卸し（M6）", "ends": "kept"},
    {"id": "runtime-policy", "place": "ndf", "path": "runtimes.json", "kind": "declaration", "tracked": true, "writer": "人", "ends": "kept", "keys": ["allowed", "review_seats"], "main_keys": ["allowed", "review_seats"]},
    {"id": "ask", "place": "ndf", "path": "ask.json", "kind": "declaration", "tracked": true, "writer": "人", "ends": "kept", "keys": ["mode", "allow", "cost", "extra"]},
    {"id": "context", "place": "ndf", "path": "context.json", "kind": "declaration", "tracked": true, "writer": "人", "ends": "kept", "keys": ["policy", "trial", "margin"]},
    {"id": "estimate", "place": "ndf", "path": "estimate.json", "kind": "declaration", "tracked": true, "writer": "人", "ends": "kept", "keys": ["records_dir", "window", "min_samples"]},
    {"id": "issue-items", "place": "ndf", "path": "issue-items.json", "kind": "declaration", "tracked": true, "writer": "人", "ends": "kept", "keys": ["kinds", "last", "record_headings", "kind_labels", "items"]},
    {"id": "projects", "place": "ndf", "path": "projects.json", "kind": "declaration", "tracked": true, "writer": "人", "ends": "kept", "keys": ["owner", "number", "fields"]},
    {"id": "code-metrics", "place": "ndf", "path": "code-metrics.json", "kind": "declaration", "tracked": true, "writer": "人", "ends": "kept", "keys": ["tools"]},
    {"id": "handoff", "place": "ndf-handoff", "path": "<id>.md", "kind": "record", "tracked": false, "writer": "中継（M3）", "ends": "cleanup"},
    {"id": "sprint", "place": "ndf-sprints", "path": "<id>/", "kind": "record", "tracked": false, "writer": "開発ループとスプリント（M1）", "ends": "cleanup"},
    {"id": "parallel", "place": "ndf-parallel", "path": "<id>/", "kind": "record", "tracked": false, "writer": "計画の進行表（P3）", "ends": "cleanup"},
    {"id": "scratch", "place": "ndf-tmp", "path": "<id>/", "kind": "record", "tracked": false, "writer": "各副命令", "ends": "run"},
    {"id": "requirements", "place": "issues", "path": "issue-<n>-requirements.md", "kind": "document", "tracked": true, "writer": "要求の工程", "ends": "archived"},
    {"id": "design", "place": "issues", "path": "issue-<n>-design.md", "kind": "document", "tracked": true, "writer": "設計の工程", "ends": "archived"},
    {"id": "design-detail", "place": "issues", "path": "issue-<n>-design-detail.md", "kind": "document", "tracked": true, "writer": "詳細設計の工程", "ends": "archived"},
    {"id": "approval", "place": "issues", "path": "approval-<id>.md", "kind": "document", "tracked": false, "writer": "承認ゲート（P2）", "ends": "cleanup"},
    {"id": "archived-docs", "place": "issues-old", "path": "<name>.md", "kind": "document", "tracked": true, "writer": "後片付けの工程", "ends": "kept"},
    {"id": "relay-hub-state", "place": "relay-hub", "path": "hub.json", "kind": "exchange", "tracked": false, "writer": "中継（M3）", "ends": "replaced"},
    {"id": "relay-hub-registry", "place": "relay-hub", "path": "registry.json", "kind": "exchange", "tracked": false, "writer": "中継（M3）", "ends": "replaced"},
    {"id": "relay-hub-request", "place": "relay-hub", "path": "requests/<id>.json", "kind": "exchange", "tracked": false, "writer": "中継の頼む側（M3）", "ends": "run"},
    {"id": "relay-hub-result", "place": "relay-hub", "path": "results/<id>.json", "kind": "exchange", "tracked": false, "writer": "中継のリレーハブ（M3）", "ends": "run"},
    {"id": "relay-hub-log", "place": "relay-hub", "path": "hub-log.jsonl", "kind": "record", "tracked": false, "writer": "中継のリレーハブ（M3）", "ends": "cleanup"},
    {"id": "plan-progress", "place": "ndf-tmp", "path": "<sprint>/<n>-<plan>-state/progress.jsonl", "kind": "record", "tracked": false, "writer": "プランの実行（C2）", "ends": "cleanup", "reader": "service", "fields": ["step", "attention"]},
    {"id": "loop-record", "place": "ndf-loop", "path": "<loop>/loop.json", "kind": "record", "tracked": false, "writer": "開発ループとスプリント（M1）", "ends": "cleanup", "reader": "service"},
    {"id": "ask-ledger", "place": "mvv-state", "path": "ask.jsonl", "kind": "record", "tracked": false, "writer": "人への問いの守り（M3a）", "ends": "kept", "reader": "service"},
    {"id": "gate-rejections", "place": "mvv-state", "path": "gate-rejections.jsonl", "kind": "record", "tracked": false, "writer": "承認ゲート（P2）", "ends": "kept", "reader": "service"},
    {"id": "organizer-request", "place": "organizer", "path": "requests/<id>.json", "kind": "exchange", "tracked": false, "writer": "計画とレーンの進行表（P3）", "ends": "kept", "reader": "service", "fields": ["kind", "id", "lane", "prs", "issues", "sprint_state", "at", "ndf_version"]},
    {"id": "organizer-answer", "place": "organizer", "path": "answers/<id>.json", "kind": "exchange", "tracked": false, "writer": "外のオーガナイザー（サービス）", "ends": "kept", "fields": ["result"]},
    {"id": "organizer-range", "place": "organizer", "path": "ranges/<n>.json", "kind": "exchange", "tracked": false, "writer": "外のオーガナイザー（サービス）", "ends": "kept", "fields": ["sha", "version", "prs", "lanes"]},
    {"id": "organizer-batch", "place": "organizer", "path": "batch.json", "kind": "exchange", "tracked": false, "writer": "外のオーガナイザー（サービス）", "ends": "kept", "fields": ["step", "lanes"]},
    {"id": "organizer-presented", "place": "organizer", "path": "presented/<n>-<k>.json", "kind": "exchange", "tracked": false, "writer": "リリース（M2）", "ends": "kept", "reader": "service", "fields": ["k", "auto"]},
    {"id": "organizer-progress", "place": "organizer", "path": "progress/<n>.json", "kind": "exchange", "tracked": false, "writer": "リリース（M2）", "ends": "kept", "reader": "service", "fields": ["stages"]},
    {"id": "organizer-result", "place": "organizer", "path": "results/<n>.json", "kind": "exchange", "tracked": false, "writer": "リリース（M2）", "ends": "kept", "reader": "service", "fields": ["result"]},
    {"id": "issue-request", "place": "issue-request", "path": ".", "kind": "exchange", "tracked": false, "writer": "起票（M7）", "ends": "kept", "reader": "service", "fields": ["repo", "title", "body", "labels"]},
    {"id": "relay-wrapper", "place": "relay-wrappers", "path": "<名前>/wrapper.json", "kind": "exchange", "tracked": false, "writer": "中継のラッパー（M3b）", "ends": "replaced"},
    {"id": "relay-wrapper-lock", "place": "relay-wrappers", "path": "<名前>/relay.lock", "kind": "exchange", "tracked": false, "writer": "中継のラッパー（M3b）", "ends": "replaced"},
    {"id": "relay-wrapper-log", "place": "relay-wrappers", "path": "<名前>/log.jsonl", "kind": "record", "tracked": false, "writer": "中継のラッパー（M3b）", "ends": "cleanup"},
    {"id": "relay-next", "place": "relay-wrappers", "path": "<名前>/next.json", "kind": "exchange", "tracked": false, "writer": "Stop の hook（M3a）", "ends": "run"},
    {"id": "relay-question", "place": "relay-wrappers", "path": "<名前>/question.json", "kind": "exchange", "tracked": false, "writer": "PreToolUse の hook（M3a）", "ends": "run"},
    {"id": "relay-usage", "place": "relay-accounts", "path": "usage.json", "kind": "measured", "tracked": false, "writer": "使用率のセンサー（M3a）", "ends": "replaced", "keys": ["accounts"]},
    {"id": "relay-pinned-account", "place": "relay-accounts", "path": "pinned.json", "kind": "declaration", "tracked": false, "writer": "人（ndf relay account use）", "ends": "replaced"},
    {"id": "relay-mark", "place": "relay-marks", "path": "<id>.json", "kind": "exchange", "tracked": false, "writer": "中継のラッパー（M3b）", "ends": "run"},
    {"id": "relay-copy-launcher", "place": "relay-copy", "path": "relay.py", "kind": "exchange", "tracked": false, "writer": "人（ndf relay install）", "ends": "replaced"},
    {"id": "relay-copy-root", "place": "relay-copy", "path": "relay.root", "kind": "exchange", "tracked": false, "writer": "中継（M3b）", "ends": "replaced"}
  ]
}
