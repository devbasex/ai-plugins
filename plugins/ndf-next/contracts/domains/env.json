{
  "summary": "NDF が読む環境変数と、NDF が子のプロセスへ渡す環境変数。コードは名前をこの表から引き、表に無い名前を読まない。値が秘密の変数は名前だけを載せ、値をログと結果に出さない",
  "owner": "D2（contracts/domains）",
  "columns": {
    "area": {"type": "string", "summary": "読む領域（identity・runtime・relay・hooks・accounts・organizer・service・ci・notify）"},
    "set_by": {"type": "string", "summary": "値を入れる者。user は利用者、ndf は NDF が子のプロセスへ、runtime はランタイム（AI の CLI）、ci は GitHub Actions、service はサービス（Factory）の実行ジョブ"},
    "type": {"type": "string", "summary": "値の形。string・integer・seconds（秒の整数）・flag（あるかだけを見る）・path"},
    "secret": {"type": "boolean", "summary": "値が秘密（トークン・鍵）。値をログ・結果・記録へ出さない"},
    "meaning": {"type": "string", "summary": "何を決めるか。無いときの扱い"},
    "child": {"type": "string", "summary": "中継が起動する子のセッションへの渡し方。drop は渡さない、set は NDF が値を入れる。無ければそのまま渡す", "optional": true}
  },
  "rows": [
    {"id": "CLAUDE_PLUGIN_ROOT", "area": "identity", "set_by": "runtime", "type": "path", "secret": false, "meaning": "プラグインの根。無ければ読み手の位置から求める。ホストの推定では Claude Code の印"},
    {"id": "NDF_STATE_HOME", "area": "identity", "set_by": "user", "type": "path", "secret": false, "meaning": "状態の置き場の根。無ければ XDG_STATE_HOME の下"},
    {"id": "XDG_STATE_HOME", "area": "identity", "set_by": "user", "type": "path", "secret": false, "meaning": "XDG の状態の置き場。無ければ ~/.local/state"},
    {"id": "CLAUDECODE", "area": "runtime", "set_by": "runtime", "type": "flag", "secret": false, "meaning": "Claude Code の中で動いている印（ホストの推定）。中継が起動するセッションへ渡さない（残ると claude が入れ子の起動を断る）", "child": "drop"},
    {"id": "CLAUDE_CODE_SESSION_ID", "area": "runtime", "set_by": "runtime", "type": "string", "secret": false, "meaning": "Claude Code の今のセッションの ID。判定の記録と再起動の行をセッションに結ぶ。中継が起動するセッションへ親の ID を渡さない", "child": "drop"},
    {"id": "CODEX_PLUGIN_ROOT", "area": "runtime", "set_by": "runtime", "type": "path", "secret": false, "meaning": "Codex のプラグインの根（ホストの推定）"},
    {"id": "CODEX_HOME", "area": "runtime", "set_by": "runtime", "type": "path", "secret": false, "meaning": "Codex の設定の置き場（ホストの推定と使用量の読み取り）"},
    {"id": "KIRO_PLUGIN_ROOT", "area": "runtime", "set_by": "runtime", "type": "path", "secret": false, "meaning": "Kiro のプラグインの根（ホストの推定）"},
    {"id": "KIRO_AGENT", "area": "runtime", "set_by": "runtime", "type": "string", "secret": false, "meaning": "Kiro のエージェントの名前（ホストの推定）"},
    {"id": "NDF_RUNTIME_SESSION", "area": "runtime", "set_by": "user", "type": "string", "secret": false, "meaning": "ランタイムのセッションを <pid>:<開始時刻> で指定する（テストと CI）。無ければ祖先のプロセスから探す"},
    {"id": "NDF_RELAY_NAME", "area": "relay", "set_by": "user", "type": "string", "secret": false, "meaning": "名前つきのラッパーの名前。無ければリレーハブが t1・t2… を付ける"},
    {"id": "NDF_RELAY_SPAWNED", "area": "relay", "set_by": "ndf", "type": "flag", "secret": false, "meaning": "リレーハブが tmux で起動したラッパーの印"},
    {"id": "NDF_RELAY_TMUX", "area": "relay", "set_by": "user", "type": "path", "secret": false, "meaning": "リレーハブが呼ぶ tmux の実行ファイル。無ければ PATH の tmux"},
    {"id": "NDF_RELAY_ROLE", "area": "relay", "set_by": "ndf", "type": "string", "secret": false, "meaning": "リレーハブが spawn --role で起動したラッパーの役割"},
    {"id": "NDF_RELAY_PLAN", "area": "relay", "set_by": "ndf", "type": "string", "secret": false, "meaning": "リレーハブが spawn --plan で起動したラッパーの並列の計画の名前"},
    {"id": "NDF_RELAY_MAX_NAMED", "area": "relay", "set_by": "user", "type": "integer", "secret": false, "meaning": "名前つきのラッパーの数の上限（レーン数の上限）。無ければマシンの設定"},
    {"id": "NDF_RELAY_MAX_STARTS", "area": "relay", "set_by": "user", "type": "integer", "secret": false, "meaning": "1 日に起動し直す回数の上限。無ければ上限の宣言の値"},
    {"id": "NDF_RELAY_HUB_WAIT", "area": "relay", "set_by": "user", "type": "seconds", "secret": false, "meaning": "頼む側がリレーハブの答えを待つ上限。無ければ上限の宣言の値"},
    {"id": "NDF_RELAY_STOP_WAIT", "area": "relay", "set_by": "user", "type": "seconds", "secret": false, "meaning": "名前つきの stop がラッパーの終わりを待つ上限。無ければ上限の宣言の値"},
    {"id": "NDF_RELAY_DIR", "area": "relay", "set_by": "ndf", "type": "path", "secret": false, "meaning": "中継のラッパーが子のセッションへ渡す区間のやり取りの置き場。hook が次の区間の印と問い合わせをここへ書く。無ければ中継の外"},
    {"id": "NDF_HOOK_OFF", "area": "hooks", "set_by": "user", "type": "string", "secret": false, "meaning": "止める guard の名前をカンマでつなぐ。all で全部を止める。無ければ全部の guard が働く。閾値はこの変数で受けず、上限の宣言から読む"},
    {"id": "CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION", "area": "relay", "set_by": "ndf", "type": "string", "secret": false, "meaning": "中継が起動する claude へ false を渡し、入力欄のサジェストを止める（人の入力と取り違えない）", "child": "set"},
    {"id": "GIT_ASKPASS", "area": "relay", "set_by": "user", "type": "path", "secret": false, "meaning": "git の認証の問い合わせ先。VS Code の窓の中の値は窓を閉じると固まるため、中継が起動するセッションへ渡さない", "child": "drop"},
    {"id": "VSCODE_GIT_ASKPASS_NODE", "area": "relay", "set_by": "user", "type": "path", "secret": false, "meaning": "VS Code の git 認証の部品。中継が起動するセッションへ渡さない", "child": "drop"},
    {"id": "VSCODE_GIT_ASKPASS_MAIN", "area": "relay", "set_by": "user", "type": "path", "secret": false, "meaning": "VS Code の git 認証の部品。中継が起動するセッションへ渡さない", "child": "drop"},
    {"id": "VSCODE_GIT_ASKPASS_EXTRA_ARGS", "area": "relay", "set_by": "user", "type": "string", "secret": false, "meaning": "VS Code の git 認証の部品。中継が起動するセッションへ渡さない", "child": "drop"},
    {"id": "VSCODE_GIT_IPC_HANDLE", "area": "relay", "set_by": "user", "type": "path", "secret": false, "meaning": "VS Code の git 認証の通り道。中継が起動するセッションへ渡さない", "child": "drop"},
    {"id": "XDG_BIN_HOME", "area": "relay", "set_by": "user", "type": "path", "secret": false, "meaning": "PATH のエントリポイント（ndf-relay）を置く置き場。無ければ ~/.local/bin"},
    {"id": "CLAUDE_CONFIG_DIR", "area": "relay", "set_by": "user", "type": "path", "secret": false, "meaning": "Claude Code の設定の置き場。中継の複製（ndf/relay.py）をこの下へ置く。無ければ ~/.claude"},
    {"id": "NDF_CLAUDE_ACCOUNT", "area": "accounts", "set_by": "user", "type": "string", "secret": false, "meaning": "子の claude を起動する登録済みのアカウントの名前", "child": "set"},
    {"id": "NDF_CLAUDE_API_KEY_NAME", "area": "accounts", "set_by": "ndf", "type": "string", "secret": false, "meaning": "子へ渡した API キーの名前。入れ子の監督が読む"},
    {"id": "NDF_CLAUDE_API_KEY_GENERATION", "area": "accounts", "set_by": "ndf", "type": "integer", "secret": false, "meaning": "子へ渡した API キーの世代。入れ子の監督が読む"},
    {"id": "NDF_CLAUDE_KEY_ACCOUNT", "area": "accounts", "set_by": "ndf", "type": "string", "secret": false, "meaning": "API キーで起動した子が、キーを外したときに戻る登録済みのアカウントの名前"},
    {"id": "ANTHROPIC_API_KEY", "area": "accounts", "set_by": "ndf", "type": "string", "secret": true, "meaning": "子の claude へ渡した API キー"},
    {"id": "NDF_ORGANIZER_DIR", "area": "organizer", "set_by": "ndf", "type": "path", "secret": false, "meaning": "外のオーガナイザーとファイルでやり取りする置き場。あればこのセッションは外のオーガナイザーのレーン"},
    {"id": "NDF_ORGANIZER_LANE", "area": "organizer", "set_by": "ndf", "type": "string", "secret": false, "meaning": "外のオーガナイザーのレーンの名前。NDF_ORGANIZER_DIR と組で渡す"},
    {"id": "NDF_FACTORY_RUN", "area": "service", "set_by": "service", "type": "flag", "secret": false, "meaning": "サービスの実行ジョブの中で動いている印"},
    {"id": "NDF_VERSION", "area": "service", "set_by": "service", "type": "string", "secret": false, "meaning": "サービスの実行ジョブが入れた NDF の版（開発版は <version>@<コミットの SHA>）"},
    {"id": "GITHUB_EVENT_PATH", "area": "ci", "set_by": "ci", "type": "path", "secret": false, "meaning": "GitHub Actions の事象の JSON。検査が PR 本文を読む"},
    {"id": "GITHUB_REPOSITORY", "area": "ci", "set_by": "ci", "type": "string", "secret": false, "meaning": "GitHub Actions が渡す owner/repo"},
    {"id": "GH_TOKEN", "area": "ci", "set_by": "user", "type": "string", "secret": true, "meaning": "GitHub の API のトークン"},
    {"id": "SLACK_BOT_TOKEN", "area": "notify", "set_by": "user", "type": "string", "secret": true, "meaning": "Slack の通知のトークン。無ければ通知しない"},
    {"id": "SLACK_CHANNEL_ID", "area": "notify", "set_by": "user", "type": "string", "secret": false, "meaning": "Slack の通知の宛先のチャンネル"}
  ]
}
