  "owner": "D2（contracts/domains）",
  "columns": {
    "id": {"type": "string", "summary": "フェーズの名前", "ref": "limits.json#monitor.phase."},
    "skill": {"type": "string", "summary": "フェーズを持つ収束ループ（cross-review か cross-refactoring）"},
    "launch": {"type": "boolean", "summary": "cross-refactoring の進行がフェーズの開始を記録し、担当の CLI を起動するフェーズ"},
    "coding": {"type": "boolean", "summary": "担当がコードを書くフェーズ。安全網（書いた変更を検証で戻す仕組み）に数える"},
    "fix": {"type": "boolean", "summary": "指摘を直すフェーズ"},
    "alive": {"type": "boolean", "summary": "監視が心拍のファイルを更新するフェーズ（最後の修正は除く）"},
    "reassign": {"type": "boolean", "summary": "担当を替えられるフェーズ"},
    "relaunch_in_place": {"type": "boolean", "summary": "担当を替えたとき、同じフェーズの中で起動し直すフェーズ（偽のフェーズは前のフェーズへ戻る）"},
    "undo": {"type": "boolean", "summary": "担当を替えたとき、そのフェーズが書いた範囲を取り消すフェーズ"},
    "resume_as": {"type": "string", "summary": "止まった実行を再開するときの位置（修正は検証の繰り返しの中にあり、修正からでなく検証から再開する）", "optional": true}
