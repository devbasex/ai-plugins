{
  "mcpServers": {
    "serena": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "serena-agent==1.7.0",
        "serena",
        "start-mcp-server",
        "--context",
        "codex",
        "--project-from-cwd",
        "--add-mode",
        "no-memories",
        "--add-mode",
        "no-onboarding",
        "--enable-web-dashboard",
        "False"
      ],
      "env": {
        "SERENA_HOME": ".serena"
      }
    }
  }
}
