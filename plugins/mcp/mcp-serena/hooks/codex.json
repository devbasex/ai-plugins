{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "uvx --from serena-agent==2.1.0 serena-hooks activate --client=codex",
            "statusMessage": "Activating Serena project",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uvx --from serena-agent==2.1.0 serena-hooks remind --client=codex",
            "statusMessage": "Checking Serena tool usage",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
