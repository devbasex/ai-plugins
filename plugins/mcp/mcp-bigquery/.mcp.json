{
  "mcpServers": {
    "bigquery": {
      "type": "http",
      "url": "https://bigquery.googleapis.com/mcp",
      "headersHelper": "t=$(gcloud auth print-access-token) && printf '{\"Authorization\":\"Bearer %s\"}' \"$t\"",
      "http_headers_helper": "t=$(gcloud auth print-access-token) && printf '{\"Authorization\":\"Bearer %s\"}' \"$t\"",
      "headers": {
        "Authorization": "Bearer ${BIGQUERY_ACCESS_TOKEN}"
      }
    }
  }
}
