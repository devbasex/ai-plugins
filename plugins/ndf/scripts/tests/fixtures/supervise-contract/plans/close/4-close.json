{
  "フェーズ": "まとめ",
  "課題": [
    15
  ],
  "モード": "standard",
  "作業場所": "<TMP>/repo/.worktrees/spec/m9",
  "branch": "spec/m9",
  "起点": "origin/main",
  "リポジトリ": "<TMP>/repo",
  "規則": "",
  "進め方": "fast",
  "上限": 21,
  "steps": [
    {
      "id": "spec",
      "type": "work",
      "full": true,
      "kind": "確定仕様化",
      "stage": "確定仕様化",
      "timeout": 3600,
      "prompt": "/ndf:plan-to-spec #15。課題の issues/ の計画と設計を docs/ へ移し、コミットする（push しない）。移すものが無ければ何もしない。",
      "next": "pr"
    },
    {
      "id": "pr",
      "type": "pr",
      "stage": "Pull Request",
      "base": "main",
      "title": "確定仕様化: スプリント m9",
      "summary": "スプリント m9（#15）の計画と設計を docs/ へ移す。issues/ と docs/ だけを触る",
      "changes": "無し（文書の置き場所だけ）",
      "next": "ready"
    },
    {
      "id": "ready",
      "type": "run",
      "cmd": "sh -c 'git push -q && gh pr ready {pr}'",
      "next": "config-save"
    },
    {
      "id": "config-save",
      "type": "run",
      "timeout": 120,
      "cmd": "python3 <NDF>/scripts/release-verification-steps.py user-config-save --dir {state_dir}",
      "next": "release-verify"
    },
    {
      "id": "release-verify",
      "type": "work",
      "full": true,
      "kind": "リリース後テスト",
      "stage": "リリース後テスト",
      "timeout": 3600,
      "prompt": "/ndf:release-verification スプリント m9（#15）。リリース記録は Pull Request #{queue_pr:release-prod} にある。受け入れ条件ごとに確かめ、スプリントの Pull Request の「手動確認」でリリース後テストへ回した項目と、マージ前に未検証として残した項目も行として載せて、リリース後テストの記録をその Pull Request へコメントで書く。課題は閉じない（次の close が閉じる）。進捗記録（progress-record.sh・projects-sync.sh）は打たない（このステップが ok で終わった後にプランが打つ）。番号が 0 なら本番へ出ていないため、何もせずに終える。導入の確かめは verify-install だけで行い、利用者の設定ディレクトリ（CLAUDE_CONFIG_DIR か ~/.claude、CODEX_HOME か ~/.codex）で導入の操作（claude plugin install / update / marketplace add / update、codex plugin add / marketplace add）を打たない。隔離のつもりで環境変数を付けて手で打つことも含む。利用者の設定ディレクトリへの導入が要る条件は、導入せずに記録の表のその行を「保留（理由: 利用者の設定ディレクトリへの導入が要る）」とし、作業の報告を「判断が要る」で返す（/ndf:release-verification の「利用者の設定ディレクトリで導入しない」）。",
      "on_fail": "config-check-on-fail",
      "next": "config-check"
    },
    {
      "id": "config-check",
      "type": "run",
      "timeout": 120,
      "cmd": "python3 <NDF>/scripts/release-verification-steps.py user-config-check --dir {state_dir}",
      "next": "deep-due"
    },
    {
      "id": "config-check-on-fail",
      "type": "run",
      "timeout": 120,
      "cmd": "python3 <NDF>/scripts/release-verification-steps.py user-config-check --dir {state_dir}",
      "on_exit": {
        "0": "stop"
      }
    },
    {
      "id": "deep-due",
      "type": "run",
      "cwd": "<TMP>/repo",
      "timeout": 300,
      "cmd": "python3 <NDF>/skills/backlog-refinement/scripts/upkeep.py depth due diff --sprint m9 --issues 15 --root <TMP>/repo",
      "skip_to": "merge-gate",
      "next": "retro"
    },
    {
      "id": "retro",
      "type": "work",
      "full": true,
      "kind": "振り返り",
      "stage": "振り返り",
      "timeout": 3600,
      "prompt": "/ndf:retrospective スプリント m9（#15）。扱うループの 1 回と課題は振り返りの範囲（`python3 <NDF>/skills/backlog-refinement/scripts/upkeep.py depth scope --sprint m9 --root <TMP>/repo` の `items` と `metrics.issues`。見送った回の課題を含む）である。材料に検査の記録の集計（`python3 <NDF>/scripts/check-trigger.py stats --root <TMP>/repo` の出力: トリガーが立った回数・検査ごとの指摘の件数・検査の後に逃げた不具合の件数）を使い、閾値の見直しが要るかを書く。課題は閉じない（後の close が閉じる）。",
      "next": "refine"
    },
    {
      "id": "refine",
      "type": "work",
      "full": true,
      "kind": "棚卸し",
      "stage": "棚卸し",
      "timeout": 3600,
      "prompt": "/ndf:backlog-refinement --depth diff スプリント m9（#15）。差分の棚卸しの工程として無人で通す。扱うループの 1 回と課題は振り返りの範囲（`python3 <NDF>/skills/backlog-refinement/scripts/upkeep.py depth scope --sprint m9 --root <TMP>/repo` の `items` と `metrics.issues`。見送った回の課題を含む）である。今の回の課題 15 は閉じない課題である。閉じてよい・重複の正本でない側・やらないのどの区分にも入れず、重複の組に入るときは閉じない課題を正本にする。候補が上限を超えて持ち越し（`metrics.deferred`）が出ても、`--limit` を上げて打ち直さず、番号と件数を報告に載せる。`upkeep.py apply` が終了コード 10 を返したら、承認を求めず、承認資料のパス（`presentation_path`）と対象の番号を報告に載せて終える。`--repo` を渡さない（記録のリポジトリの外へ書かない）。親 issue の起票と子 issue の結び付けは行わず、クラスタと提案する親 issue の内容（題・子の番号）を報告の「人の判断待ち」に載せて終える。",
      "next": "refine-record"
    },
    {
      "id": "refine-record",
      "type": "run",
      "cwd": "<TMP>/repo",
      "timeout": 120,
      "cmd": "python3 <NDF>/skills/backlog-refinement/scripts/upkeep.py depth record --depth diff --sprint m9 --progress '{state_dir}/progress.jsonl' --root <TMP>/repo",
      "next": "overhaul-due"
    },
    {
      "id": "overhaul-due",
      "type": "run",
      "cwd": "<TMP>/repo",
      "timeout": 300,
      "cmd": "python3 <NDF>/skills/backlog-refinement/scripts/upkeep.py depth due overhaul --root <TMP>/repo",
      "skip_to": "review-due",
      "next": "overhaul-claim"
    },
    {
      "id": "overhaul-claim",
      "type": "run",
      "cwd": "<TMP>/repo",
      "timeout": 60,
      "cmd": "python3 <NDF>/skills/backlog-refinement/scripts/upkeep.py owner claim --what overhaul --keepalive 5400 --root <TMP>/repo --pid \"$PPID\"",
      "on_exit": {
        "10": "overhaul-skipped"
      },
      "next": "overhaul"
    },
    {
      "id": "overhaul",
      "type": "work",
      "full": true,
      "kind": "棚卸し",
      "stage": "棚卸し",
      "timeout": 5400,
      "prompt": "/ndf:backlog-refinement --depth overhaul スプリント m9（#15）の後の大整理を無人で通す。持ち主の実行は `upkeep.py owner status` の `owner.run`、起動した条件は `depths.jsonl` の最後の `overhaul` の判定にある。今の回の課題 15 は閉じない課題である。閉じてよい・重複の正本でない側・やらないのどの区分にも入れず、重複の組に入るときは閉じない課題を正本にする。人へ問わず、MVV 判定が従う以外の起票は needs-decision を付けて人の判断待ちに置き、報告に載せて終える。最後に `depth record` と `owner release` を打つ。",
      "on_fail": "overhaul-release",
      "next": "overhaul-release"
    },
    {
      "id": "overhaul-release",
      "type": "run",
      "cwd": "<TMP>/repo",
      "timeout": 60,
      "cmd": "python3 <NDF>/skills/backlog-refinement/scripts/upkeep.py owner release --what overhaul --root <TMP>/repo --pid \"$PPID\"",
      "on_exit": {
        "10": "review-due"
      },
      "next": "review-due"
    },
    {
      "id": "overhaul-skipped",
      "type": "run",
      "cwd": "<TMP>/repo",
      "timeout": 60,
      "cmd": "python3 <NDF>/skills/backlog-refinement/scripts/upkeep.py depth record --depth overhaul --event skipped --root <TMP>/repo",
      "next": "review-due"
    },
    {
      "id": "review-due",
      "type": "run",
      "cwd": "<TMP>/repo",
      "timeout": 300,
      "cmd": "python3 <NDF>/skills/backlog-refinement/scripts/upkeep.py depth due review --root <TMP>/repo",
      "skip_to": "merge-gate",
      "next": "review-claim"
    },
    {
      "id": "review-claim",
      "type": "run",
      "cwd": "<TMP>/repo",
      "timeout": 60,
      "cmd": "python3 <NDF>/skills/backlog-refinement/scripts/upkeep.py owner claim --what review --keepalive 5400 --root <TMP>/repo --pid \"$PPID\"",
      "on_exit": {
        "10": "review-skipped"
      },
      "next": "review"
    },
    {
      "id": "review",
      "type": "work",
      "full": true,
      "kind": "棚卸し",
      "stage": "棚卸し",
      "timeout": 5400,
      "prompt": "/ndf:backlog-refinement --depth review スプリント m9（#15）の後の見直しを無人で通す。持ち主の実行は `upkeep.py owner status` の `owner.run`、起動した条件は `depths.jsonl` の最後の `review` の判定にある。今の回の課題 15 は閉じない課題である。閉じてよい・重複の正本でない側・やらないのどの区分にも入れず、重複の組に入るときは閉じない課題を正本にする。人へ問わず、MVV 判定が従う以外の起票は needs-decision を付けて人の判断待ちに置き、報告に載せて終える。最後に `depth record` と `owner release` を打つ。",
      "on_fail": "review-release",
      "next": "review-release"
    },
    {
      "id": "review-release",
      "type": "run",
      "cwd": "<TMP>/repo",
      "timeout": 60,
      "cmd": "python3 <NDF>/skills/backlog-refinement/scripts/upkeep.py owner release --what review --root <TMP>/repo --pid \"$PPID\"",
      "on_exit": {
        "10": "merge-gate"
      },
      "next": "merge-gate"
    },
    {
      "id": "review-skipped",
      "type": "run",
      "cwd": "<TMP>/repo",
      "timeout": 60,
      "cmd": "python3 <NDF>/skills/backlog-refinement/scripts/upkeep.py depth record --depth review --event skipped --root <TMP>/repo",
      "next": "merge-gate"
    },
    {
      "id": "merge-gate",
      "type": "run",
      "timeout": 120,
      "cmd": "python3 <NDF>/scripts/merged-steps.py merge-gate --pr {pr}",
      "gate_next": "end",
      "next": "merge"
    },
    {
      "id": "merge",
      "type": "run",
      "timeout": 4290,
      "cmd": "python3 <NDF>/scripts/merged-steps.py merge-when-green {pr} --timeout 3600",
      "probe": {
        "cmd": "python3 <NDF>/scripts/merged-steps.py probe --pr {pr} --act"
      },
      "on_exit": {
        "75": "stop"
      },
      "next": "close"
    },
    {
      "id": "merge-approved",
      "type": "run",
      "timeout": 4290,
      "cmd": "python3 <NDF>/scripts/merged-steps.py merge-when-green {pr} --timeout 3600 --gate-approved user",
      "probe": {
        "cmd": "python3 <NDF>/scripts/merged-steps.py probe --pr {pr} --act"
      },
      "on_exit": {
        "75": "stop"
      },
      "next": "close"
    },
    {
      "id": "close",
      "type": "run",
      "stage": "後片付け",
      "cwd": "<TMP>/repo",
      "timeout": 900,
      "cmd": "python3 <NDF>/scripts/sprint-close.py --record-pr {queue_pr:release-prod} --issues 15 --final-stage-from {state_dir}/progress.jsonl --with-verification --label 'スプリント m9の後片付け'",
      "next": "end"
    }
  ],
  "base_branch": "main",
  "記録": "<NDF>/scripts/projects-sync.sh",
  "スプリント状態": "<TMP>/out/sprint/sprint.json"
}
