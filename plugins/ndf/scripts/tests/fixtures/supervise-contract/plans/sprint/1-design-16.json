{
  "フェーズ": "設計",
  "課題": [
    16
  ],
  "モード": "standard",
  "作業場所": "<TMP>/repo/.worktrees/design/issue-16",
  "branch": "design/issue-16",
  "起点": "origin/main",
  "リポジトリ": "<TMP>/repo",
  "規則": "設計の cross-review は上限 3 ラウンドで打ち切る（収束を待たない）。上限に達して未解決の指摘が 0 件なら、収束と同じ経路（直しの取り込み → 仕様のコピーの照合 → 用語チェック）を通って gate。未解決が残れば解決のフロー（直し → 再レビュー）を回し、解決できない（review-settled の判定）か駆動そのものが失敗したら gate。",
  "上限": 35,
  "steps": [
    {
      "id": "glossary",
      "type": "run",
      "stage": "設計",
      "timeout": 300,
      "cmd": "python3 <NDF>/scripts/supervise.py design-glossary --mode standard --root . --out {state_dir}/work/glossary-candidates.md",
      "next": "requirements-check"
    },
    {
      "id": "requirements-check",
      "type": "run",
      "stage": "要求と受け入れ条件",
      "timeout": 120,
      "cmd": "python3 <NDF>/scripts/spec-copy.py check 16 issues/issue-16-requirements.md",
      "on_fail": "requirements",
      "next": "design"
    },
    {
      "id": "requirements",
      "type": "work",
      "full": true,
      "kind": "要求",
      "stage": "要求と受け入れ条件",
      "issues": true,
      "timeout": 3600,
      "next": "design",
      "prompt": "/ndf:requirements-design #16。人へ問わずに進め、決められない点は前提か未決として課題の本文へ書く。本文を書いたら `spec-copy.py write 16 issues/issue-16-requirements.md` で写しを作り、コミットする（push しない）。"
    },
    {
      "id": "design",
      "type": "work",
      "full": true,
      "kind": "設計",
      "stage": "設計",
      "issues": true,
      "timeout": 3600,
      "prompt": "/ndf:design #16。設計文書は 1,000 行以下にする（超える主題は設計を 2 本に分けると報告する）。コミットする（push しない）。",
      "next": "rebuild"
    },
    {
      "id": "rebuild",
      "type": "work",
      "full": true,
      "kind": "設計",
      "stage": "ドキュメント再構成",
      "issues": true,
      "timeout": 3600,
      "next": "pr",
      "prompt": "/ndf:document-rebuild issues/issue-16-design.md（#16 の設計文書。同じディレクトリの issue-16-design-*.md も含む）。内容を足さずに組み直し、前後の値の表を報告に載せる。コミットする（push しない）。"
    },
    {
      "id": "pr",
      "type": "pr",
      "stage": "ドキュメントレビュー",
      "base": "main",
      "title_doc": "issues/issue-16-design.md",
      "title": "設計: #16",
      "summary": "#16 の設計（スプリント m9）",
      "append": [
        "{state_dir}/work/glossary-candidates.md"
      ],
      "decisions": true,
      "next": "sync-body"
    },
    {
      "id": "sync-body",
      "type": "run",
      "stage": "ドキュメントレビュー",
      "timeout": 120,
      "cmd": "bash <NDF>/scripts/pr-body-decisions.sh sync {pr}",
      "next": "review"
    },
    {
      "type": "drive",
      "stage": "ドキュメントレビュー",
      "timeout": 3600,
      "id": "review",
      "drive": "cross-review",
      "kind": "ドキュメントレビュー",
      "args": "{pr}",
      "on_exit": {
        "6": "review-settled"
      },
      "on_fail": "ready",
      "next": "sync-review"
    },
    {
      "type": "run",
      "stage": "ドキュメントレビュー",
      "timeout": 120,
      "id": "review-settled",
      "cmd": "python3 <NDF>/scripts/supervise.py review-settled --state {state_dir}/state.json --step review --fix-step resolve --max-attempts 2 --max-cost 1.5 --max-seconds 3600",
      "on_exit": {
        "1": "resolve-sync",
        "2": "ready"
      },
      "on_fail": "ready",
      "next": "sync-review"
    },
    {
      "type": "run",
      "stage": "ドキュメントレビュー",
      "timeout": 120,
      "id": "resolve-sync",
      "cmd": "git fetch -q && git merge -q --ff-only '@{u}'",
      "on_fail": "ready",
      "next": "resolve"
    },
    {
      "id": "resolve",
      "type": "work",
      "kind": "修正",
      "stage": "ドキュメントレビュー",
      "inputs": [
        "review"
      ],
      "timeout": 1800,
      "prompt": "cross-review が上限のラウンドで終わり、未解決の指摘が残った。review の報告（結果の items[0].report）が示す未解決の指摘を直してコミットする（push しない）。直せない指摘は理由を PR のスレッドへ返信する。",
      "on_fail": "ready",
      "next": "push-resolve"
    },
    {
      "type": "run",
      "stage": "ドキュメントレビュー",
      "timeout": 300,
      "id": "push-resolve",
      "cmd": "git push -q && bash <NDF>/scripts/pr-body-decisions.sh sync {pr} && python3 <NDF>/scripts/supervise.py sync-title --pr {pr} --doc issues/issue-16-design.md",
      "on_fail": "ready",
      "next": "review"
    },
    {
      "type": "run",
      "stage": "ドキュメントレビュー",
      "timeout": 120,
      "id": "sync-review",
      "cmd": "git fetch -q && git merge -q --ff-only '@{u}'",
      "next": "requirements-recheck"
    },
    {
      "type": "run",
      "stage": "ドキュメントレビュー",
      "timeout": 120,
      "id": "requirements-recheck",
      "cmd": "python3 <NDF>/scripts/spec-copy.py check 16 issues/issue-16-requirements.md",
      "next": "survey-check"
    },
    {
      "id": "survey-check",
      "type": "run",
      "stage": "ドキュメントレビュー",
      "timeout": 120,
      "cmd": "python3 <NDF>/scripts/design-survey.py check --issue 16",
      "on_fail": "fix-survey",
      "next": "glossary-check"
    },
    {
      "id": "fix-survey",
      "type": "work",
      "kind": "修正",
      "stage": "ドキュメントレビュー",
      "inputs": [
        "survey-check"
      ],
      "timeout": 1800,
      "next": "survey-recheck",
      "prompt": "入力は外部の調査の検査（design-survey.py）の指摘である。指摘の行の決定の `作り方:` と `比べた候補:` を直すか、外部の調査の表へ出典つきの候補の行を足してコミットする（push しない）。比べずには直せない指摘（候補を調べ直さないと決まらないもの）は直さずに「判断が要る」と報告する。"
    },
    {
      "id": "survey-recheck",
      "type": "run",
      "stage": "ドキュメントレビュー",
      "timeout": 120,
      "cmd": "python3 <NDF>/scripts/design-survey.py check --issue 16",
      "next": "glossary-check"
    },
    {
      "id": "glossary-check",
      "type": "run",
      "stage": "ドキュメントレビュー",
      "timeout": 120,
      "cmd": "python3 <NDF>/scripts/glossary.py check --diff origin/main --root .",
      "on_fail": "fix-glossary",
      "next": "push-glossary"
    },
    {
      "id": "fix-glossary",
      "type": "work",
      "kind": "修正",
      "stage": "ドキュメントレビュー",
      "inputs": [
        "glossary-check"
      ],
      "timeout": 1800,
      "next": "glossary-recheck",
      "prompt": "用語チェックの当たりを直す。未登録の語は用語集へ足す（source は空にし、pending_source に設計文書のパスを書く）か、用語集の語へ言い換える。廃止した語は用語集の語へ言い換える。用語集を変えたら `glossary.py render` で文書を作り直し、コミットする（push しない）。利用者が採るかを決めるべき語は直さずに「判断が要る」と報告する。"
    },
    {
      "id": "glossary-recheck",
      "type": "run",
      "stage": "ドキュメントレビュー",
      "timeout": 120,
      "cmd": "python3 <NDF>/scripts/glossary.py check --diff origin/main --root .",
      "on_fail": "push-glossary",
      "next": "push-glossary"
    },
    {
      "id": "push-glossary",
      "type": "run",
      "stage": "ドキュメントレビュー",
      "timeout": 300,
      "cmd": "git push -q && bash <NDF>/scripts/pr-body-decisions.sh sync {pr} && python3 <NDF>/scripts/supervise.py sync-title --pr {pr} --doc issues/issue-16-design.md",
      "next": "ready"
    },
    {
      "id": "ready",
      "type": "run",
      "stage": "ドキュメントレビュー",
      "timeout": 300,
      "cmd": "gh pr ready {pr}",
      "next": "gate"
    },
    {
      "id": "gate",
      "type": "judge",
      "inputs": [
        "review",
        "glossary-recheck"
      ],
      "question": "設計承認ゲート（設計 Pull Request のマージ）へ渡す（gate）か、止める（stop）か。glossary-recheck に用語チェックの当たりが残っていれば、設計承認ゲートの提示に載せる",
      "choices": [
        "gate",
        "stop"
      ]
    }
  ]
}
