{
  "スプリント": "m9",
  "ブランチ": "sprint/m9",
  "リリースの経路": [
    {
      "route": "template",
      "target": "package-plugin",
      "branch": "main",
      "stage": "template",
      "note": null
    }
  ],
  "ステージ": [
    {
      "wave": 1,
      "name": "設計",
      "plans": [
        "<TMP>/out/sprint/1-design-16.json"
      ],
      "command": "python3 <NDF>/scripts/supervise.py queue <TMP>/out/sprint/1-design-16.json --max 3"
    },
    {
      "wave": 2,
      "name": "関門 1",
      "gate": "設計 Pull Request をまとめて承認してマージする"
    },
    {
      "wave": 3,
      "name": "設計の結果",
      "plans": [
        "<TMP>/out/sprint/3-design-results.json"
      ],
      "command": "python3 <NDF>/scripts/supervise.py queue <TMP>/out/sprint/3-design-results.json --max 3"
    },
    {
      "wave": 4,
      "name": "スプリントブランチ",
      "plans": [
        "<TMP>/out/sprint/4-sprint-branch.json"
      ],
      "command": "python3 <NDF>/scripts/supervise.py queue <TMP>/out/sprint/4-sprint-branch.json --max 3"
    },
    {
      "wave": 5,
      "name": "実装",
      "plans": [
        "<TMP>/out/sprint/5-impl-16.json",
        "<TMP>/out/sprint/5-impl-17.json"
      ],
      "command": "python3 <NDF>/scripts/supervise.py queue <TMP>/out/sprint/5-impl-16.json <TMP>/out/sprint/5-impl-17.json --max 3"
    },
    {
      "wave": 6,
      "name": "検査",
      "plans": [
        "<TMP>/out/sprint/6-check.json"
      ],
      "command": "python3 <NDF>/scripts/supervise.py queue <TMP>/out/sprint/6-check.json --max 3 --then <TMP>/out/sprint/7-release.json"
    },
    {
      "wave": 7,
      "name": "配布",
      "plans": [
        "<TMP>/out/sprint/7-release.json"
      ],
      "then_of": "検査",
      "resume": "python3 <NDF>/scripts/supervise.py queue <TMP>/out/sprint/7-release.json --max 3"
    },
    {
      "wave": 8,
      "name": "関門 2",
      "gate": "開発版の配布が書いた承認資料（issues/approval-foo-v1.2.0.md）を示して本番への配布の承認を取り、承認されたら「本番」のステージの command を打つ（差し戻されたら打たない）"
    },
    {
      "wave": 9,
      "name": "本番",
      "plans": [
        "<TMP>/out/sprint/9-release-prod.json"
      ],
      "command": "python3 <NDF>/scripts/supervise.py queue <TMP>/out/sprint/9-release-prod.json --max 3"
    }
  ]
}
