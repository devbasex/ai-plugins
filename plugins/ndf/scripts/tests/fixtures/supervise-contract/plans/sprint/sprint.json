    },
    {
      "wave": 4,
      "name": "設計の結果",
      "plans": [
        "<TMP>/out/sprint/4-design-results.json"
      ],
      "then_of": "設計 PR のマージ",
      "resume": "python3 <NDF>/scripts/supervise.py queue --resume <TMP>/out/sprint/done-3.json"
    },
    {
      "wave": 5,
      "name": "スプリントブランチ",
      "plans": [
        "<TMP>/out/sprint/5-sprint-branch.json"
