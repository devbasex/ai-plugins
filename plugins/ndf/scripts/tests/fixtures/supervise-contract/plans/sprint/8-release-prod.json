{
  "フェーズ": "リリース",
  "課題": [
    16,
    17
  ],
  "モード": "standard",
  "作業場所": "<TMP>/repo/.worktrees/release/v1.2.0",
  "branch": "release/v1.2.0",
  "起点": "origin/main",
  "版": {
    "プラグイン": "foo",
    "チャネル": "prod",
    "上げ幅": "patch",
    "明示": "1.2.0",
    "系列": null
  },
  "規則": "trunk の本番（#3703）: release は承認の前に版上げの PR を開いて 10 で止まり、その head（版上げのブランチ）から導入を確かめ（trial）、承認資料を作ってからリリース承認ゲートに入る。承認の後は approve から続け、release が宣言のマージの主体と方式で本番ブランチへ入れる。merge queue へ入れた・人のマージを待つ（6）なら release-landed で打ち直す。run のステップが落ちたら、外部の待ち（CI・ネットワーク）の揺れなら同じステップをもう一度。試用の導入の失敗・タグの重複・権限の不足と、コードや設定に原因があるもの（版数の書き漏れ・文書の形）は stop。",
  "上限": 16,
  "steps": [
    {
      "id": "bump",
      "type": "run",
      "stage": "デプロイ",
      "cmd": "python3 <NDF>/scripts/release-steps.py bump --plugin foo --to 1.2.0 --base main",
      "on_exit": {
        "2": "stop",
        "3": "stop"
      },
      "on_fail": "judge",
      "next": "bump-others"
    },
    {
      "id": "bump-others",
      "type": "run",
      "stage": "デプロイ",
      "cmd": "out=$(python3 <NDF>/scripts/release-steps.py changed-plugins --plugin foo --prs {queue_pr:check}) || { printf \"%s\\n\" \"$out\"; exit 1; }; printf \"%s\\n\" \"$out\"; printf \"%s\\n\" \"$out\" | python3 -c \"import json,sys; [print(i[\\\"name\\\"], i[\\\"to\\\"]) for i in json.loads(sys.stdin.read().strip().splitlines()[-1])[\\\"items\\\"]]\" | while read -r n to; do python3 <NDF>/scripts/release-steps.py bump --plugin \"$n\" --to \"$to\" --base main || exit 1; done",
      "on_fail": "judge",
      "next": "changelog"
    },
    {
      "id": "changelog",
      "type": "run",
      "cmd": "python3 <NDF>/scripts/release-steps.py changelog --version 1.2.0 --prs {queue_pr:check}",
      "on_fail": "judge",
      "next": "notes"
    },
    {
      "id": "notes",
      "type": "run",
      "stage": "デプロイ",
      "cmd": "sh -c 'python3 <NDF>/scripts/release-steps.py notes --version 1.2.0 --prs {queue_pr:check} && git add -A && (git diff --cached --quiet || git commit -q -m \"Release: foo v1.2.0\")'",
      "on_fail": "judge",
      "next": "snapshot"
    },
    {
      "id": "snapshot",
      "type": "run",
      "stage": "デプロイ",
      "timeout": 900,
      "cmd": "sh -c 'python3 <NDF>/scripts/release-steps.py run --root . --stage production --version 1.2.0 && git add -A && (git diff --cached --quiet || git commit -q -m \"Release: foo v1.2.0 のトークン消費の記録\")'",
      "on_fail": "judge",
      "next": "release"
    },
    {
      "id": "release",
      "type": "run",
      "stage": "デプロイ",
      "timeout": 7920,
      "cmd": "python3 <NDF>/scripts/release-steps.py release --version 1.2.0 --ci-wait 3600 --channel prod --approval <TMP>/repo/issues/approval-foo-v1.2.0.md",
      "on_exit": {
        "75": "stop",
        "6": "release-landed"
      },
      "on_fail": "judge",
      "next": "cd-result",
      "probe": {
        "cmd": "python3 <NDF>/scripts/merged-steps.py probe --head {branch} --head {base} --act"
      },
      "gate_next": "trial"
    },
    {
      "id": "release-landed",
      "type": "run",
      "stage": "デプロイ",
      "timeout": 7920,
      "cmd": "python3 <NDF>/scripts/release-steps.py release --version 1.2.0 --ci-wait 3600 --channel prod --approval <TMP>/repo/issues/approval-foo-v1.2.0.md",
      "on_exit": {
        "75": "stop",
        "6": "stop"
      },
      "on_fail": "judge",
      "next": "cd-result",
      "probe": {
        "cmd": "python3 <NDF>/scripts/merged-steps.py probe --head {branch} --head {base} --act"
      },
      "gate_next": "end"
    },
    {
      "id": "cd-result",
      "type": "run",
      "stage": "デプロイ",
      "timeout": 7920,
      "cwd": "<TMP>/repo",
      "cmd": "python3 <NDF>/scripts/release-steps.py cd-result --base main --head release/v1.2.0 --out {state_dir}/work/cd-result.json",
      "next": "record"
    },
    {
      "id": "record",
      "type": "run",
      "stage": "デプロイ",
      "timeout": 300,
      "cmd": "python3 <NDF>/scripts/release-steps.py record --version 1.2.0 --prs {queue_pr:check} --cd-result {state_dir}/work/cd-result.json",
      "pr_from": "release_pr_url",
      "on_exit": {
        "5": "stop"
      },
      "on_fail": "judge-record",
      "next": "verify"
    },
    {
      "id": "verify",
      "type": "run",
      "stage": "デプロイ",
      "timeout": 1500,
      "cwd": "<TMP>/repo",
      "cmd": "sh -c 'git pull -q --ff-only origin main && python3 <NDF>/scripts/release-verification-steps.py verify-install --ref main --expect 1.2.0 --runtimes claude'",
      "on_fail": "judge",
      "next": "cleanup"
    },
    {
      "id": "cleanup",
      "type": "run",
      "stage": "後片付け",
      "cwd": "<TMP>/repo",
      "cmd": "sh -c 'python3 <NDF>/scripts/merged-steps.py cleanup $(gh pr list --state merged --limit 30 --json number,headRefName --jq \".[] | select(.headRefName | startswith(\\\"release/v1.2.0\\\")) | .number\") {queue_pr:check}'",
      "on_fail": "judge",
      "next": "end"
    },
    {
      "id": "judge",
      "type": "judge",
      "inputs": [
        "bump",
        "bump-others",
        "changelog",
        "notes",
        "snapshot",
        "release",
        "verify",
        "release-landed",
        "trial",
        "facts",
        "explain",
        "others",
        "approve",
        "cleanup"
      ],
      "question": "落ちたステップを同じ形でもう一度（retry）か、止める（stop）か。retry なら decision に落ちたステップの id を返す。リリースのプランではコードを直さない。原因がコードや設定にあるなら stop を選ぶ（直しはベースブランチ宛ての Pull Request で入れる）",
      "choices": [
        "bump",
        "bump-others",
        "changelog",
        "notes",
        "snapshot",
        "release",
        "verify",
        "release-landed",
        "trial",
        "facts",
        "explain",
        "others",
        "approve",
        "cleanup",
        "stop"
      ]
    },
    {
      "id": "trial",
      "type": "run",
      "stage": "デプロイ",
      "timeout": 1500,
      "cwd": "<TMP>/repo",
      "cmd": "python3 <NDF>/scripts/release-verification-steps.py verify-install --ref release/v1.2.0 --expect 1.2.0 --runtimes claude",
      "on_fail": "judge",
      "next": "facts"
    },
    {
      "id": "facts",
      "type": "run",
      "cwd": "<TMP>/repo",
      "cmd": "python3 <NDF>/scripts/release-steps.py approval-facts --version 1.2.0 --prs  --approval issues/approval-foo-v1.2.0.md --head release/v1.2.0",
      "presentation_to": "issues/approval-foo-v1.2.0.md",
      "on_fail": "judge",
      "gate_next": "explain",
      "next": "explain"
    },
    {
      "id": "explain",
      "type": "run",
      "cwd": "<TMP>/repo",
      "cmd": "python3 <NDF>/scripts/release-steps.py notes --version 1.2.0 --prs  --approval issues/approval-foo-v1.2.0.md --verified claude --ref release/v1.2.0 --check-state '{queue_state:check}'",
      "on_fail": "judge",
      "next": "others"
    },
    {
      "id": "others",
      "type": "run",
      "cwd": "<TMP>/repo",
      "cmd": "python3 <NDF>/scripts/release-steps.py changed-plugins --plugin foo --prs  --approval issues/approval-foo-v1.2.0.md --head release/v1.2.0",
      "on_fail": "judge",
      "next": "end"
    },
    {
      "id": "approve",
      "type": "run",
      "stage": "デプロイ",
      "timeout": 120,
      "cwd": "<TMP>/repo",
      "cmd": "python3 <NDF>/scripts/release-steps.py approve --approval issues/approval-foo-v1.2.0.md --facts-from {state_dir} --by user",
      "next": "release",
      "gate_next": "end"
    },
    {
      "id": "judge-record",
      "type": "judge",
      "inputs": [
        "record"
      ],
      "question": "リリース記録の書き込み（record）が落ちた。リリースは済んでいる。GitHub の揺れなら record をもう一度、権限の不足・本番のリリースの PR が無いなら止める（stop）",
      "choices": [
        "record",
        "stop"
      ]
    }
  ],
  "ベースブランチ": "main",
  "リポジトリ": "<TMP>/repo",
  "記録": "<NDF>/scripts/projects-sync.sh",
  "ブランチ戦略": {
    "source": ".ndf/project.json の branch_strategy",
    "digest": "8541a847687a2283a3ec444cf3c72a8bcbe94d8115220bfd07be68f00f3f9476",
    "section": {
      "kind": "plugin",
      "release_strategy": "trunk",
      "branches": {
        "production": "main",
        "base": "main"
      },
      "sprint": {
        "start": "production",
        "integrate": "check",
        "doc_prs": "sprint"
      },
      "release": {
        "form": "package-plugin",
        "version_store": {
          "kind": "plugin"
        },
        "tag": null,
        "github_release": false,
        "cd": null,
        "plugin": "foo",
        "runtimes": [
          "claude"
        ]
      },
      "channels": [
        {
          "name": "stable",
          "ref": "main"
        }
      ],
      "approval": {
        "target": "release_pr",
        "via": "gate"
      },
      "merge": {
        "actor": "ndf",
        "method": "merge-queue",
        "commit": "merge",
        "admin": false
      },
      "verify": null
    }
  }
}
