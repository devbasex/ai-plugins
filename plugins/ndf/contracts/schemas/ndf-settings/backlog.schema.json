{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ndf-settings/backlog.schema.json",
  "title": "棚卸しの設定（.ndf/backlog.json）",
  "description": "棚卸しの順位の設定（容量・ラベルの下限・尺度ほか）と品質のクォータ、深さごとの頻度・閾値・上限",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "編集のときの補完に使うスキーマの位置。読み手は参照しない"
    },
    "version": {
      "type": "integer",
      "enum": [
        1
      ],
      "description": "設定の形のバージョン。読み手は知らないバージョンを読まない"
    },
    "scale": {
      "type": "array",
      "description": "尺度（2 個以上の正の整数の狭義の昇順）",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 2,
      "default": [
        1,
        2,
        3,
        5,
        8,
        13,
        20
      ]
    },
    "margin_steps": {
      "type": "integer",
      "description": "前倒しの閾値の余白（尺度のステップの数）",
      "minimum": 0,
      "default": 1
    },
    "auto_threshold": {
      "type": "integer",
      "description": "自動で進める閾値（尺度の値）",
      "default": 8
    },
    "capacity": {
      "type": "integer",
      "description": "容量（引数の --capacity が上書きする）。無ければ容量で区切らない",
      "minimum": 1
    },
    "dependents_steps": {
      "type": "array",
      "description": "[被依存の数の下限, 段階（尺度の値）] の列（下限の昇順）",
      "items": {
        "type": "array",
        "items": {
          "type": "integer"
        },
        "minItems": 2,
        "maxItems": 2
      },
      "default": [
        [
          0,
          1
        ],
        [
          1,
          5
        ],
        [
          2,
          8
        ],
        [
          3,
          13
        ],
        [
          5,
          20
        ]
      ]
    },
    "size_exponent": {
      "type": "number",
      "description": "大きさの指数",
      "minimum": 0,
      "maximum": 1,
      "default": 0.3
    },
    "large_slot_ratio": {
      "type": "number",
      "description": "大きな課題のクォータの割合（0 以上 1 未満）",
      "minimum": 0,
      "exclusiveMaximum": 1,
      "default": 0.5
    },
    "large_min_size": {
      "type": "integer",
      "description": "大きな課題とみなす最小の大きさ（尺度の値）。無ければ尺度の最後から 2 番目"
    },
    "label_floor": {
      "type": "object",
      "description": "ラベル → 段階（尺度の値）の下限",
      "additionalProperties": {
        "type": "integer"
      },
      "default": {}
    },
    "quality": {
      "type": "object",
      "description": "品質のクォータ。無ければスロットを取らない。書いたスロットの省略した項目は既定値",
      "properties": {
        "label": {
          "type": "string",
          "description": "品質の課題のラベル",
          "default": "quality"
        },
        "ratio": {
          "type": "number",
          "description": "スロットの割合（0 以上 1 未満）",
          "minimum": 0,
          "default": 0.2,
          "exclusiveMaximum": 1
        },
        "min": {
          "type": "integer",
          "description": "スロットの最小の件数",
          "minimum": 0,
          "default": 1
        }
      },
      "additionalProperties": false
    },
    "depths": {
      "type": "object",
      "description": "深さ（review・overhaul・research など）→ その深さの設定",
      "additionalProperties": {
        "type": "object",
        "description": "深さ 1 つの設定",
        "properties": {
          "seconds": {
            "type": "integer",
            "description": "1 回の秒の上限",
            "minimum": 1
          },
          "every": {
            "type": "integer",
            "description": "頻度（ループの 1 回の数）",
            "minimum": 1
          },
          "threshold": {
            "type": "number",
            "description": "閾値"
          },
          "limit": {
            "type": "integer",
            "description": "件数の上限",
            "minimum": 0
          }
        }
      }
    }
  },
  "x-ndf-location": "worktree",
  "x-ndf-read-by": [
    {
      "by": "ndf issues",
      "when": "棚卸しの順位を付けるときと、深さの秒の上限を決めるとき"
    }
  ],
  "examples": [
    {
      "quality": {
        "label": "quality",
        "ratio": 0.2,
        "min": 1
      }
    },
    {
      "capacity": 1,
      "label_floor": {
        "bug": 13
      }
    }
  ]
}
