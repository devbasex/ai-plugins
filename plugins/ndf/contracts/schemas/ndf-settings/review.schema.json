{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ndf-settings/review.schema.json",
  "title": "レビューの観点の設定（.ndf/review.json）",
  "description": "レビューで必ず見る観点の並びと、指摘の基準・見送り・返信を差し替えるプロファイル。version 1 は focus だけを読みほかのキーを無視し、version 2 は focus と profile、version 3 は focus と最上位の criteria・not_written と profiles を読む",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "編集のときの補完に使うスキーマの位置。読み手は参照しない"
    },
    "version": {
      "type": "integer",
      "enum": [
        1,
        2,
        3
      ],
      "description": "設定の形のバージョン。読み手は知らないバージョンを読まない"
    },
    "focus": {
      "type": "array",
      "description": "レビューで必ず見る観点の文。version 1 では必須",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "profile": {
      "$ref": "#/$defs/profile",
      "description": "version 2 のプロファイル（指摘の基準・書かないもの・見送りの種類・返信・観点の区分）。version 3 では書かず profiles に移す"
    },
    "criteria": {
      "$ref": "#/$defs/criteria",
      "description": "version 3 で全プロファイルに足す指摘の基準（番号 → 文）。番号はプロファイルか既定の基準と重ならない"
    },
    "not_written": {
      "$ref": "#/$defs/not_written",
      "description": "version 3 で全プロファイルに足す、書かないものの並び"
    },
    "profiles": {
      "type": "array",
      "description": "version 3 のプロファイルの候補。PR の変更ファイルのパスが paths に当たる先頭の 1 つを選ぶ。name は重ならず、paths を持たない候補は高々 1 つで末尾に置く",
      "items": {
        "$ref": "#/$defs/profile_entry"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "version": {
            "const": 1
          }
        }
      },
      "then": {
        "required": [
          "focus"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "version": {
            "const": 3
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "profile"
          ]
        }
      }
    }
  ],
  "$defs": {
    "criteria": {
      "type": "object",
      "description": "番号（1 以上の整数の文字列。2 と 3 は使えない）→ 空でない文。1 件以上",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[1-9][0-9]*$",
        "not": {
          "enum": [
            "2",
            "3"
          ]
        }
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "not_written": {
      "type": "array",
      "description": "書かないものの文の並び",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "waive_kinds": {
      "type": "object",
      "description": "見送りの種類（英小文字・数字・_）→ 空でない名前。1 件以上",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "reply": {
      "type": "string",
      "description": "見送りの返信の文。{inner} をちょうど 1 回含む",
      "pattern": "^(?=[\\s\\S]*\\{inner\\})(?![\\s\\S]*\\{inner\\}[\\s\\S]*\\{inner\\})"
    },
    "categories": {
      "type": "object",
      "description": "観点の区分の名前（英小文字・数字・_）→ 当てるパスと観点の文",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "paths",
          "instructions"
        ],
        "properties": {
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "\\S"
            }
          },
          "instructions": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    "replace_auto_categories": {
      "type": "boolean",
      "description": "自動の観点の区分を categories で置き換えるか"
    },
    "profile": {
      "type": "object",
      "description": "プロファイル。どれか 1 つでも形が違えば読み手はプロファイルを丸ごと読まない",
      "additionalProperties": false,
      "properties": {
        "criteria": {
          "$ref": "#/$defs/criteria"
        },
        "not_written": {
          "$ref": "#/$defs/not_written"
        },
        "waive_kinds": {
          "$ref": "#/$defs/waive_kinds"
        },
        "reply": {
          "$ref": "#/$defs/reply"
        },
        "categories": {
          "$ref": "#/$defs/categories"
        },
        "replace_auto_categories": {
          "$ref": "#/$defs/replace_auto_categories"
        }
      }
    },
    "profile_entry": {
      "type": "object",
      "description": "version 3 のプロファイルの候補 1 つ。profile と同じキーに name と paths を足す",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "候補の名前（英小文字・数字・_）",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "paths": {
          "type": "array",
          "description": "選ぶ条件の glob。無ければどの PR にも当たる",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "criteria": {
          "$ref": "#/$defs/criteria"
        },
        "not_written": {
          "$ref": "#/$defs/not_written"
        },
        "waive_kinds": {
          "$ref": "#/$defs/waive_kinds"
        },
        "reply": {
          "$ref": "#/$defs/reply"
        },
        "categories": {
          "$ref": "#/$defs/categories"
        },
        "replace_auto_categories": {
          "$ref": "#/$defs/replace_auto_categories"
        }
      }
    }
  },
  "x-ndf-location": "worktree",
  "x-ndf-read-by": [
    {
      "by": "ndf loop",
      "when": "レビューの引数を組むとき"
    },
    {
      "by": "工程: コードレビュー",
      "when": "レビューの観点を足すとき"
    },
    {
      "by": "ndf cross-review run",
      "when": "相手役と修正担当へ重点（基準 3）を渡すとき。version 1 の focus だけを読み、version 2・3 は invalid で止める（#3941）"
    }
  ],
  "examples": [
    {
      "version": 1,
      "focus": [
        "処理の回数と所要時間"
      ]
    },
    {
      "version": 3,
      "focus": [
        "処理の回数と所要時間"
      ],
      "profiles": [
        {
          "name": "docs",
          "paths": [
            "docs/**"
          ],
          "criteria": {
            "1": "読み手が違う手順を踏む食い違い"
          }
        },
        {
          "name": "code"
        }
      ]
    }
  ]
}
