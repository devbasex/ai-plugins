{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ndf-settings/runtime-policy.schema.json",
  "title": "使ってよいランタイムの設定（.ndf/runtimes.json）",
  "description": "起動してよいランタイムと cross-review の固定の組。認可に関わるため、メインディレクトリから読む。読み手は allowed・review_seats のほかのキー（version・$schema を含む）を知らないキーとして止める",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "allowed"
  ],
  "properties": {
    "allowed": {
      "type": "array",
      "description": "起動してよいランタイム（1 つ以上、重複なし）",
      "items": {
        "type": "string",
        "enum": [
          "claude",
          "codex",
          "agy",
          "kiro"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "review_seats": {
      "type": "array",
      "description": "cross-review の固定の組（2 つの異なる席の名前。どちらのランタイムも allowed にある）",
      "items": {
        "type": "string",
        "pattern": "^(claude|codex|agy|kiro)(-[2-9])?$"
      },
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true
    }
  },
  "x-ndf-location": "main",
  "x-ndf-read-by": [
    {
      "by": "工程: ランタイムの起動",
      "when": "ランタイムを起動する前に設定の外の名前を止めるとき"
    }
  ],
  "examples": [
    {
      "allowed": [
        "claude"
      ],
      "review_seats": [
        "claude",
        "claude-2"
      ]
    }
  ]
}
