{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mvv-signals.schema.json",
  "title": "MVV の改訂の兆候の 1 行",
  "description": "承認ゲートの回答と、cross-review の指摘の見送り（kind が review_disputed）から書く兆候の行（表 ndf-files の mvv-signals）。書き手は ndf.domains.records.mvv",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "at", "kind", "mvv_version", "repo"],
  "if": {"properties": {"kind": {"const": "review_disputed"}}},
  "then": {"required": ["pr", "key", "id", "sha256"]},
  "properties": {
    "version": {"$ref": "common.schema.json#/$defs/version", "description": "行の形のバージョン"},
    "at": {"$ref": "common.schema.json#/$defs/time", "description": "書いた時刻"},
    "kind": {"type": "string", "description": "兆候の種類"},
    "mvv_version": {"type": ["integer", "null"], "description": "回答したか指摘を見送ったときの MVV の設定のバージョン（無ければ null）"},
    "repo": {"type": "string", "description": "メインディレクトリの絶対パス"},
    "state": {"type": ["string", "null"], "description": "スプリント状態の名前"},
    "gate": {"type": ["string", "null"], "description": "承認ゲートの区分"},
    "pr": {"type": ["integer", "null"], "description": "PR の番号"},
    "key": {"type": "string", "description": "見送った指摘の、秘密を伏せた本文の sha256"},
    "id": {"type": "string", "description": "見送った指摘の番号"},
    "sha256": {"type": ["string", "null"], "description": "指摘を判定した MVV の本文の sha256"}
  }
}
