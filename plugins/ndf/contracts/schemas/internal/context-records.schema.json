{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context-records.schema.json",
  "title": "文脈の切り替えの判定の記録の 1 行",
  "description": "判定の記録（decisions/<owner>__<repo>.decisions.jsonl）の行。書き手は ndf.domains.relay.context_records",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "at", "runtime", "source", "session_id", "transcript", "model", "work", "event", "stage", "context", "window", "effective_limit", "band", "verdict", "reason", "basis", "estimate", "missing", "relay", "passed_once", "decide_from", "limit", "sources"],
  "properties": {
    "version": {"$ref": "common.schema.json#/$defs/version", "description": "行の形のバージョン"},
    "at": {"$ref": "common.schema.json#/$defs/time", "description": "書いた時刻"},
    "runtime": {"type": "string", "description": "ランタイム"},
    "source": {"type": "string", "description": "書いた口（hook・record）"},
    "session_id": {"type": ["string", "null"], "description": "セッション（知らなければ null）"},
    "transcript": {"type": ["string", "null"], "description": "会話の記録のパス"},
    "model": {"type": ["string", "null"], "description": "モデル"},
    "work": {"type": "string", "description": "作業の識別子（課題番号が取れなければ空）"},
    "event": {"type": "string", "description": "行の種類（判定かマーカー）"},
    "stage": {"type": ["string", "null"], "description": "工程"},
    "context": {"type": ["integer", "null"], "description": "文脈の量"},
    "window": {"type": ["integer", "null"], "description": "文脈の窓の大きさ"},
    "effective_limit": {"type": ["integer", "null"], "description": "効いた上限"},
    "band": {"type": ["string", "null"], "description": "文脈の量の区分"},
    "verdict": {"type": ["string", "null"], "description": "判定の結論"},
    "reason": {"type": ["string", "null"], "description": "再起動の理由"},
    "basis": {"type": ["string", "null"], "description": "継続の根拠"},
    "estimate": {"type": ["object", "null"], "additionalProperties": {"type": "number"}, "description": "費用の見込み"},
    "missing": {"type": "array", "items": {"type": "string"}, "description": "取れなかった値の名前"},
    "relay": {"type": "boolean", "description": "ラッパーの下か"},
    "passed_once": {"type": "boolean", "description": "1 度だけ通したか"},
    "decide_from": {"type": "integer", "description": "判断開始の値"},
    "limit": {"type": "integer", "description": "運用上限"},
    "sources": {"type": "object", "additionalProperties": {"type": "string"}, "description": "2 つの値の出所"}
  }
}
