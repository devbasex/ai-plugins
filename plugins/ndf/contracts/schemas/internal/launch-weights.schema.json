{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "launch-weights.schema.json",
  "title": "モデルと effort の実験の出現率のファイル",
  "description": "出現率のファイル（表 ndf-files の launch-weights）の形（#2944）。書き手は出現率の計算（B2）で、ndf.contracts.internal の種類 launch-weights として書き出す前にこの形で確かめる。月の掃除・保存先全体の片付け・回収も、この形に合うファイルだけを NDF が作ったものとして変える。必須の欄が欠けているか、ここに無い欄を持つファイルは、利用者が置いたものとして、どれも変えない。欄を足すときはここに足す",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "entries"],
  "properties": {
    "version": {"$ref": "common.schema.json#/$defs/version"},
    "entries": {
      "type": "array",
      "description": "項目。リポジトリ × 工程 × ランタイム × 互換性のキーで引く",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo", "stage", "runtime", "key", "at", "phase", "candidates", "allocation"],
        "if": {"properties": {"phase": {"const": "adaptive"}}},
        "then": {"required": ["probs"]},
        "else": {"not": {"required": ["probs"]}},
        "properties": {
          "repo": {"type": "string", "minLength": 1, "description": "リポジトリのキー"},
          "stage": {"type": "string", "minLength": 1, "description": "工程"},
          "runtime": {"type": "string", "minLength": 1, "description": "ランタイム"},
          "key": {"type": "string", "minLength": 1, "description": "互換性のキー"},
          "at": {"$ref": "common.schema.json#/$defs/time", "description": "計算した日時"},
          "phase": {"enum": ["burn_in", "adaptive"], "description": "段階"},
          "candidates": {"type": "array", "items": {"type": "integer", "minimum": 0}, "description": "計算したときの候補の組の添字"},
          "allocation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["window_days"],
            "description": "計算に使った割り付けの値（設定の experiments.allocation）",
            "properties": {
              "floor": {"type": "number"},
              "min_units": {"type": "integer"},
              "margin": {"type": "number"},
              "window_days": {"type": "integer", "minimum": 1, "maximum": 365}
            }
          },
          "probs": {"type": "array", "items": {"type": "number", "minimum": 0}, "description": "組ごとの確率。adaptive の項目は必ず持ち（割り付けがこの確率で抽選する）、burn_in の項目は持たない"},
          "models": {"type": "object", "additionalProperties": {"type": "string"}, "description": "計算に使った実際のモデル（まとまり → モデル）"},
          "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}, "description": "組ごとの計算に使った件数"},
          "cutoffs": {
            "type": "array",
            "description": "打ち切った組とその期限",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["arm", "until"],
              "properties": {"arm": {"type": "integer", "minimum": 0}, "until": {"$ref": "common.schema.json#/$defs/time", "description": "打ち切りの期限"}}
            }
          }
        }
      }
    }
  }
}
