{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/io/hooks.args.schema.json",
  "title": "ndf hooks の引数",
  "description": "ndf hooks が受ける引数。キーは引数の名前（オプションは -- の名前、位置引数は名前）。規約の生成が作り、手で直さない",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subcommand": {
          "const": "capture",
          "description": "下位の命令（入れ子は空白でつなぐ）"
        },
        "runtime": {
          "type": "string",
          "x-ndf-positional": true
        },
        "version": {
          "type": "string",
          "x-ndf-positional": true
        },
        "event": {
          "type": "string",
          "x-ndf-positional": true
        }
      },
      "required": [
        "subcommand",
        "runtime",
        "version",
        "event"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subcommand": {
          "const": "check-budget",
          "description": "下位の命令（入れ子は空白でつなぐ）"
        }
      },
      "required": [
        "subcommand"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subcommand": {
          "const": "render",
          "description": "下位の命令（入れ子は空白でつなぐ）"
        },
        "--check": {
          "type": "boolean",
          "description": "書かずに、作り直した結果と違えば stopped"
        }
      },
      "required": [
        "subcommand"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subcommand": {
          "const": "stats",
          "description": "下位の命令（入れ子は空白でつなぐ）"
        },
        "--days": {
          "type": "number",
          "default": 14.0
        }
      },
      "required": [
        "subcommand"
      ]
    }
  ]
}
