{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/io/training.args.schema.json",
  "title": "ndf training の引数",
  "description": "ndf training が受ける引数。キーは引数の名前（オプションは -- の名前、位置引数は名前）。規約の生成が作り、手で直さない",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subcommand": {
          "const": "check",
          "description": "下位の命令（入れ子は空白でつなぐ）"
        },
        "--runtime": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "claude",
              "codex"
            ]
          },
          "description": "確かめる担当（既定は確かめる口のある担当すべて）"
        }
      },
      "required": [
        "subcommand"
      ]
    }
  ]
}
