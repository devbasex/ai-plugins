{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/io/notify.args.schema.json",
  "title": "ndf notify の引数",
  "description": "ndf notify が受ける引数。キーは引数の名前（オプションは -- の名前、位置引数は名前）。規約の生成が作り、手で直さない",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subcommand": {
          "const": "send",
          "description": "下位の命令（入れ子は空白でつなぐ）"
        }
      },
      "required": [
        "subcommand"
      ]
    }
  ]
}
