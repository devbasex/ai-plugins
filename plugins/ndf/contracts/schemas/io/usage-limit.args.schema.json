{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/io/usage-limit.args.schema.json",
  "title": "ndf usage-limit の引数",
  "description": "ndf usage-limit が受ける引数。キーは引数の名前（オプションは -- の名前、位置引数は名前）。規約の生成が作り、手で直さない",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "--runtime": {
          "type": "string",
          "enum": [
            "claude",
            "codex",
            "agy",
            "kiro"
          ],
          "description": "判定する起動のランタイム"
        },
        "--stdout": {
          "type": "string",
          "description": "判定する起動の標準出力のファイル"
        },
        "--stderr": {
          "type": "string",
          "description": "判定する起動の標準エラー出力のファイル"
        }
      },
      "required": [
        "--runtime",
        "--stdout",
        "--stderr"
      ]
    }
  ]
}
