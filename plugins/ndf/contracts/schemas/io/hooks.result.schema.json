{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hooks.result.schema.json",
  "title": "ndf hooks の結果 JSON",
  "description": "ndf hooks が標準出力の最後の 1 行に出す結果 JSON。共通の欄は結果のコントラクト（result.schema.json）が持ち、ここは metrics と items の形だけを足す。metrics と items の要素は閉じていて、載せた項目のほかの項目を持つと通らない",
  "allOf": [
    {
      "$ref": "../result.schema.json"
    }
  ],
  "properties": {
    "tool": {
      "const": "hooks"
    },
    "metrics": {
      "type": "object",
      "description": "ndf hooks の計測値",
      "additionalProperties": false,
      "properties": {
        "days": {
          "type": "number",
          "description": "計測を読んだ日数（stats）"
        },
        "cases": {
          "type": "integer",
          "description": "判定した例の件数（judge-cases）"
        },
        "missed": {
          "type": "integer",
          "description": "1 周でも外れた例の件数（judge-cases）"
        },
        "calls": {
          "type": "integer",
          "description": "軽いモデルを打った回数（judge-cases）"
        },
        "min_seconds": {
          "type": "number",
          "description": "1 回の判定に掛かった秒の最小（judge-cases）"
        },
        "max_seconds": {
          "type": "number",
          "description": "1 回の判定に掛かった秒の最大（judge-cases）"
        }
      }
    },
    "items": {
      "type": "array",
      "description": "ndf hooks の項目の並び",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "description": "書いた・作り直した結果と違う登録か見本のパス"
          },
          "events": {
            "type": "object",
            "description": "事象ごとの計測（stats）"
          },
          "guards": {
            "type": "object",
            "description": "guard ごとの計測（stats）"
          },
          "id": {
            "type": "string",
            "description": "外れた判定の例の名前（judge-cases）"
          },
          "expect": {
            "type": "string",
            "description": "その例の期待する判定（judge-cases）"
          },
          "got": {
            "type": "array",
            "description": "外れた周の回答か失敗の種類（judge-cases）",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
