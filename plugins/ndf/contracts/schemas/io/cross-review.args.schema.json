        "--base": {
          "type": "string"
        },
        "--reviewer": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "--state-dir": {
          "type": "string"
        },
        "--pr": {
          "type": "integer"
        }
      },
      "required": [
