{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/io/cross-review.args.schema.json",
  "title": "ndf cross-review の引数",
  "description": "ndf cross-review が受ける引数。キーは引数の名前（オプションは -- の名前、位置引数は名前）。規約の生成が作り、手で直さない",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subcommand": {
          "const": "check-worktree",
          "description": "下位の命令（入れ子は空白でつなぐ）"
        },
        "worktree": {
          "type": "string",
          "x-ndf-positional": true
        }
      },
      "required": [
        "subcommand",
        "worktree"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subcommand": {
          "const": "finish",
          "description": "下位の命令（入れ子は空白でつなぐ）"
        },
        "--summary": {
          "type": "string"
        },
        "--findings": {
          "type": "string"
        }
      },
      "required": [
        "subcommand",
        "--summary"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subcommand": {
          "const": "fix-gate",
          "description": "下位の命令（入れ子は空白でつなぐ）"
        },
        "--state-dir": {
          "type": "string"
        },
        "--pr": {
          "type": "integer"
        },
        "--findings": {
          "type": "string"
        }
      },
      "required": [
        "subcommand",
        "--state-dir",
        "--pr"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subcommand": {
          "const": "head",
          "description": "下位の命令（入れ子は空白でつなぐ）"
        },
        "--pr": {
          "type": "integer"
        },
        "--repo": {
          "type": "string"
        }
      },
      "required": [
        "subcommand",
        "--pr"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subcommand": {
          "const": "lock",
          "description": "下位の命令（入れ子は空白でつなぐ）"
        },
        "worktree": {
          "type": "string",
          "x-ndf-positional": true
        },
        "--pr": {
          "type": "integer"
        },
        "--tool": {
          "type": "string",
          "default": "cross-review"
        }
      },
      "required": [
        "subcommand",
        "worktree",
        "--pr"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subcommand": {
          "const": "merge-fix",
          "description": "下位の命令（入れ子は空白でつなぐ）"
        },
        "--state-dir": {
          "type": "string"
        },
        "--pr": {
          "type": "integer"
        },
        "--file": {
          "type": "string"
        },
        "--findings": {
          "type": "string"
        }
      },
      "required": [
        "subcommand",
        "--state-dir",
        "--pr",
        "--file"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subcommand": {
          "const": "push-fix",
          "description": "下位の命令（入れ子は空白でつなぐ）"
        },
        "worktree": {
          "type": "string",
          "x-ndf-positional": true
        },
        "--branch": {
          "type": "string"
        },
        "--commit": {
          "type": "string"
        }
      },
      "required": [
        "subcommand",
        "worktree",
        "--branch"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subcommand": {
          "const": "release",
          "description": "下位の命令（入れ子は空白でつなぐ）"
        },
        "worktree": {
          "type": "string",
          "x-ndf-positional": true
        },
        "--repo-dir": {
          "type": "string"
        }
      },
      "required": [
        "subcommand",
        "worktree",
        "--repo-dir"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subcommand": {
          "const": "report",
          "description": "下位の命令（入れ子は空白でつなぐ）"
        },
        "--state-dir": {
          "type": "string"
        },
        "--pr": {
          "type": "integer"
        },
        "--repo": {
          "type": "string"
        }
      },
      "required": [
        "subcommand",
        "--state-dir",
        "--pr"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subcommand": {
          "const": "review-scope",
          "description": "下位の命令（入れ子は空白でつなぐ）"
        },
        "worktree": {
          "type": "string",
          "x-ndf-positional": true
        },
        "--purpose": {
          "type": "string"
        },
        "--base": {
          "type": "string"
        },
        "--reviewer": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "--state-dir": {
          "type": "string"
        },
        "--pr": {
          "type": "integer"
        }
      },
      "required": [
        "subcommand",
        "worktree",
        "--purpose",
        "--base",
        "--state-dir",
        "--pr"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subcommand": {
          "const": "run",
          "description": "下位の命令（入れ子は空白でつなぐ）"
        },
        "--pr": {
          "type": "integer"
        },
        "--state-dir": {
          "type": "string"
        },
        "--base": {
          "type": "string"
        },
        "--worktree": {
          "type": "string"
        },
        "--branch": {
          "type": "string"
        },
        "--purpose": {
          "type": "string",
          "default": "cross-review"
        },
        "--reviewer": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "--max-rounds": {
          "type": "integer",
          "default": 3
        },
        "--findings": {
          "type": "string"
        },
        "--reviewed-out": {
          "type": "string",
          "description": "相手役の全員が読めた最後のラウンドの HEAD を指定ファイルに書く。前の起動が書いた出力は始めに消す（書けなかった起動の後に前の値を残さない）。空のファイルは消さずに使う。出力の隣の記録（.<名前>.ndf-output.json）の保存先に書けなければ、レビューを始めずに precondition で停止する。NDF が書いたと確かめられない中身のあるファイル（記録の無い・書き換えた・作り直したもの）があれば、消さずにレビューを始めずに precondition で停止する。同じ出力先を実行中の別の起動が使っていれば、片付けずにレビューを始めずに precondition で停止する"
        },
        "--repo": {
          "type": "string",
          "description": "対象のリポジトリ（<所有者>/<リポジトリ>）。保存済みの状態と作業場所のリモートより優先する"
        },
        "--stop-on-hold": {
          "type": "boolean",
          "description": "人の判断を待つ指摘が残れば incomplete で終える"
        },
        "--reviewed-pr-out": {
          "type": "string",
          "description": "--reviewed-out と併用する。対象 PR の HEAD（起動時の head か、同じ起動でその PR のブランチへ push した修正コミット）をレビューしたと確認できた場合、指定ファイルに <所有者>/<リポジトリ>#<番号> を書く。指定した実行は、起動時に対象 PR を確認できなければレビューを始めずに precondition で停止し、同じ PR を読んだ記録だけを差分の起点や収束結果の再利用に使う。前の起動が書いた出力は始めに消す（書けなかった起動の後に前の値を残さない）。空のファイルは消さずに使う。出力の隣の記録（.<名前>.ndf-output.json）の保存先に書けなければ、レビューを始めずに precondition で停止する。NDF が書いたと確かめられない中身のあるファイル（記録の無い・書き換えた・作り直したもの）があれば、消さずにレビューを始めずに precondition で停止する。同じ出力先を実行中の別の起動が使っていれば、片付けずにレビューを始めずに precondition で停止する"
        },
        "--set-aside-unrecorded-out": {
          "type": "boolean",
          "description": "--reviewed-out・--reviewed-pr-out・--reviewed-base-out の出力先に NDF の記録の無いファイル（記録を残さない前のバージョンが書いた出力など）があれば、出力先の錠を取った後に、消さずに隣の別名（<名前>.unrecorded-<16 進>）へ移して続ける。移した先は標準エラーに出す。版上げをまたいで再開する NDF の工程が使う"
        },
        "--reviewed-base-out": {
          "type": "string",
          "description": "--reviewed-out と併用する。--base でなく PR の今のマージ先を比較元にし、レビューした HEAD のラウンドの比較元のブランチ名を指定ファイルに書く。マージ先が前のラウンドと違えば、新しいマージ先との全差分を読ませる。--reviewed-pr-out と同じく、起動時に対象 PR の head がレビューするブランチの先頭と確認できなければ precondition で停止し、レビューした HEAD がその PR の HEAD と確認できたときだけ書く。--reviewed-out なしで渡すか、--reviewed-out・--reviewed-pr-out と同じ保存先を渡すと、レビューを始めずに invalid で停止する。マージ先を取得するリモートが PR のベースリポジトリと一致すると確かめられなければ、レビューを始めずに precondition で停止する。前の起動が書いた出力は始めに消す（書けなかった起動の後に前の値を残さない）。空のファイルは消さずに使う。出力の隣の記録（.<名前>.ndf-output.json）の保存先に書けなければ、レビューを始めずに precondition で停止する。NDF が書いたと確かめられない中身のあるファイル（記録の無い・書き換えた・作り直したもの）があれば、消さずにレビューを始めずに precondition で停止する。同じ出力先を実行中の別の起動が使っていれば、片付けずにレビューを始めずに precondition で停止する"
        }
      },
      "required": [
        "subcommand",
        "--pr",
        "--state-dir",
        "--base"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subcommand": {
          "const": "state-file",
          "description": "下位の命令（入れ子は空白でつなぐ）"
        },
        "--state-dir": {
          "type": "string"
        },
        "--pr": {
          "type": "integer"
        },
        "--current": {
          "type": "integer"
        }
      },
      "required": [
        "subcommand",
        "--state-dir",
        "--pr"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subcommand": {
          "const": "sync",
          "description": "下位の命令（入れ子は空白でつなぐ）"
        },
        "worktree": {
          "type": "string",
          "x-ndf-positional": true
        },
        "--branch": {
          "type": "string"
        }
      },
      "required": [
        "subcommand",
        "worktree",
        "--branch"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subcommand": {
          "const": "target-repo",
          "description": "下位の命令（入れ子は空白でつなぐ）"
        },
        "--repo": {
          "type": "string"
        },
        "--state-dir": {
          "type": "string"
        },
        "--pr": {
          "type": "integer"
        }
      },
      "required": [
        "subcommand"
      ]
    }
  ]
}
