      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subcommand": {
          "const": "collected",
          "description": "下位の命令（入れ子は空白でつなぐ）"
        },
        "--paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "--timeout": {
          "type": "number"
        },
        "--work": {
          "type": "string",
          "default": "."
        }
      },
      "required": [
        "subcommand",
        "--paths"
      ]
    },
    {
      "type": "object",
