          "type": "string"
        },
        "--base": {
          "type": "string"
        },
        "--scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "--required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "--ci-test": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "--symbols": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "--participants": {
          "type": "array",
