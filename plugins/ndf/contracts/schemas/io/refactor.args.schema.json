{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/io/refactor.args.schema.json",
  "title": "ndf refactor の引数",
  "description": "ndf refactor が受ける引数。キーは引数の名前（オプションは -- の名前、位置引数は名前）。規約の生成が作り、手で直さない",
