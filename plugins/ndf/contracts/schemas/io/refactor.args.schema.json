        "--symbols": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "--work": {
          "type": "string",
          "default": "."
        }
      },
      "required": [
        "subcommand",
        "--base",
        "--scope"
      ]
    }
  ]
}
