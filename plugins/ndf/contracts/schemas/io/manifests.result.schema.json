{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifests.result.schema.json",
  "title": "ndf manifests の結果 JSON",
  "description": "ndf manifests が標準出力の最後の 1 行に出す結果 JSON。共通の欄は結果のコントラクト（result.schema.json）が持ち、ここは metrics と items の形だけを足す。metrics と items の要素は閉じていて、載せた項目のほかの項目を持つと通らない",
  "allOf": [
    {
      "$ref": "../result.schema.json"
    }
  ],
  "properties": {
    "tool": {
      "const": "manifests"
    },
    "metrics": {
      "type": "object",
      "description": "ndf manifests の計測値",
      "additionalProperties": false,
      "properties": {}
    },
    "items": {
      "type": "array",
      "description": "ndf manifests の項目の並び",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "description": "書いた・消した・作り直した結果と違うファイルのプラグインの根からのパス"
          }
        },
        "required": [
          "path"
        ]
      }
    }
  }
}
