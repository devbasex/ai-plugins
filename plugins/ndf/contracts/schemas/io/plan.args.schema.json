{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/io/plan.args.schema.json",
  "title": "ndf plan の引数",
  "description": "ndf plan が受ける引数。キーは引数の名前（オプションは -- の名前、位置引数は名前）。規約の生成が作り、手で直さない",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subcommand": {
          "const": "check",
          "description": "下位の命令（入れ子は空白でつなぐ）"
        },
        "plans": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "x-ndf-positional": true
        }
      },
      "required": [
        "subcommand",
        "plans"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subcommand": {
          "const": "next",
          "description": "下位の命令（入れ子は空白でつなぐ）"
        },
        "plan": {
          "type": "string",
          "x-ndf-positional": true
        },
        "--from": {
          "type": "string"
        },
        "--state-dir": {
          "type": "string"
        },
        "--answer": {
          "type": "string"
        },
        "--by": {
          "type": "string",
          "description": "回答した者（human・conductor・organizer か service:<主体>）。--answer と組で渡す"
        },
        "--waiting": {
          "type": "string",
          "description": "回答する待ち（<ステップ>:<待ちの番号>）。返された routes が持つ。今の待ちと違えば記録しない"
        },
        "--presented": {
          "type": "string",
          "description": "回答する提示の識別子。返された routes が持つ。今の提示と違えば記録しない"
        },
        "--set": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "--fresh": {
          "type": "boolean"
        }
      },
      "required": [
        "subcommand",
        "plan"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subcommand": {
          "const": "pending",
          "description": "下位の命令（入れ子は空白でつなぐ）"
        }
      },
      "required": [
        "subcommand"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subcommand": {
          "const": "queue",
          "description": "下位の命令（入れ子は空白でつなぐ）"
        },
        "plans": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "x-ndf-positional": true
        },
        "--then": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "--from": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "--resume": {
          "type": "boolean"
        },
        "--fresh": {
          "type": "boolean"
        },
        "--max": {
          "type": "integer",
          "description": "同時に流すプランの本数の上限（無ければ触るファイルの重ならない組の本数まで）"
        },
        "--queue-dir": {
          "type": "string"
        }
      },
      "required": [
        "subcommand",
        "plans"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subcommand": {
          "const": "units check",
          "description": "下位の命令（入れ子は空白でつなぐ）"
        },
        "--issue": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "課題の番号。省くときは、単位のファイルを位置引数で指定するか、工程の入力 NDF_STAGE_INPUT を渡す"
        },
        "--omitted": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "実装計画を省いた課題の番号"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "単位のファイルを直に指す（--issue・--omitted と併せて渡さない）",
          "x-ndf-positional": true
        },
        "--docs": {
          "type": "boolean",
          "description": "実装計画のタスクの集合と 2 つの表も突き合わせる（--design-gate では指定しなくても突き合わせる）"
        },
        "--design-gate": {
          "type": "boolean",
          "description": "承認ゲートの前の確かめ。NDF_STAGE_INPUT の issues に、スプリントの全課題の番号を 1 件以上の整数の配列で渡す。ほかに、絶対パスの worktree と、スプリントブランチ名の branch を渡す。設計 PR のレビュー結果から outputs.reviewed を取り出し、reviewed に渡す。既定の起動を使う場合は、ndf cross-review run に --follow-base を付けて実行する。workflow.launch.review で起動を差し替えている場合は、その起動に --follow-base を渡して得た結果を使う。実装計画を省いた課題があれば、その番号を整数の配列（例 [3702]）として plan_omitted に渡す。位置引数、--issue、--omitted は指定しない。作業場所の HEAD が reviewed.head と一致し、そのコミットの検査を通ると outputs.design_units を返す"
        }
      },
      "required": [
        "subcommand"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subcommand": {
          "const": "units render",
          "description": "下位の命令（入れ子は空白でつなぐ）"
        },
        "--issue": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "スプリントの全課題の番号（1 つ以上）"
        },
        "--omitted": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "実装計画を省いた課題の番号"
        }
      },
      "required": [
        "subcommand",
        "--issue"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subcommand": {
          "const": "wait",
          "description": "下位の命令（入れ子は空白でつなぐ）"
        },
        "plans": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "x-ndf-positional": true
        },
        "--state-dir": {
          "type": "string"
        },
        "--timeout": {
          "type": "number",
          "default": 3000.0
        }
      },
      "required": [
        "subcommand",
        "plans"
      ]
    }
  ]
}
