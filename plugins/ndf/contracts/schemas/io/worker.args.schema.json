{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/io/worker.args.schema.json",
  "title": "ndf worker の引数",
  "description": "ndf worker が受ける引数。キーは引数の名前（オプションは -- の名前、位置引数は名前）。規約の生成が作り、手で直さない",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subcommand": {
          "const": "append",
          "description": "下位の命令（入れ子は空白でつなぐ）"
        },
        "--report": {
          "type": "string"
        },
        "--done": {
          "type": "boolean"
        }
      },
      "required": [
        "subcommand",
        "--report"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subcommand": {
          "const": "attention",
          "description": "下位の命令（入れ子は空白でつなぐ）"
        },
        "progress": {
          "type": "string",
          "x-ndf-positional": true
        }
      },
      "required": [
        "subcommand",
        "progress"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subcommand": {
          "const": "closing-check",
          "description": "下位の命令（入れ子は空白でつなぐ）"
        },
        "--base": {
          "type": "string"
        },
        "--cwd": {
          "type": "string",
          "default": "."
        }
      },
      "required": [
        "subcommand",
        "--base"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subcommand": {
          "const": "collect",
          "description": "下位の命令（入れ子は空白でつなぐ）"
        },
        "--report": {
          "type": "string"
        }
      },
      "required": [
        "subcommand",
        "--report"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subcommand": {
          "const": "draft",
          "description": "下位の命令（入れ子は空白でつなぐ）"
        },
        "--state-dir": {
          "type": "string"
        }
      },
      "required": [
        "subcommand",
        "--state-dir"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subcommand": {
          "const": "plan-edit",
          "description": "下位の命令（入れ子は空白でつなぐ）"
        },
        "plan": {
          "type": "string",
          "x-ndf-positional": true
        },
        "--new": {
          "type": "string"
        },
        "--reason": {
          "type": "string"
        },
        "--state-dir": {
          "type": "string"
        }
      },
      "required": [
        "subcommand",
        "plan",
        "--new",
        "--reason"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subcommand": {
          "const": "plan-edits",
          "description": "下位の命令（入れ子は空白でつなぐ）"
        },
        "plans": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "x-ndf-positional": true
        },
        "--state-dir": {
          "type": "string"
        }
      },
      "required": [
        "subcommand",
        "plans"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subcommand": {
          "const": "prepare",
          "description": "下位の命令（入れ子は空白でつなぐ）"
        },
        "--dir": {
          "type": "string"
        },
        "--name": {
          "type": "string"
        }
      },
      "required": [
        "subcommand",
        "--dir",
        "--name"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subcommand": {
          "const": "run",
          "description": "下位の命令（入れ子は空白でつなぐ）"
        },
        "--kind": {
          "type": "string"
        },
        "--prompt-file": {
          "type": "string"
        },
        "--result-file": {
          "type": "string"
        },
        "--cwd": {
          "type": "string"
        },
        "--state-dir": {
          "type": "string"
        },
        "--sources": {
          "type": "string"
        },
        "--timeout": {
          "type": "number"
        },
        "--result-dir-id": {
          "type": "string"
        },
        "--require-output": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "subcommand",
        "--kind",
        "--prompt-file",
        "--result-file",
        "--cwd",
        "--state-dir"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subcommand": {
          "const": "write",
          "description": "下位の命令（入れ子は空白でつなぐ）"
        },
        "--path": {
          "type": "string",
          "description": "`ndf worker run` で起動された worker の中で使う。その起動に渡された結果の保存先の配下のファイルを指定する。本文は標準入力に渡し、既定では全文を置き換える"
        },
        "--append": {
          "type": "boolean",
          "description": "本文を末尾へ追記する。--op が必須で、--edit と同時に指定できない"
        },
        "--edit": {
          "type": "boolean",
          "description": "標準入力で、`old` と `new` の文字列を持つオブジェクトの空でない JSON 配列を渡す。配列の順に置き換え、各 `old` はその時点の本文にちょうど 1 か所ある空でない文字列にする。--op が必須で、--append と同時に指定できない"
        },
        "--op": {
          "type": "string",
          "description": "--append・--edit の操作ごとに新しくする識別子（同じ識別子で打ち直しても重ねて書かない）"
        }
      },
      "required": [
        "subcommand",
        "--path"
      ]
    }
  ]
}
