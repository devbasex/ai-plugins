{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/io/relay.args.schema.json",
  "title": "ndf relay の引数",
  "description": "ndf relay が受ける引数。キーは引数の名前（オプションは -- の名前、位置引数は名前）。規約の生成が作り、手で直さない",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subcommand": {
          "const": "account add",
          "description": "下位の命令（入れ子は空白でつなぐ）"
        },
        "name": {
          "type": "string",
          "description": "アカウントの名前（英小文字・数字・- と _ の 32 字まで）",
          "x-ndf-positional": true
        },
        "--code": {
          "type": "string",
          "description": "認可コード。- なら標準入力の 1 行（引数と記録に残さない）"
        }
      },
      "required": [
        "subcommand",
        "name"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subcommand": {
          "const": "account add-api-key",
          "description": "下位の命令（入れ子は空白でつなぐ）"
        },
        "name": {
          "type": "string",
          "description": "API キーの名前",
          "x-ndf-positional": true
        },
        "--account": {
          "type": "string",
          "description": "結び付ける登録済みアカウント"
        },
        "--key-file": {
          "type": "string",
          "description": "キーの値を 1 行目に持つファイル（省けば標準入力の 1 行）"
        },
        "--monthly": {
          "type": "string",
          "description": "月の額（ドル）"
        }
      },
      "required": [
        "subcommand",
        "name",
        "--account"
