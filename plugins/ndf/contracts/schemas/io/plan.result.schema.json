{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan.result.schema.json",
  "title": "ndf plan の結果 JSON",
  "description": "ndf plan が標準出力の最後の 1 行に出す結果 JSON。共通の欄は結果のコントラクト（result.schema.json）が持ち、ここは metrics と items の形だけを足す。metrics と items の要素は閉じていて、載せた項目のほかの項目を持つと通らない",
  "allOf": [
    {
      "$ref": "../result.schema.json"
    }
  ],
  "properties": {
    "tool": {
      "const": "plan"
    },
    "metrics": {
      "type": "object",
      "description": "ndf plan の計測値",
      "additionalProperties": false,
      "properties": {
        "round": {
          "type": "integer",
          "description": "回の番号（next）"
        },
        "production": {
          "type": "boolean",
          "description": "承認待ちのステップが示した、この承認でマージが本番へ反映され得るか（next の承認待ち。ステップが示したときだけ）"
        },
        "steps": {
          "type": "integer",
          "description": "流したステップの数（next）"
        },
        "plans": {
          "type": "integer",
          "description": "プランの数（wait・queue・check）"
        },
        "stopped": {
          "type": "integer",
          "description": "止まったプランの数（wait）"
        },
        "gates": {
          "type": "integer",
          "description": "承認ゲートで待つプランの数（wait）"
        },
        "waited_seconds": {
          "type": "number",
          "description": "待った秒（wait が上限に当たったとき）"
        },
        "ok": {
          "type": "integer",
          "description": "終わったプランの数（queue）"
        },
        "pending": {
          "type": "integer",
          "description": "待ちを抱えた実行の数（pending）"
        },
        "waves": {
          "type": "integer",
          "description": "同時に流せる組の数（check）"
        },
        "units": {
          "type": "integer",
          "description": "単位の数（units check・render）"
        },
        "violations": {
          "type": "integer",
          "description": "止める理由の数（units check・render）"
        },
        "warnings": {
          "type": "integer",
          "description": "目安の行数を超えた単位の数（units check・render）"
        }
      }
    },
    "items": {
      "type": "array",
      "description": "ndf plan の項目の並び",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "plan",
              "pr",
              "run",
              "wave",
              "violation",
              "path",
              "unit",
              "split"
            ],
            "description": "項目の種類"
          },
          "name": {
            "type": "string",
            "description": "プランの名前（plan）か単位の名前（unit）"
          },
          "step": {
            "type": [
              "string",
              "null"
            ],
            "description": "止まったか承認を待つステップ（plan）"
          },
          "gate": {
            "type": "boolean",
            "description": "承認の回答を待つか（plan）"
          },
          "detail": {
            "type": "string",
            "description": "プランの結果の要約（queue の plan）"
          },
          "cause": {
            "type": "object",
            "description": "停止理由（wait の plan）"
          },
          "routes": {
            "type": "object",
            "description": "回答ごとのコマンド（wait・queue の plan）"
          },
          "presentation_path": {
            "type": "string",
            "description": "承認待ちの routes と同じ提示の承認資料の絶対パス（wait の plan）"
          },
          "production": {
            "type": "boolean",
            "description": "この承認でマージが本番へ反映され得るか（wait の plan。ステップが示したときだけ）"
          },
          "number": {
            "type": "integer",
            "description": "PR の番号（pr）"
          },
          "run": {
            "type": "string",
            "description": "実行の名前（pending）か回の ID（next）"
          },
          "workflow": {
            "type": "string",
            "description": "耐久ワークフローの ID（pending）"
          },
          "status": {
            "type": [
              "string",
              "null"
            ],
            "description": "耐久ワークフローの状態（pending）か、プランの終わり方（wait・queue。流れていれば null）"
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "最後に更新した時刻（pending）"
          },
          "plans": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "同時に流せるプラン（wave）"
          },
          "reason": {
            "type": "string",
            "description": "プランか単位の誤り（violation）"
          },
          "path": {
            "type": "string",
            "description": "保存先のパス（path）"
          },
          "file": {
            "type": "string",
            "description": "単位のファイル（unit・split）。実装計画を省いた課題の単位は空"
          },
          "order": {
            "type": "integer",
            "description": "実行順（unit）。0 は依存の輪で決まらないこと"
          },
          "merge": {
            "type": "integer",
            "description": "マージの順（unit）"
          },
          "after": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "先に要る単位の file・unit・reason（unit）"
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "単位が含む課題（unit）"
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "担当するタスクの id と課題の番号 issue（unit）"
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "満たす受け入れ条件の <課題>:<番号>（unit）"
          },
          "lines": {
            "type": [
              "integer",
              "null"
            ],
            "description": "見込みの差分の行数（unit）。実装計画を省いた課題の単位は null"
          },
          "touches": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "触るファイル（unit）"
          },
          "rule": {
            "type": "string",
            "description": "規則の番号（U1〜U6）か missing・tasks・tables（violation）"
          },
          "unit": {
            "type": "string",
            "description": "単位の名前（violation・split）。単位に結び付かない違反は空"
          },
          "units": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "置き換える単位の name・tasks・after（split）。空なら区切れなかった"
          },
          "resplit": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "切り直すタスク（split）"
          },
          "remaining": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "案を当てた後に残る違反の rule・unit・reason（split）"
          },
          "repoint": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "最後の区切りへ付け替える依存の file・unit・issue（split）"
          }
        },
        "required": [
          "kind"
        ]
      }
    }
  }
}
