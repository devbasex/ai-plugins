{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "relay.result.schema.json",
  "title": "ndf relay の結果 JSON",
  "description": "ndf relay が標準出力の最後の 1 行に出す結果 JSON。共通の欄は結果のコントラクト（result.schema.json）が持ち、ここは metrics と items の形だけを足す。metrics と items の要素は閉じていて、載せた項目のほかの項目を持つと通らない",
  "allOf": [
    {
      "$ref": "../result.schema.json"
    }
  ],
  "properties": {
    "tool": {
      "const": "relay"
    },
    "metrics": {
      "type": "object",
      "description": "ndf relay の計測値",
      "additionalProperties": false,
      "properties": {
        "inside": {
          "type": "boolean",
          "description": "呼び手の claude がラッパーの直接の子か（notice）"
        },
        "stopped": {
          "type": "integer",
          "description": "停止のリクエストが通ったラッパーの数（stop --all）"
        },
        "decide_from": {
          "type": "integer",
          "description": "判断開始の値（context resolve）"
        },
        "limit": {
          "type": "integer",
          "description": "運用上限（context resolve）"
        },
        "samples": {
          "type": "integer",
          "description": "較正に使った標本の数の合計（context calibrate）"
        },
        "works": {
          "type": "integer",
          "description": "集計した作業の数（context report）"
        },
        "skipped": {
          "type": "integer",
          "description": "読めずに飛ばした判定の記録の行の数（context calibrate・report）か、起床の記録の行の数（cache report）"
        },
        "usage_skipped": {
          "type": "integer",
          "description": "読めずに飛ばした使用量ログの行の数（context report）"
        },
        "accounts": {
          "type": "integer",
          "description": "登録したアカウントの数（account list）"
        },
        "keys": {
          "type": "integer",
          "description": "登録した API キーの数（account list）"
        },
        "value": {
          "type": "integer",
          "description": "同時に動かすラッパーとレーンの数の上限（cap）"
        },
        "source": {
          "type": "string",
          "enum": [
            "machine",
            "env",
            "limits"
          ],
          "description": "上限の出所。マシンの設定・環境変数 NDF_RELAY_MAX_NAMED・上限の設定 relay.max-named（cap）"
        },
        "logs": {
          "type": "integer",
          "description": "読んだ起床の記録（ラッパーごとの cache-log.jsonl）の数（cache report）"
        },
        "waits": {
          "type": "integer",
          "description": "集計した待ちの数（cache report）"
        },
        "limit_stopped_waits": {
          "type": "integer",
          "description": "起床の回数の上限で止めた待ちの数（cache report）"
        },
        "unmatched_stopped_waits": {
          "type": "integer",
          "description": "起床の応答を突き合わせられずに止めた待ちの数（cache report）"
        },
        "wakes": {
          "type": "integer",
          "description": "起床の回数。wake と wake_result の wake_id の重複を除いた数（cache report）"
        },
        "hit_rate_by_age": {
          "type": "object",
          "description": "起床の age の幅（30m・45m・50m・55m・60m・60m+）ごとの、結べた組の数・当たりの数・当たりの率（cache report）",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "wakes",
              "hits",
              "rate"
            ],
            "properties": {
              "wakes": {
                "type": "integer"
              },
              "hits": {
                "type": "integer"
              },
              "rate": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        },
        "d_median": {
          "type": [
            "number",
            "null"
          ],
          "description": "起床の書き込みと出力の費用 d の中央値。費用の分かる起床が無ければ null（cache report）"
        },
        "wake_cost_median": {
          "type": [
            "number",
            "null"
          ],
          "description": "起床 1 回の実費（読み出しを含む）の中央値（cache report）"
        },
        "wait_seconds": {
          "type": "object",
          "description": "待ちの長さ（待ちの始まりの応答から待ちを終えた入力まで）の秒の p50・p75・p90（cache report）",
          "additionalProperties": false,
          "properties": {
            "p50": {
              "type": [
                "number",
                "null"
              ]
            },
            "p75": {
              "type": [
                "number",
                "null"
              ]
            },
            "p90": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "estimated_avoided_rewrites": {
          "type": "integer",
          "description": "避けた書き直しの回数の推定（1 つの待ちで最大 1 回。cache report）"
        },
        "estimated_avoided_tokens": {
          "type": "number",
          "description": "避けた書き直しの token の推定（cache report）"
        },
        "estimated_avoided_cost": {
          "type": "number",
          "description": "避けた書き直しの費用の差の推定（(w − r) × token − 起床の実費。cache report）"
        },
        "voided_waits": {
          "type": "integer",
          "description": "取り消した待ち（wait_void）の数。どの集計にも入れない（cache report）"
        },
        "partial_waits": {
          "type": "integer",
          "description": "wait_start が --since より前か無い待ちの数。どの集計にも入れない（cache report）"
        },
        "unmatched_wakes": {
          "type": "integer",
          "description": "wake_result の無い wake の数（cache report）"
        },
        "orphan_results": {
          "type": "integer",
          "description": "wake の無い wake_result の数（cache report）"
        },
        "preempted_wakes": {
          "type": "integer",
          "description": "割り込みで起床の呼び出しが無かった wake_result の数（cache report）"
        },
        "unpriced_waits": {
          "type": "integer",
          "description": "費用の分からない起床を持ち、避けた書き直しに入れなかった待ちの数（cache report）"
        },
        "by_version": {
          "type": "object",
          "description": "claude のバージョン（不明は unknown）ごとの、作業を待つ Stop の数と、取り合いか到着による失効で起床させられなくなった数と率（cache report）",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "contests": {
                "type": "integer"
              },
              "arrivals": {
                "type": "integer"
              },
              "work_stops": {
                "type": "integer"
              },
              "lost_work_stops": {
                "type": "integer"
              },
              "contested_work_stops": {
                "type": "integer"
              },
              "arrival_work_stops": {
                "type": "integer"
              },
              "lost_ratio": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "required": [
              "arrival_work_stops",
              "arrivals",
              "contested_work_stops",
              "contests",
              "lost_ratio",
              "lost_work_stops",
              "work_stops"
            ]
          }
        }
      }
    },
    "items": {
      "type": "array",
      "description": "ndf relay の項目の並び",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "description": "複製・エントリポイント・中継のマーカーのパス（install・mark）"
          },
          "state": {
            "type": [
              "string",
              "null"
            ],
            "description": "複製・エントリポイントの状態（install）か、ラッパーの状態（hub ls）、登録の状態（account list・check）"
          },
          "account": {
            "type": [
              "string",
              "null"
            ],
            "description": "選ばれるアカウント（account）か、次に使うアカウント（decide）、API キーを結び付けたアカウント（account add-api-key・list）"
          },
          "kind": {
            "type": "string",
            "description": "次の手の種類（decide）か、待ちを抱えた実行の種類（pending）、登録の種類 oauth・metered・api_key（account の登録のサブコマンド）"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "次の手の理由（decide）か、ラッパーの状態の理由（hub ls）、再起動の理由（context record）、確かめの失敗の区分（account add-bedrock・add-api-key・check）"
          },
          "prompt": {
            "type": "string",
            "description": "子へ送る 1 行（decide）"
          },
          "name": {
            "type": "string",
            "description": "名前つきのラッパー（hub）"
          },
          "running": {
            "type": [
              "boolean",
              "integer"
            ],
            "description": "ラッパーが動いているか（hub ls）か、本数の上限で断ったときに数えた本数（hub spawn・restart の refusal の項目）"
          },
          "cwd": {
            "type": [
              "string",
              "null"
            ],
            "description": "ラッパーの作業場所（hub ls）"
          },
          "args": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "ラッパーへ渡す引数（hub ls）"
          },
          "role": {
            "type": [
              "string",
              "null"
            ],
            "description": "ラッパーの役（hub ls）"
          },
          "plan": {
            "type": [
              "string",
              "null"
            ],
            "description": "ラッパーの計画（hub ls）"
          },
          "version": {
            "type": "string",
            "description": "ラッパーを起動したプラグインのバージョン（hub ls）"
          },
          "pending": {
            "type": [
              "array",
              "null"
            ],
            "description": "止める前に待ちを抱えていた実行（hub restart。読めなければ null）"
          },
          "run": {
            "type": "string",
            "description": "実行の名前（pending）か回の ID（next）"
          },
          "workflow": {
            "type": "string",
            "description": "耐久ワークフローの ID（pending）"
          },
          "status": {
            "type": [
              "string",
              "null"
            ],
            "description": "耐久ワークフローの状態（pending）か、プランの終わり方（wait・queue。流れていれば null）"
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "最後に更新した時刻（pending）"
          },
          "text": {
            "type": "string",
            "description": "カットポイントのアナウンスの 1 文（notice）"
          },
          "position": {
            "type": "string",
            "enum": [
              "relay",
              "no-dir",
              "not-running",
              "not-child"
            ],
            "description": "呼び手とラッパーの位置（notice）"
          },
          "ok": {
            "type": "boolean",
            "description": "停止のリクエストが通ったか（stop --all）"
          },
          "summary": {
            "type": "string",
            "description": "リレーハブの回答の要約（stop --all）"
          },
          "decide_from": {
            "type": "integer",
            "description": "判断開始の値（context resolve・record）"
          },
          "limit": {
            "type": "integer",
            "description": "運用上限（context resolve・record）"
          },
          "sources": {
            "type": "object",
            "description": "値ごとの出所（context resolve・record）"
          },
          "at": {
            "type": "string",
            "description": "判定の記録の行か見込みを書いた時刻（context record・calibrate）"
          },
          "runtime": {
            "type": "string",
            "description": "記録したランタイム（context record）"
          },
          "source": {
            "type": "string",
            "description": "行の書き手（context record）、従量の接続の設定の出所 env・saved（account list）"
          },
          "session_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "記録したセッション（context record）・ラッパーの今のセグメントのセッション（hub ls）"
          },
          "transcript": {
            "type": [
              "string",
              "null"
            ],
            "description": "会話の記録のパス（context record）"
          },
          "model": {
            "type": [
              "string",
              "null"
            ],
            "description": "モデル（context record）"
          },
          "work": {
            "type": "string",
            "description": "作業の識別子（context record・report）"
          },
          "event": {
            "type": "string",
            "description": "判定かマーカー（context record）"
          },
          "stage": {
            "type": [
              "string",
              "null"
            ],
            "description": "工程（context record）"
          },
          "context": {
            "type": [
              "integer",
              "null"
            ],
            "description": "コンテキストの量（context record）"
          },
          "window": {
            "type": [
              "integer",
              "null"
            ],
            "description": "窓の大きさ（context record）"
          },
          "effective_limit": {
            "type": [
              "integer",
              "null"
            ],
            "description": "効く上限（context record）"
          },
          "band": {
            "type": [
              "string",
              "null"
            ],
            "description": "帯（context record。判定をしないので null）"
          },
          "verdict": {
            "type": [
              "string",
              "null"
            ],
            "description": "判定（context record）"
          },
          "basis": {
            "type": [
              "string",
              "null"
            ],
            "description": "継続の根拠（context record）"
          },
          "estimate": {
            "type": [
              "object",
              "null"
            ],
            "description": "費用の見込み（context record）"
          },
          "missing": {
            "type": "array",
            "description": "取れなかった値（context record）"
          },
          "relay": {
            "type": "boolean",
            "description": "中継の下の記録か（context record）"
          },
          "passed_once": {
            "type": "boolean",
            "description": "一度通したか（context record）"
          },
          "restore_context": {
            "type": [
              "number",
              "null"
            ],
            "description": "復元の量の中央値（context calibrate）"
          },
          "restore_calls": {
            "type": [
              "number",
              "null"
            ],
            "description": "復元の呼び出し数の中央値（context calibrate）"
          },
          "handoff_calls": {
            "type": [
              "number",
              "null"
            ],
            "description": "引継ぎの呼び出し数の中央値（context calibrate）"
          },
          "handoff_output": {
            "type": [
              "number",
              "null"
            ],
            "description": "引継ぎの出力 token の中央値（context calibrate）"
          },
          "stage_calls": {
            "type": "object",
            "description": "工程ごとの呼び出し数の中央値（context calibrate）"
          },
          "stage_expiries": {
            "type": "object",
            "description": "工程ごとのキャッシュ切れの数の中央値（context calibrate）"
          },
          "samples": {
            "type": "object",
            "description": "値ごとの標本の数（context calibrate）"
          },
          "sessions": {
            "type": "integer",
            "description": "セッションの数（context report）"
          },
          "parts": {
            "type": "object",
            "description": "区分ごとの token・秒・費用（context report）"
          },
          "unknown_parts": {
            "type": "object",
            "description": "マーカーの無いセグメントの数（context report）"
          },
          "restores": {
            "type": "array",
            "description": "セッションごとの復元の量（context report）"
          },
          "restarts": {
            "type": "object",
            "description": "理由ごとの再起動の数（context report）"
          },
          "restart_count": {
            "type": "integer",
            "description": "再起動の数（context report）"
          },
          "auto_compacts": {
            "type": [
              "integer",
              "string"
            ],
            "description": "自動圧縮の数か「不明」（context report）"
          },
          "quality": {
            "type": "object",
            "description": "品質（context report）"
          },
          "email": {
            "type": [
              "string",
              "null"
            ],
            "description": "アカウントのメールアドレス（account add・list）"
          },
          "org_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "アカウントの組織名（account add・list）"
          },
          "pinned": {
            "type": "boolean",
            "description": "次のセグメントから使うと指定したアカウントか（account list）"
          },
          "percent": {
            "type": [
              "number",
              "null"
            ],
            "description": "使用率のキャッシュの使用率（account list。読めていなければ null）"
          },
          "capacity_declared": {
            "type": "object",
            "description": "定義した 5 時間と週のクォータの大きさ（account list・capacity）"
          },
          "provider": {
            "type": "string",
            "description": "従量の接続の提供元（account add-bedrock・list・check）"
          },
          "details": {
            "type": "object",
            "description": "従量の接続のプロファイル・地域・モデル（account add-bedrock・list・check）"
          },
          "keys": {
            "type": "array",
            "description": "環境変数の設定の変数の名前（account list。値は出さない）"
          },
          "monthly_usd": {
            "type": [
              "number",
              "null"
            ],
            "description": "API キーの月の額（account add-api-key・api-key-monthly・list）"
          },
          "replaced": {
            "type": "boolean",
            "description": "前の登録を置き換えたか（account add-bedrock・add-api-key）"
          },
          "use": {
            "type": "string",
            "description": "API キーへ切り替える使い方（account api-key-use）"
          },
          "weekly_at": {
            "type": "number",
            "description": "API キーへ切り替える週の使用率の閾値（account api-key-use）"
          },
          "url": {
            "type": "string",
            "description": "認可の URL（account add）"
          },
          "expires_at": {
            "type": "string",
            "description": "登録の途中の状態の期限（account add）"
          },
          "pid": {
            "type": [
              "integer",
              "null"
            ],
            "description": "ラッパーのプロセスの id（hub ls。状態のファイルが無ければ null）"
          },
          "turn_done": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "conductor の最後の応答が終わったか（hub ls --activity。求めていない・動いていない・会話の記録を読めなければ null）"
          },
          "moved": {
            "type": [
              "number",
              "null"
            ],
            "description": "conductor の最後の応答と、終わったバックグラウンドの作業の時刻のうち最も遅いもの。UNIX 時刻（hub ls）"
          },
          "background": {
            "type": [
              "integer",
              "null"
            ],
            "description": "終わったバックグラウンドの作業を除いた、まだ走っているとみなすバックグラウンドの作業の数（hub ls。確かめられなければ null）"
          },
          "registered": {
            "type": "boolean",
            "description": "登録簿に行があるか。偽は錠を持つだけのラッパー（hub ls）"
          },
          "seat": {
            "type": [
              "string",
              "null"
            ],
            "description": "行を始めた起動の席（hub ls）"
          },
          "refusal": {
            "const": "max-named",
            "description": "本数の上限による断り（hub spawn・restart）"
          },
          "cap": {
            "type": "integer",
            "description": "断ったときの上限（hub spawn・restart）"
          }
        }
      }
    }
  }
}
