{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "toolchain.schema.json",
  "title": "配る構成の設定",
  "description": "contracts/data/toolchain.json の形。NDF が動く Python の下限と、起動が入れる uv のバージョンとインストーラの sha256。読み手は ndf.contracts.toolchain",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "owner", "python", "uv"],
  "properties": {
    "summary": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1, "description": "設定を書き換えてよいオーナー（子 Issue の記号とパッケージ）"},
    "python": {
      "type": "object",
      "additionalProperties": false,
      "required": ["floor", "hook_floor"],
      "properties": {
        "floor": {"$ref": "#/$defs/MajorMinor", "description": "NDF が動く Python の下限"},
        "hook_floor": {"$ref": "#/$defs/MajorMinor", "description": "依存の環境が無いときに hook のエントリポイントが動くシステムの python3 の下限"}
      }
    },
    "uv": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "installer_sha256"],
      "properties": {
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "description": "起動が入れる uv のバージョン"},
        "installer_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "uv のインストーラの sha256"}
      }
    }
  },
  "$defs": {
    "MajorMinor": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"}
  }
}
