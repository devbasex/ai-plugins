{
  "summary": "実体のある配る Skill（manifests/skills.json の行で skills/<名前>/SKILL.md があるもの）ごとの入出力。公開する Skill（エントリポイントの表の種類 skill・block の target）の引数と環境変数はエントリポイントの表が SSOT で、この表の行は args・env を持たない（持てば ndf check の spec-skill が落とす）",
  "owner": "D2（contracts/domains。行は Skill を移す子が足す。初版は #3518）",
  "shared_names": true,
  "columns": {
    "args": {
      "type": "array",
      "summary": "Skill が受ける引数の形（正規表現。どれか 1 つに全体が一致する）。空の並びは引数を受けない。公開する Skill は持たない",
      "optional": true
    },
    "goal_end": {
      "type": "string",
      "summary": "/goal の終わりの条件（Skill が /goal で回るとき）。無ければ /goal で回らない",
      "optional": true
    },
    "ndf_settings": {
      "type": "array",
      "summary": "Skill が読む設定（domains/ndf-files の id）"
    },
    "env": {
      "type": "array",
      "summary": "Skill が読む環境変数（domains/env の id）。公開する Skill は持たない",
      "optional": true
    },
    "result": {
      "type": "string",
      "summary": "結果の形。block は応答の末尾の ndf-next ブロック、report は応答の末尾のセグメントの報告、none は決まった形を持たない"
    },
    "meaning": {
      "type": "string",
      "summary": "Skill が何をするか"
    }
  },
