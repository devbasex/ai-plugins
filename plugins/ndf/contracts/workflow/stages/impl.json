{
  "document": {
    "dsl": "1.0.3",
    "namespace": "ndf",
    "name": "impl",
    "version": "1.0.0",
    "title": "実装",
    "metadata": {
      "ndf": {
        "stage": "実装",
        "per_issue": true
      }
    }
  },
  "input": {
    "schema": {
      "resource": {
        "endpoint": "ndf://schemas/stage-io.schema.json#/$defs/impl-in"
      }
    }
  },
  "output": {
    "schema": {
      "resource": {
        "endpoint": "ndf://schemas/stage-io.schema.json#/$defs/impl-out"
      }
    }
  },
  "do": [
    {
      "work": {
        "call": "ndf.plan",
        "with": {
          "kind": "impl"
        },
        "metadata": {
          "ndf": {
            "kind": "work",
            "range": "issue_diff"
          }
        },
        "input": {
          "schema": {
            "resource": {
              "endpoint": "ndf://schemas/stage-io.schema.json#/$defs/activity-in"
            }
          }
        },
        "output": {
          "schema": {
            "resource": {
              "endpoint": "ndf://schemas/report.schema.json"
            }
          }
        }
      }
    }
  ]
}
