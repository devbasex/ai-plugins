{
  "document": {
    "dsl": "1.0.3",
    "namespace": "ndf",
    "name": "deploy",
    "version": "1.0.0",
    "title": "デプロイ",
    "metadata": {
      "ndf": {
        "stage": "デプロイ"
      }
    }
  },
  "input": {
    "schema": {
      "resource": {
        "endpoint": "ndf://schemas/stage-io.schema.json#/$defs/deploy-in"
      }
    }
  },
  "output": {
    "schema": {
      "resource": {
        "endpoint": "ndf://schemas/stage-io.schema.json#/$defs/deploy-out"
      }
    }
  },
  "do": [
    {
      "dev": {
        "call": "ndf.plan",
        "with": {
          "kind": "release",
          "channel": "dev"
        },
        "metadata": {
          "ndf": {
            "kind": "work",
            "range": "sprint_diff"
          }
        },
        "input": {
          "schema": {
            "resource": {
              "endpoint": "ndf://schemas/stage-io.schema.json#/$defs/activity-in"
            }
          }
        },
        "output": {
          "schema": {
            "resource": {
              "endpoint": "ndf://schemas/report.schema.json"
            }
          }
        }
      }
    },
    {
      "release": {
        "listen": {
          "to": {
            "one": {
              "with": {
                "type": "ndf.answer"
              }
            }
          }
        },
        "metadata": {
          "ndf": {
            "kind": "release",
            "range": "sprint_diff"
          }
        },
        "input": {
          "schema": {
            "resource": {
              "endpoint": "ndf://schemas/stage-io.schema.json#/$defs/activity-in"
            }
          }
        },
        "output": {
          "schema": {
            "resource": {
              "endpoint": "ndf://schemas/answer.schema.json"
            }
          }
        }
      }
    }
  ]
}
