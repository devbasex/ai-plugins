{
  "template": "document-review",
  "purpose": "document_review",
  "summary": "文書のレビュー: レビューの起動（終わり切らなくても incomplete で進む）→ 設計の検査（番号の無い「人へ残す判断」の行。落ちれば同じ原因を数えて worker が直し、直したバージョンをレビューし直してから検査へ戻る。直したバージョンのレビューが完了しなければ止まる）→ push。push が拒まれたら worker が直して検査からやり直す",
  "params": ["repo", "worktree", "branch", "remote", "base", "review", "worker"],
  "plan": {
    "name": "document-review-{{branch}}",
    "repo": "{{repo}}",
    "worktree": "{{worktree}}",
    "steps": [
      {"id": "review", "run": ["{{review}}"], "on_cause": {"incomplete": "design-check"}},
      {"id": "design-check", "run": ["ndf", "records", "design", "check", "--result", "{state_dir}/design-check.json", "--base", "{{base}}", "--remote", "{{remote}}"], "on_cause": {"check_failed": "design-check-repeat"}, "next": "push"},
      {"id": "design-check-repeat", "run": ["ndf", "route", "repeat", "--result", "{state_dir}/design-check.json", "--log", "{state_dir}/design-check-causes.jsonl"], "next": "design-check-fix"},
      {"id": "design-check-fix", "run": ["{{worker}}", "design-check-fix"], "next": "review-fixed"},
      {"id": "review-fixed", "run": ["{{review}}"], "next": "design-check"},
      {"use": "push", "on_fail": "fix-push", "next": "end"},
      {"use": "fix-push", "next": "design-check"}
    ]
  }
}
