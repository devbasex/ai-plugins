{
  "template": "design-detail",
  "purpose": "design_detail",
  "summary": "詳細設計: worker の詳細設計 → 設計の検査（番号の無い「人へ残す判断」の行。落ちれば同じ原因を数えて worker が直し、検査へ戻る）→ push。push が拒まれたら worker が直して検査からやり直す",
  "params": ["repo", "worktree", "branch", "remote", "base", "worker"],
  "plan": {
    "name": "design-detail-{{branch}}",
    "repo": "{{repo}}",
    "worktree": "{{worktree}}",
    "steps": [
      {"id": "work", "run": ["{{worker}}", "design-detail"]},
      {"use": "design-check"},
      {"use": "design-check-repeat"},
      {"use": "design-check-fix"},
      {"use": "push", "on_fail": "fix-push", "next": "end"},
      {"use": "fix-push", "next": "design-check"}
    ]
  }
}
