{
  "version": 1,
  "path": "plugins/ndf/scripts/worktree-testenv.sh",
  "summary": "NDF plugin: 作業ツリーごとにテスト環境を分けて立てる。",
  "args": {
    "unparsed": "--オプションと位置引数（副命令・値。$1・\"$@\"）を手で読む（シェルの位置引数は静的に拾えない）"
  },
  "env": [
    "WT_DOCKER_COMMAND",
    "WT_LINES"
  ],
  "settings": [],
  "stdin": "none",
  "stdout": "text",
  "writes": [],
  "reads": [],
  "exit": {
    "0": "成功（status ok）",
    "1": "違反があった・手順が失敗した（status stopped）"
  },
  "callers": [
    "plugins/ndf/scripts/lib/container_reach.py",
    "plugins/ndf/scripts/lib/worktree-declaration.sh",
    "plugins/ndf/skills/development-workflow/references/scripts-lookup.md",
    "plugins/ndf/skills/worktree/SKILL.md",
    "plugins/ndf/skills/worktree/references/test-execution.md"
  ]
}
