{
  "version": 1,
  "path": "plugins/ndf/scripts/sprint-state.py",
  "summary": "スプリントの状態を sprint.json に持ち、引継ぎ文書の節・status・ndf-next を生成する（#1063）。",
  "args": {
    "unparsed": "副命令を定数表・補助関数・繰り返しで作り、どの副命令の引数か静的に決められない"
  },
  "env": [
    "ANTHROPIC_API_KEY",
    "CLAUDE_CODE_SESSION_ID",
    "CLAUDE_CONFIG_DIR",
    "CODEX_HOME",
    "GH_TOKEN",
    "GITHUB_TOKEN",
    "HOME",
    "MONITOR_NO_EARLY_ERROR",
    "NDF_ACCOUNTS_DIR",
    "NDF_ACCOUNT_TOKEN_URL",
    "NDF_ACCOUNT_USAGE_URL",
    "NDF_API_KEY_CHECK_MODEL",
    "NDF_API_KEY_CHECK_URL",
    "NDF_CLAUDE_ACCOUNT",
    "NDF_CLAUDE_API_KEY_GENERATION",
    "NDF_CLAUDE_API_KEY_NAME",
    "NDF_CLAUDE_KEY_ACCOUNT",
    "NDF_CONTEXT_DIR",
    "NDF_CONTEXT_LIMIT",
    "NDF_CONTEXT_POLICY",
    "NDF_DEPS_REEXEC",
    "NDF_DEPS_VENV",
    "NDF_ESTIMATE_DIR",
    "NDF_FACTORY_RUN",
    "NDF_LEASE_DIR",
    "NDF_LOOP_EXCLUDE",
    "NDF_MVV_STATE_DIR",
    "NDF_ORGANIZER_DIR",
    "NDF_ORGANIZER_LANE",
    "NDF_PARALLEL_MAX_PLANS",
    "NDF_PRESENTATION_DIR",
    "NDF_RELAY_DIR",
    "NDF_RELAY_MAX_NAMED",
    "NDF_RELAY_NAME",
    "NDF_RUNTIME_SESSION",
    "NDF_SHARED_CONFIG_DIR",
    "NDF_STATE_HOME",
    "NDF_SUPERVISE_CLAUDE",
    "NDF_SUPERVISE_CLAUDE_FALLBACK",
    "NDF_SUPERVISE_LIMIT_SLEEP",
    "NDF_SUPERVISE_MODEL",
    "NDF_SV_STATE_DIR",
    "NDF_UPKEEP_STATE_DIR",
    "NDF_VERSION",
    "NDF_WHOLE_RUNS_DIR",
    "UV_PROJECT_ENVIRONMENT",
    "XDG_STATE_HOME"
  ],
  "settings": [
    {
      "file": "estimate.json",
      "keys": [
        "records_dir"
      ]
    },
    {
      "file": "pace.json",
      "keys": [
        "auto",
        "enabled",
        "verify"
      ]
    },
    {
      "file": "project.json",
      "keys": [
        "ndf_policies"
      ]
    },
    {
      "file": "supervise.json",
      "keys": [
        "release"
      ]
    },
    {
      "file": "worktree.json",
      "keys": [
        "base_branch"
      ]
    }
  ],
  "stdin": "none",
  "stdout": "json",
  "writes": [
    "answer-hold-json",
    "answer-hold-log-jsonl",
    "answer-hold-ran-json",
    "answer-json",
    "applied-json",
    "approved-txt",
    "breakdown-md",
    "checkpoint-json",
    "cost-estimates-json",
    "decisions-jsonl",
    "handoff-mark-json",
    "laps-md",
    "lease-json",
    "loop-json",
    "outside-plan-jsonl",
    "plan-json",
    "plan-md",
    "present-json",
    "presented-json",
    "prs-txt",
    "request-id-txt",
    "request-txt",
    "requests-json",
    "restore-json",
    "resume-mark-json",
    "revise-json",
    "revise-md"
  ],
  "reads": [],
  "exit": {
    "0": "成功（status ok）",
    "1": "失敗: ランタイムのセッションの外では開発ループの鍵を取れない（status stopped）",
    "2": "読めない・呼び出しの誤り（status stopped）",
    "3": "前提が無い: 持ち主の鍵を別の実行が持っている（status stopped）"
  },
  "callers": [
    "plugins/ndf/scripts/gate-rejections.py",
    "plugins/ndf/scripts/lib/README.md",
    "plugins/ndf/scripts/lib/gate_answer.py",
    "plugins/ndf/scripts/lib/gate_rejections.py",
    "plugins/ndf/scripts/lib/handoff_doc.py"
  ],
  "lease": {
    "loop start": {
      "key": "supervise.loop:name={name}",
      "unit": "session",
      "window_seconds": 86400
    },
    "loop select": {
      "key": "supervise.loop:name={name}",
      "unit": "session",
      "window_seconds": 86400
    },
    "loop exclude": {
      "key": "supervise.loop:name={name}",
      "unit": "session",
      "window_seconds": 86400
    },
    "loop sprint": {
      "key": "supervise.loop:name={name}",
      "unit": "session",
      "window_seconds": 86400
    },
    "loop gate": {
      "key": "supervise.loop:name={name}",
      "unit": "session",
      "window_seconds": 86400
    },
    "loop lap": {
      "key": "supervise.loop:name={name}",
      "unit": "session",
      "window_seconds": 86400
    },
    "loop finish": {
      "key": "supervise.loop:name={name}",
      "unit": "session",
      "window_seconds": 86400,
      "release": true
    },
    "loop pending": {
      "key": "supervise.loop:name={name}",
      "unit": "session",
      "window_seconds": 86400
    },
    "loop hold-question": {
      "key": "supervise.loop:name={name}",
      "unit": "session",
      "window_seconds": 86400
    },
    "loop stop": {
      "key": "supervise.loop:name={name}",
      "unit": "session",
      "window_seconds": 86400,
      "release": true,
      "shared": true
    }
  }
}
