{
  "version": 1,
  "path": "plugins/ndf/scripts/gate-rejections.py",
  "summary": "承認ゲートの利用者の答え（差し戻し・承認）を記録し、差し戻しを承認ゲートごとに数える（#1833・#2183）。",
  "args": {
    "options": [
      "--at",
      "--gate",
      "--issue",
      "--outcome",
      "--pr",
      "--repo",
      "--root",
      "--sprint",
      "--what"
    ],
    "positionals": []
  },
  "env": [
    "CLAUDE_CONFIG_DIR",
    "CODEX_HOME",
    "MONITOR_NO_EARLY_ERROR",
    "NDF_ACCOUNTS_DIR",
    "NDF_ACCOUNT_TOKEN_URL",
    "NDF_ACCOUNT_USAGE_URL",
    "NDF_CLAUDE_ACCOUNT",
    "NDF_DEPS_REEXEC",
    "NDF_DEPS_VENV",
    "NDF_MVV_STATE_DIR",
    "NDF_PRESENTATION_DIR",
    "NDF_SHARED_CONFIG_DIR",
    "NDF_SUPERVISE_CLAUDE",
    "NDF_SUPERVISE_CLAUDE_FALLBACK",
    "NDF_SUPERVISE_LIMIT_SLEEP",
    "NDF_SUPERVISE_MODEL"
  ],
  "settings": [
    {
      "file": "project.json",
      "keys": [
        "ndf_policies"
      ]
    },
    {
      "file": "worktree.json",
      "keys": [
        "base_branch"
      ]
    }
  ],
  "stdin": "none",
  "stdout": "step-result",
  "writes": [],
  "reads": [],
  "exit": {
    "0": "成功（status ok）",
    "2": "読めない・呼び出しの誤り（status stopped）"
  },
  "callers": [
    "plugins/ndf/scripts/lib/README.md",
    "plugins/ndf/skills/development-workflow/references/approval-request.md",
    "plugins/ndf/skills/development-workflow/references/conductor-entrypoints.md",
    "plugins/ndf/skills/retrospective/SKILL.md"
  ]
}
