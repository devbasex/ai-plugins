{
  "version": 1,
  "path": "plugins/ndf/scripts/parallel.py",
  "summary": "並列の計画（`.ndf/parallel/<計画名>/`）の下書き・検査・起動・進行の待ち・まとめた配布の提示と確定・レーンの配布の依頼と答え（#2436）。外のオーガナイザーのレーンと配布の実行は `--external` で置き場のファイルとやり取りする（#2439）。結果は統一 JSON レポートを 1 行で標準出力へ出す。",
  "args": {
    "options": [],
    "positionals": [],
    "subcommands": {
      "answer": {
        "options": [
          "--approved",
          "--by",
          "--choice",
          "--note",
          "--rejected",
          "--revise"
        ],
        "positionals": [
          "name",
          "id"
        ]
      },
      "await": {
        "options": [
          "--external",
          "--from",
          "--timeout"
        ],
        "positionals": [
          "name"
        ]
      },
      "check": {
        "options": [],
        "positionals": [
          "name"
        ]
      },
      "compose": {
        "options": [
          "--external"
        ],
        "positionals": []
      },
      "confirm": {
        "options": [
          "--take"
        ],
        "positionals": [
          "name",
          "n"
        ]
      },
      "helper": {
        "options": [],
        "positionals": [
          "name",
          "n",
          "k"
        ]
      },
      "init": {
        "options": [],
        "positionals": [
          "name"
        ]
      },
      "present": {
        "options": [
          "--approval",
          "--external",
          "--record"
        ],
        "positionals": [
          "name",
          "n",
          "k"
        ]
      },
      "request": {
        "options": [
          "--external",
          "--issues",
          "--lane",
          "--prs",
          "--state"
        ],
        "positionals": [
          "name"
        ]
      },
      "request-ask": {
        "options": [
          "--lane"
        ],
        "positionals": [
          "name"
        ]
      },
      "request-gate2": {
        "options": [
          "--report"
        ],
        "positionals": [
          "name",
          "n",
          "k"
        ]
      },
      "run": {
        "options": [],
        "positionals": [
          "name"
        ]
      },
      "settle": {
        "options": [
          "--done",
          "--external",
          "--reason",
          "--rejected"
        ],
        "positionals": [
          "name",
          "n"
        ]
      },
      "start": {
        "options": [],
        "positionals": [
          "name"
        ]
      },
      "stop": {
        "options": [
          "--force"
        ],
        "positionals": [
          "name"
        ]
      },
      "wait": {
        "options": [
          "--after",
          "--timeout"
        ],
        "positionals": [
          "name"
        ]
      }
    }
  },
  "env": [
    "CLAUDE_CONFIG_DIR",
    "CODEX_HOME",
    "GH_TOKEN",
    "GITHUB_TOKEN",
    "MONITOR_NO_EARLY_ERROR",
    "NDF_ACCOUNTS_DIR",
    "NDF_ACCOUNT_TOKEN_URL",
    "NDF_ACCOUNT_USAGE_URL",
    "NDF_CLAUDE_ACCOUNT",
    "NDF_DEPS_REEXEC",
    "NDF_DEPS_VENV",
    "NDF_ESTIMATE_DIR",
    "NDF_FACTORY_RUN",
    "NDF_MVV_STATE_DIR",
    "NDF_ORGANIZER_DIR",
    "NDF_ORGANIZER_LANE",
    "NDF_PARALLEL_MAX_PLANS",
    "NDF_PARALLEL_POLL",
    "NDF_PARALLEL_RELAY",
    "NDF_PARALLEL_STALL_MINUTES",
    "NDF_PRESENTATION_DIR",
    "NDF_RELAY_DIR",
    "NDF_RELAY_MAX_NAMED",
    "NDF_RELAY_NAME",
    "NDF_SHARED_CONFIG_DIR",
    "NDF_SUPERVISE_CLAUDE",
    "NDF_SUPERVISE_CLAUDE_FALLBACK",
    "NDF_SUPERVISE_LIMIT_SLEEP",
    "NDF_SUPERVISE_MODEL",
    "NDF_SV_STATE_DIR",
    "NDF_VERSION",
    "NDF_WHOLE_RUNS_DIR",
    "UV_PROJECT_ENVIRONMENT",
    "XDG_STATE_HOME"
  ],
  "settings": [
    {
      "file": "estimate.json",
      "keys": [
        "min_samples",
        "records_dir",
        "window"
      ]
    },
    {
      "file": "project.json",
      "keys": [
        "ndf_policies"
      ]
    },
    {
      "file": "supervise.json",
      "keys": [
        "release"
      ]
    },
    {
      "file": "worktree.json",
      "keys": [
        "base_branch"
      ]
    }
  ],
  "stdin": "text",
  "stdout": "step-result",
  "writes": [
    "answer-json",
    "answers-sent-json",
    "approved-txt",
    "breakdown-md",
    "plan-json",
    "plan-md",
    "present-json",
    "presented-json",
    "prs-txt",
    "request-id-txt",
    "request-txt",
    "requests-json",
    "run-log",
    "run-pid"
  ],
  "reads": [],
  "exit": {
    "0": "成功（status ok）",
    "1": "計画が無い・検査に誤り・動いていない・承認したコミットが無い（status stopped）",
    "2": "読めない・呼び出しの誤り（status stopped）",
    "3": "まだ変化が無い・答えがまだ無い（status stopped）",
    "4": "本番のプランが承認ゲートで止まっている（status stopped）",
    "10": "配布の依頼を送った・依頼が退けられた（status gate）"
  },
  "callers": [
    "plugins/ndf/scripts/lib/parallel_lane.py",
    "plugins/ndf/scripts/lib/parallel_plan.py",
    "plugins/ndf/scripts/lib/parallel_release.py",
    "plugins/ndf/scripts/supervise_lib/paths.py",
    "plugins/ndf/skills/development-workflow/references/parallel.md"
  ]
}
