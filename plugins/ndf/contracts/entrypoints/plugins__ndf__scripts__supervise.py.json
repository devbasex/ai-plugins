{
  "version": 1,
  "path": "plugins/ndf/scripts/supervise.py",
  "summary": "フェーズをスクリプトで駆動する。",
  "args": {
    "unparsed": "副命令を定数表・補助関数・繰り返しで作り、どの副命令の引数か静的に決められない"
  },
  "env": [
    "CLAUDE_CONFIG_DIR",
    "CODEX_HOME",
    "GH_TOKEN",
    "GITHUB_TOKEN",
    "HOME",
    "MONITOR_NO_EARLY_ERROR",
    "NDF_ACCOUNTS_DIR",
    "NDF_ACCOUNT_TOKEN_URL",
    "NDF_ACCOUNT_USAGE_URL",
    "NDF_CLAUDE_ACCOUNT",
    "NDF_DEPS_REEXEC",
    "NDF_DEPS_VENV",
    "NDF_ESTIMATE_DIR",
    "NDF_MVV_STATE_DIR",
    "NDF_ORGANIZER_DIR",
    "NDF_ORGANIZER_LANE",
    "NDF_PARALLEL_MAX_PLANS",
    "NDF_PRESENTATION_DIR",
    "NDF_RELAY_MAX_NAMED",
    "NDF_RELAY_NAME",
    "NDF_SHARED_CONFIG_DIR",
    "NDF_STATE_HOME",
    "NDF_STEP_EXTEND_FILE",
    "NDF_SUPERVISE_CLAUDE",
    "NDF_SUPERVISE_CLAUDE_FALLBACK",
    "NDF_SUPERVISE_LIMIT_SLEEP",
    "NDF_SUPERVISE_MODEL",
    "NDF_SV_STATE_DIR",
    "NDF_VERSION",
    "NDF_WHOLE_RUNS_DIR",
    "NDF_WORKTREE_BASE",
    "OLDPWD",
    "UV_PROJECT_ENVIRONMENT",
    "WT_DOCKER_COMMAND",
    "XDG_STATE_HOME"
  ],
  "settings": [
    {
      "file": "estimate.json",
      "keys": [
        "records_dir"
      ]
    },
    {
      "file": "project.json",
      "keys": [
        "ndf_policies",
        "test"
      ]
    },
    {
      "file": "supervise.json",
      "keys": [
        "release",
        "slow",
        "test"
      ]
    },
    {
      "file": "worktree.json",
      "keys": [
        "base_branch"
      ]
    }
  ],
  "stdin": "none",
  "stdout": "step-result",
  "writes": [
    "actuals-run-json",
    "answer-hold-json",
    "answer-hold-log-jsonl",
    "answer-json",
    "approved-txt",
    "breakdown-md",
    "phase-result-json",
    "plan-json",
    "plan-md",
    "present-json",
    "presented-json",
    "prs-txt",
    "report-md",
    "request-id-txt",
    "request-txt",
    "requests-json",
    "resume-mark-json",
    "state-json"
  ],
  "reads": [],
  "exit": {
    "0": "成功（status ok）",
    "1": "失敗: run のフェーズが止まった（phase-result.json の status stopped）",
    "2": "読めない・呼び出しの誤り（status stopped）",
    "3": "前提が無い、またはスクリプトが定めた正常な否定の結果（status stopped）",
    "10": "承認ゲート: run のフェーズが承認ゲートで終わった（phase-result.json の status gate）"
  },
  "callers": [
    "plugins/ndf/scripts/hook_lib/shell_checks.py",
    "plugins/ndf/scripts/hook_lib/token_guard.py",
    "plugins/ndf/scripts/lib/README.md",
    "plugins/ndf/scripts/lib/claude_accounts.py",
    "plugins/ndf/scripts/lib/claude_settings.py"
  ]
}
