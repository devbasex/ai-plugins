    "NDF_PRESENTATION_DIR",
    "NDF_STATE_HOME",
    "UV_PROJECT_ENVIRONMENT",
    "XDG_STATE_HOME"
  ],
  "settings": [],
  "stdin": "none",
  "stdout": "step-result",
  "writes": [],
  "reads": [],
  "exit": {
    "0": "成功（status ok）。移した・移すものが無い・根を出した",
