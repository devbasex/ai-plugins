{
  "version": 1,
  "path": "plugins/ndf/scripts/state-home.py",
  "summary": "NDF の状態の置き場の根を出す・旧の置き場から移す（#2766）。結果は統一 JSON レポートを 1 行で標準出力へ出す。",
  "args": {
    "options": [],
