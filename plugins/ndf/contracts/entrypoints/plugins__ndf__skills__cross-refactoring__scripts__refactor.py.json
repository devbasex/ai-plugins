{
  "version": 1,
  "path": "plugins/ndf/skills/cross-refactoring/scripts/refactor.py",
  "summary": "cross-refactoring の状態管理 CLI。",
  "args": {
    "options": [],
    "positionals": [
      "id"
    ],
    "subcommands": {
      "assess": {
        "options": [
          "--base",
          "--max-lines"
        ],
        "positionals": []
      },
      "finalize": {
        "options": [
          "--review-status"
        ],
        "positionals": [
          "id"
        ]
      },
      "init": {
        "options": [
          "--baseline-test",
          "--budget-minutes",
          "--ci-check",
          "--code-metrics",
          "--exclude",
          "--host",
          "--implementer",
          "--include",
          "--model",
          "--plan-file",
          "--require-all",
          "--round-test",
          "--run",
          "--scope",
          "--severity-threshold",
          "--sync-command",
          "--test-kind",
          "--workflow-step",
          "--worktree-root"
        ],
        "positionals": [
          "pr"
        ]
      },
      "plan-comment": {
        "options": [
          "--scan-reverts"
        ],
        "positionals": [
          "id"
        ]
      },
      "reassign": {
        "options": [
          "--seats"
        ],
        "positionals": [
          "id",
          "phase"
        ]
      },
      "report": {
        "options": [
          "--metrics"
        ],
        "positionals": [
          "id"
        ]
      },
      "start-phase": {
        "options": [],
        "positionals": [
          "id",
          "phase"
        ]
      }
    }
  },
  "env": [
    "AI_GATEWAY_API_KEY",
    "CLAUDE_CONFIG_DIR",
    "CODEX_HOME",
    "CROSS_REFACTORING_TMP_DIR",
    "CROSS_REVIEW_TMP_DIR",
    "GH_TOKEN",
    "GITHUB_TOKEN",
    "MONITOR_NO_EARLY_ERROR",
    "NDF_ACCOUNTS_DIR",
    "NDF_ACCOUNT_TOKEN_URL",
    "NDF_ACCOUNT_USAGE_URL",
    "NDF_CLAUDE_ACCOUNT",
    "NDF_DEPS_REEXEC",
    "NDF_DEPS_VENV",
    "NDF_ESTIMATE_DIR",
    "NDF_MVV_STATE_DIR",
    "NDF_SHARED_CONFIG_DIR",
    "NDF_SKIP_AUTH_CHECK",
    "NDF_SUPERVISE_CLAUDE",
    "NDF_SUPERVISE_CLAUDE_FALLBACK",
    "NDF_SUPERVISE_LIMIT_SLEEP",
    "NDF_SUPERVISE_MODEL",
    "NDF_WHOLE_RUNS_DIR",
    "NDF_WORKTREE_BASE",
    "WT_DOCKER_COMMAND",
    "XDG_STATE_HOME"
  ],
  "settings": [
    {
      "file": "estimate.json",
      "keys": [
        "records_dir"
      ]
    },
    {
      "file": "project.json",
      "keys": [
        "ndf_policies",
        "test"
      ]
    },
    {
      "file": "worktree.json",
      "keys": [
        "base_branch",
        "tool_paths",
        "version"
      ]
    }
  ],
  "stdin": "none",
  "stdout": "none",
  "writes": [],
  "reads": [],
  "exit": {
    "0": "成功（status ok）",
    "2": "読めない・呼び出しの誤り（status stopped）"
  },
  "callers": [
    "plugins/ndf/scripts/lib/README.md",
    "plugins/ndf/scripts/lib/post_queue.py",
    "plugins/ndf/scripts/lib/statefile.py",
    "plugins/ndf/scripts/supervise_lib/paths.py",
    "plugins/ndf/scripts/supervise_lib/plan.py"
  ]
}
