{
  "version": 1,
  "path": "plugins/ndf/scripts/pr-steps.py",
  "summary": "pr-steps.py: pr の決まった手順（#858）。LLM に残るのはコミットメッセージ・PR 本文・同意の判断だけ。",
  "args": {
    "unparsed": "副命令を定数表・補助関数・繰り返しで作り、どの副命令の引数か静的に決められない"
  },
  "env": [
    "ANTHROPIC_API_KEY",
    "CLAUDE_CONFIG_DIR",
    "CODEX_HOME",
    "CROSS_REVIEW_TMP_DIR",
    "GH_TOKEN",
    "GITHUB_TOKEN",
    "HOME",
    "MONITOR_NO_EARLY_ERROR",
    "NDF_ACCOUNTS_DIR",
    "NDF_ACCOUNT_TOKEN_URL",
    "NDF_ACCOUNT_USAGE_URL",
    "NDF_API_KEY_CHECK_MODEL",
    "NDF_API_KEY_CHECK_URL",
    "NDF_CLAUDE_ACCOUNT",
    "NDF_CLAUDE_API_KEY_GENERATION",
    "NDF_CLAUDE_API_KEY_NAME",
    "NDF_CLAUDE_KEY_ACCOUNT",
    "NDF_DEPS_REEXEC",
    "NDF_DEPS_VENV",
    "NDF_ESTIMATE_DIR",
    "NDF_LOCK_DIR",
    "NDF_MVV_STATE_DIR",
    "NDF_ORGANIZER_DIR",
    "NDF_ORGANIZER_LANE",
    "NDF_PARALLEL_MAX_PLANS",
    "NDF_PRESENTATION_DIR",
    "NDF_RELAY_MAX_NAMED",
    "NDF_RELAY_NAME",
    "NDF_SHARED_CONFIG_DIR",
    "NDF_STATE_HOME",
    "NDF_SUPERVISE_CLAUDE",
    "NDF_SUPERVISE_CLAUDE_FALLBACK",
    "NDF_SUPERVISE_LIMIT_SLEEP",
    "NDF_SUPERVISE_MODEL",
    "NDF_SV_STATE_DIR",
    "NDF_VERSION",
    "NDF_WHOLE_RUNS_DIR",
    "UV_PROJECT_ENVIRONMENT",
    "XDG_STATE_HOME"
  ],
  "settings": [
    {
      "file": "estimate.json",
      "keys": [
        "records_dir"
      ]
    },
    {
      "file": "project.json",
      "keys": [
        "docs",
        "ndf_policies"
      ]
    },
    {
      "file": "supervise.json",
      "keys": [
        "release",
        "shared"
      ]
    },
    {
      "file": "worktree.json",
      "keys": [
        "base_branch",
        "tool_paths",
        "version"
      ]
    }
  ],
  "stdin": "none",
  "stdout": "step-result",
  "writes": [
    "answer-hold-json",
    "answer-hold-log-jsonl",
    "answer-hold-ran-json",
    "answer-json",
    "approved-txt",
    "breakdown-md",
    "checkpoint-json",
    "plan-json",
    "plan-md",
    "present-json",
    "presented-json",
    "prs-txt",
    "request-id-txt",
    "request-txt",
    "requests-json",
    "resume-mark-json"
  ],
  "reads": [],
  "exit": {
    "0": "成功（status ok）",
    "2": "読めない・呼び出しの誤り（status stopped）"
  },
  "callers": [
    "plugins/ndf/scripts/lib/README.md",
    "plugins/ndf/scripts/lib/closing.py",
    "plugins/ndf/scripts/lib/design_diff.py",
    "plugins/ndf/scripts/lib/repo.py",
    "plugins/ndf/scripts/pr_steps_lib/__init__.py"
  ]
}
