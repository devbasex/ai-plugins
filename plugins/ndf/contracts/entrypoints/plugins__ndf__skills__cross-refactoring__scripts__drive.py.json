{
  "version": 1,
  "path": "plugins/ndf/skills/cross-refactoring/scripts/drive.py",
  "summary": "drive.py: cross-refactoring の 1 回の改修計画実行を、LLM の判断が要る地点まで進めて止まる。",
  "args": {
    "options": [
      "--worktree-root"
    ],
    "positionals": [
      "pr"
    ]
  },
  "env": [
    "CLAUDE_CONFIG_DIR",
    "CODEX_HOME",
    "CROSS_REFACTORING_TMP_DIR",
    "CROSS_REVIEW_TMP_DIR",
    "GH_TOKEN",
    "GITHUB_TOKEN",
    "MONITOR_NO_EARLY_ERROR",
    "NDF_ACCOUNTS_DIR",
    "NDF_ACCOUNT_TOKEN_URL",
    "NDF_ACCOUNT_USAGE_URL",
    "NDF_CLAUDE_ACCOUNT",
    "NDF_DEPS_REEXEC",
    "NDF_DEPS_VENV",
    "NDF_ESTIMATE_DIR",
    "NDF_LOCK_DIR",
    "NDF_PRESENTATION_DIR",
    "NDF_SHARED_CONFIG_DIR",
    "NDF_STEP_EXTEND_FILE",
    "NDF_SUPERVISE_CLAUDE_FALLBACK",
    "NDF_WHOLE_RUNS_DIR",
    "NDF_WORKTREE_BASE",
    "WT_DOCKER_COMMAND",
    "XDG_STATE_HOME"
  ],
  "settings": [
    {
      "file": "estimate.json",
      "keys": [
        "records_dir"
      ]
    },
    {
      "file": "project.json",
      "keys": [
        "ndf_policies",
        "test"
      ]
    },
    {
      "file": "worktree.json",
      "keys": [
        "base_branch",
        "tool_paths",
        "version"
      ]
    }
  ],
  "stdin": "none",
  "stdout": "text",
  "writes": [],
  "reads": [],
  "exit": {
    "0": "成功（status ok）",
    "2": "読めない・呼び出しの誤り（status stopped）"
  },
  "callers": [
    "plugins/ndf/scripts/lib/README.md",
    "plugins/ndf/scripts/lib/bg-wait.sh",
    "plugins/ndf/scripts/lib/drive_pause.py",
    "plugins/ndf/scripts/lib/durable.py",
    "plugins/ndf/scripts/lib/loop_drive.py"
  ]
}
