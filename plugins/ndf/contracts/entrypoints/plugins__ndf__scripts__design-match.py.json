        "options": [
          "--base",
          "--max-lines"
        ],
        "positionals": []
      },
      "tests": {
        "options": [
          "--design",
          "--issue"
        ],
        "positionals": []
      }
    }
  },
  "env": [
    "NDF_DEPS_REEXEC",
