{
  "version": 1,
  "path": "plugins/ndf/scripts/mode-materials.py",
  "summary": "mode-materials.py: 課題の本文と設計文書から、モードの判定の材料を集める（#2923）。",
  "args": {
    "options": [
      "--issue",
      "--out",
      "--root"
    ],
    "positionals": []
  },
  "env": [
    "GH_TOKEN",
    "GITHUB_TOKEN",
    "NDF_DEPS_REEXEC",
    "NDF_DEPS_VENV",
    "NDF_PRESENTATION_DIR",
    "UV_PROJECT_ENVIRONMENT"
  ],
  "settings": [],
