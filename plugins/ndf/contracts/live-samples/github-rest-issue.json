{
  "summary": "GitHub の REST の課題 1 件（GET /repos/{owner}/{repo}/issues/{issue_number}）の応答の形。公開リポジトリの応答（2026-11-24 JST に録った、ラベルの無い完了した課題。ラベルの要素は記述と食い違うため、github-rest-issue-label の見本が受け持つ）のキーをそのまま残し、人と課題を特定する値（日時と件数を含む）は GitHub の文書の例の値へ置き換えた",
  "peer": "github",
  "sample": "tests/samples/github/rest/issue.json",
  "source": {
    "schema": "https://raw.githubusercontent.com/github/rest-api-description/main/descriptions-next/api.github.com/api.github.com.json",
    "pointer": "#/components/schemas/issue"
  },
  "absent_keys": [
    "body_html",
    "body_text",
    "closed_by/email",
    "closed_by/name",
    "closed_by/starred_at",
    "draft",
    "milestone/creator/email",
    "milestone/creator/name",
    "milestone/creator/starred_at",
    "parent_issue_url",
    "pull_request",
    "repository",
    "user/email",
    "user/name",
    "user/starred_at"
  ],
  "known_mismatches": []
}
