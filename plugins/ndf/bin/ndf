#!/usr/bin/env bash
# エントリポイント。uv.lock が固定する依存の仮想環境を用意し、`bin/start.py` で欠けを確かめてから `python -m ndf` を呼ぶ。
# 仮想環境はプラグインの外（`<キャッシュのホーム>/<プラグイン名>/venv/<バージョン>`）に置き、バージョンごとに分ける。
# プラグインの根はこのファイルの実体の位置から求め、子へ CLAUDE_PLUGIN_ROOT で渡す（ほかのプラグインの値を引き継がない）。
#
# 見つけ方: 呼ぶ側はパスを書かず、名前 `ndf` で呼ぶ。
# - Claude Code は、有効なプラグインの `bin/` を Bash の PATH へ足すので、`ndf` で見つかる
# - それ以外（Codex・端末）は、PATH の上に置いたこのファイルへのシンボリックリンクで呼ぶ。リンクをたどって
#   実体の位置から根を求めるので、リンクの保存先は問わない
#
# uv が無いとき: バージョンを固定した uv（UV_VERSION）を `<キャッシュのホーム>/<プラグイン名>/uv/<バージョン>` へ入れてから続ける。
# - 公式のインストーラを取り、埋めたハッシュ（UV_INSTALLER_SHA256）と検証してから実行する。インストーラは
#   各アーカイブのハッシュを持ち、展開の前に検証するので、ここでインストーラを固定すると導入物まで固定される
# - 取得と導入は呼ぶごとの一時ディレクトリで行い、できた uv を名前の変更（mv）で置く。同時に起動しても
#   互いのインストーラを上書き・削除しない
# 入れられない（curl が無い・ネットワークが無い・ハッシュが違うなど）ときは、理由を結果 JSON（stopped・deps_missing）で出し、
# 終了コードの表（contracts/facts/exit-codes.json）の deps_missing の終了コードで止まる。
#
# 呼び出し元の CLAUDE_PLUGIN_ROOT は、子へ自分の根を渡す前に NDF_CALLER_PLUGIN_ROOT へ写す（無ければ空）。
# ほかに NDF と uv run が入れる UV_PROJECT_ENVIRONMENT・VIRTUAL_ENV・UV_RUN_RECURSION_DEPTH・PATH・PYTHONPATH は、
# 呼び出し元の値を NDF_CALLER_<名前> へ写す（あれば空でも写し、無ければ写しを消す。外側の ndf の写しを残さない）。
# start.py は `python -m ndf` の前に、写しから呼び出し元の値へ戻す。NDF の子孫が利用先で打つ uv run が NDF の venv を
# 書き換えない（#4029）。子が `ndf` を打てば、このファイルが毎回 NDF の venv を指し直す。
set -euo pipefail

UV_VERSION="0.13.7"
# https://github.com/astral-sh/uv/releases/download/0.13.7/uv-installer.sh の sha256（astral.sh の配信と同じ中身）
UV_INSTALLER_SHA256="d263ee68314cf5bea36b08e6bd9e2c4563240d7adb73756cf33af5c199b92db4"

# このファイルの実体のパス（シンボリックリンクをたどる。bash 3.2 と macOS の readlink で動く形）
self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  dir="$(cd -P "$(dirname "$self")" && pwd)"
  self="$(readlink "$self")"
  case "$self" in /*) ;; *) self="$dir/$self" ;; esac
done
root="$(cd -P "$(dirname "$self")/.." && pwd)"
manifest="$root/.claude-plugin/plugin.json"
if ! meta="$(python3 -c 'import json, sys; d = json.load(open(sys.argv[1])); print(d["name"]); print(d["version"])' "$manifest" 2>&1)"; then
  printf '%s\n' "plugin.json を読めない: $manifest: $meta" >&2
  exit 2
fi
{ read -r name; read -r version; } <<<"$meta"
cache_home="${XDG_CACHE_HOME:-$HOME/.cache}/$name"

# 依存の欠けを結果 JSON 1 行で出して止まる（Python の ndf を起動できないので、標準ライブラリだけで読める start.py の
# emit_deps_missing で組む）。終了コードは終了コードの表の deps_missing の行から引き、python3 の終了コードをそのまま返す
stop_deps_missing() {
  local code=0
  # -I: 呼び出し元のディレクトリ・PYTHONPATH・利用者の site を import の探索先に入れない（利用先の csv.py・json.py を読まない）。
  # 結果 JSON は標準ライブラリだけで組むので、探索先にはプラグインの bin だけを足す
  python3 -I -c '
import sys
sys.dont_write_bytecode = True
sys.path.insert(0, sys.argv[1])
import start
sys.exit(start.emit_deps_missing(sys.argv[2]))
' "$root/bin" "$1" || code=$?
  exit "$code"
}

uv_bin="$(command -v uv || true)"
if [ -z "$uv_bin" ]; then
  uv_dir="$cache_home/uv/$UV_VERSION"
  uv_bin="$uv_dir/uv"
  if [ ! -x "$uv_bin" ]; then
    if ! command -v curl >/dev/null 2>&1; then
      stop_deps_missing "uv が無く、入れるための curl も無い（https://docs.astral.sh/uv/ から uv $UV_VERSION を入れる）"
    fi
    mkdir -p "$cache_home/uv"
    work="$(mktemp -d "$cache_home/uv/.install.XXXXXX")"
    installer="$work/install.sh"
    if ! log="$(curl -LsSf "https://astral.sh/uv/$UV_VERSION/install.sh" -o "$installer" 2>&1)" \
      || ! log="$(python3 -c '
import hashlib, sys
path, want = sys.argv[1], sys.argv[2]
with open(path, "rb") as f:
    got = hashlib.sha256(f.read()).hexdigest()
if got != want:
    sys.exit(f"インストーラのハッシュが違う（{got}）")
' "$installer" "$UV_INSTALLER_SHA256" 2>&1)" \
      || ! log="$(env UV_UNMANAGED_INSTALL="$work/bin" sh "$installer" 2>&1)" || [ ! -x "$work/bin/uv" ] \
      || ! log="$(mkdir -p "$uv_dir" && mv -f "$work/bin/uv" "$uv_bin" 2>&1)"; then
      rm -rf "$work"
      stop_deps_missing "uv が無く、uv $UV_VERSION を $uv_dir へ入れられない（ネットワークを確かめる）: $(printf '%s' "$log" | tail -n 1)"
    fi
    rm -rf "$work"
  fi
fi

export NDF_CALLER_PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-}"
for held in UV_PROJECT_ENVIRONMENT VIRTUAL_ENV UV_RUN_RECURSION_DEPTH PATH PYTHONPATH; do
  if [ -n "${!held+set}" ]; then export "NDF_CALLER_$held=${!held}"; else unset "NDF_CALLER_$held"; fi
done
export CLAUDE_PLUGIN_ROOT="$root"
export UV_PROJECT_ENVIRONMENT="$cache_home/venv/$version"
export PYTHONPATH="$root/src${PYTHONPATH:+:$PYTHONPATH}"
# uv が真と読む値か（UV_NO_SYNC・UV_NO_ENV_FILE を uv と同じに読む）。大文字小文字を問わない比べ方をシェルの組み込みだけで書く
# （外部コマンドを起動しない。bash 3.2 に ${var,,} は無い）
truthy() {
  case "${1:-}" in
    1 | [Tt] | [Yy] | [Tt][Rr][Uu][Ee] | [Yy][Ee][Ss] | [Oo][Nn]) return 0 ;;
    *) return 1 ;;
  esac
}
# 依存の同期は exec の前に 1 回だけ行う。取れない（ネットワークが無い・相手の障害）ときは、uv の出力のままにせず
# 結果 JSON（stopped・deps_missing）で止まる（#3687）。lock は更新しない（--frozen。定義と lock の食い違いは CI の uv lock --check が落とす）。
# 理由には uv の `error:` の行を載せる（最終行は `hint:` のことがある）。`error:` の行が無ければ最終行を載せる。
# 呼び出し元が UV_NO_SYNC で同期を止めていれば、uv run と同じに環境を書き換えない（uv sync はこの変数を受けない）。
# ただし環境が lock どおりかは `uv sync --check` で確かめ、違えば同じく結果 JSON で止まる。確かめはネットワークにも出ず
# Python も取りに行かない（--offline・--no-python-downloads。合う Python が無ければ取って入れる前に止まる）。
# --inexact: uv run と同じに、lock に無い追加のパッケージを消さず、欠けと食い違いだけを見る（uv sync の既定は消す）
venv="$UV_PROJECT_ENVIRONMENT"
if truthy "${UV_NO_SYNC:-}"; then
  if ! log="$("$uv_bin" sync --frozen --no-dev --inexact --check --offline --no-python-downloads --quiet --project "$root" 2>&1)"; then
    stop_deps_missing "UV_NO_SYNC で同期を止めているが、依存の環境 $venv が lock どおりでない（UV_NO_SYNC を外して ndf を打つ）: $(printf '%s\n' "$log" | grep -m 1 '^error:' || printf '%s' "$log" | tail -n 1)"
  fi
elif ! log="$("$uv_bin" sync --frozen --no-dev --inexact --quiet --project "$root" 2>&1)"; then
  stop_deps_missing "依存を用意できない（ネットワークを確かめる）: $(printf '%s\n' "$log" | grep -m 1 '^error:' || printf '%s' "$log" | tail -n 1)"
fi
# -P: 呼び出し元のディレクトリとこのディレクトリを import の探索先に入れない（利用先の ndf.py・json.py を読まない）。
# start.py は依存の環境の欠けを確かめてから `python -m ndf` と同じに呼ぶ（欠けていれば入れ直しの手順で止まる。#2447）。
# UV_ENV_FILE で環境ファイルを指していれば（UV_NO_ENV_FILE で止めていなければ）、読み込みを uv に任せて uv run で渡す。
# 環境ファイルの書式と上書きの順を自前で作り直さない（この経路だけ uv の起動が 2 回になる。uv は dotenvy で読み、無いファイルを
# 誤りにし、読めない行を警告して飛ばす。Python で読み直すとこの振る舞いが食い違い、認証情報が渡らない形が起きうる）
if [ -n "${UV_ENV_FILE:-}" ] && ! truthy "${UV_NO_ENV_FILE:-}"; then
  exec "$uv_bin" run --no-sync --no-dev --quiet --project "$root" python -P "$root/bin/start.py" "$@"
fi
# それ以外は同期した環境の Python を直に呼ぶ（uv run を挟むと uv の起動が 1 回増える）。uv run が入れる VIRTUAL_ENV と
# PATH の先頭の環境の bin はここで入れる（呼び出し元の値は上で NDF_CALLER_<名前> へ写してあり、start.py が戻す）
export VIRTUAL_ENV="$venv"
export PATH="$venv/bin${PATH:+:$PATH}"
exec "$venv/bin/python" -P "$root/bin/start.py" "$@"
