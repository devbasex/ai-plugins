{
  "version": 1,
  "smells": {
    "S110": {"kind": 4, "suppress": "boundary", "by": "ruff", "summary": "except の本体が pass だけ"},
    "S112": {"kind": 4, "suppress": "boundary", "by": "ruff", "summary": "except の本体が continue だけ"},
    "BLE001": {"kind": 4, "suppress": "boundary", "by": "ruff", "summary": "Exception・BaseException を受けて送出し直さない"},
    "E722": {"kind": 4, "suppress": "boundary", "by": "ruff", "summary": "素の except"},
    "NDF201": {
      "kind": 2,
      "suppress": "boundary-or-limit",
      "summary": "ループの中の外部呼び出し",
      "params": {
        "calls": ["run", "check_output", "check_call", "Popen", "urlopen"],
        "modules": ["subprocess", "httpx", "urllib", "github", "git", "ci", "llm", "notify"]
      }
    },
    "NDF301": {"kind": 3, "suppress": "none", "summary": "elif の長い連鎖", "params": {"min_elif": 4}},
    "PLR0912": {"kind": 3, "suppress": "none", "by": "ruff", "summary": "分岐の多い関数"},
    "PLR1702": {"kind": 3, "suppress": "none", "by": "ruff", "summary": "深い入れ子"},
    "NDF401": {"kind": 4, "suppress": "boundary", "summary": "定数を返して黙る except"},
    "NDF402": {"kind": 4, "suppress": "boundary", "summary": "contextlib.suppress"},
    "NDF501": {"kind": 5, "suppress": "boundary", "summary": "空の既定への落とし（`x or 空` と `x if x else 空`）"},
    "NDF502": {
      "kind": 5,
      "suppress": "boundary",
      "summary": "既定値つきの .get(k, 既定)",
      "params": {"boundary_receivers": ["os.environ"]}
    },
    "NDF701": {"kind": 7, "suppress": "none", "summary": "長い関数", "params": {"max_lines": 60}},
    "PLR0913": {"kind": 7, "suppress": "none", "by": "ruff", "summary": "引数の多い関数"}
  },
  "ruff": {
    "preview": true,
    "config": {
      "lint.flake8-bandit.check-typed-exception": true,
      "lint.pylint.max-branches": 9,
      "lint.pylint.max-nested-blocks": 3,
      "lint.pylint.max-args": 6
    }
  },
  "boundaries": ["外部コマンド", "ネットワーク", "利用者の入力", "ファイル"],
  "limit_label": "上限",
  "exception_types": {
    "boundary": [
      "OSError", "FileNotFoundError", "PermissionError", "SubprocessError", "CalledProcessError",
      "TimeoutExpired", "JSONDecodeError", "UnicodeDecodeError", "URLError", "HTTPError"
    ],
    "internal": ["TypeError", "AttributeError", "KeyError", "IndexError", "NameError", "AssertionError"]
  },
  "structure": {
    "max_lines": 1000,
    "layers": ["ndf.contracts", "ndf.adapters", "ndf.core", "ndf.progress", "ndf.domains"],
    "durable_module": "ndf.core.durable",
    "durable_imports": ["dbos"],
    "decide_suffix": "_decide",
    "decide_forbidden_imports": [
      "dbos", "subprocess", "shutil", "tempfile", "os", "time", "random", "socket", "urllib", "http", "httpx",
      "ndf.core.durable", "ndf.adapters"
    ],
    "decide_forbidden_calls": [
      "open", "read_text", "write_text", "read_bytes", "write_bytes", "glob", "rglob", "iterdir", "exists",
      "is_file", "is_dir", "mkdir", "unlink", "resolve", "stat"
    ]
  },
  "facts": {
    "min_str": 4,
    "contracts_dir": "contracts"
  },
  "words": {
    "glossary_config": "glossary.json",
    "skip_files": ["uv.lock"],
    "examples": {
      "tests/domains/hooks/fixtures/wait-corpus.json": {
        "words": ["その場で直す", "ミッション", "上限の中断", "主ディレクトリ", "作業ツリー", "依頼", "元からの失敗", "共通層", "副命令", "区間", "印", "取り込ま", "取り込み", "取り込む", "取り込ん", "台帳", "告知", "問い", "契約", "実装レビュー", "宣言", "導入確認", "差し戻し", "後片付け", "戻り先", "手入れ", "控え", "提示物", "改修計画", "文脈量", "枠", "構造改善", "正本", "段", "照合", "版", "答え", "節", "置き場", "起こさ", "起こし", "越えない線", "途中の通知", "進行の記録", "進行側", "鍵", "閉じる語", "雛形", "骨組み"],
        "reason": "10 系（ndf--v10.27.77）から移した待ちの判定の例の組（#4000）。利用者の入力の直前に終わった実際の応答の本文を持つ（認証情報の保管先・ファイル名・変数名だけを架空の値に置き換えた）ので、語を言い換えると判定の入力が変わる"
      },
      "src/ndf/domains/hooks/reply_wait.py": {
        "words": ["答え"],
        "reason": "10 系から移した待ちの判定（#4000）が本文の中に当てる語の列。応答を書く側が使う語なので言い換えない"
      },
      "skills/document-style/SKILL.md": {
        "words": ["入口", "雛形", "台帳", "版", "枠", "印", "段", "置き場", "宣言", "副命令", "土台"],
        "reason": "避ける語の表と、避ける語を探す grep の例が、言い換える前の語として挙げる（ルール 11 の直訳の語の例を含む）"
