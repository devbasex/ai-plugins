      "skills/document-drafting/SKILL.md": {
        "words": ["版", "配布"],
        "reason": "「語の選び方」の避ける語の表が、言い換える前の語として挙げる"
      },
      "skills/pr-review/SKILL.md": {
        "words": ["実装レビュー"],
        "reason": "旧 projects-sync.sh（M7）が受ける工程名。入れ替えまでは呼び先の工程表の名前を渡す"
      },
      "skills/refactoring/SKILL.md": {
        "words": ["構造改善"],
        "reason": "旧 projects-sync.sh（M7）が受ける工程名。入れ替えまでは呼び先の工程表の名前を渡す"
      },
      "skills/development-workflow/references/projects-tracking.md": {
        "words": ["実装レビュー"],
        "reason": "旧 projects-sync.sh（M7）が受ける工程名。入れ替えまでは呼び先の工程表の名前を渡す"
      },
      "skills/merged/SKILL.md": {
        "words": ["後片付け"],
        "reason": "旧 projects-sync.sh（M7）が受ける工程名。入れ替えまでは呼び先の工程表の名前を渡す"
      },
      "skills/development-workflow/references/workflow-modes.md": {
        "words": ["構造改善"],
        "reason": "旧 projects-sync.sh（M7）が受ける工程名。入れ替えまでは呼び先の工程表の名前を渡す"
      },
      "contracts/hooks/unattended-report.json": {
        "words": ["区間", "契約", "節", "答え", "版"],
        "reason": "Factory のランナーが読むコントラクトの写しで、見出し（## 区間の報告）・項目名・値の説明を外部のランナーと写し元（今の NDF の forms/unattended-report.json）と同じ文字列に保つ"
      },
      "src/ndf/domains/hooks/report.py": {
        "words": ["区間", "節"],
        "reason": "外部のランナーと同じ文字列に保つ見出し（## 区間の報告。contracts/hooks/unattended-report.json）を名前で指し、cases の誤りの文（「の節が無い」）をそのままの文字列で出す"
      },
      "src/ndf/domains/hooks/guards/unattended.py": {
        "words": ["区間"],
        "reason": "外部のランナーと同じ文字列に保つ見出し（## 区間の報告。contracts/hooks/unattended-report.json）を名前で指す"
      },
      "src/ndf/domains/hooks/report_text.py": {
        "words": ["区間"],
        "reason": "外部のランナーと同じ文字列に保つ見出し（## 区間の報告。contracts/hooks/unattended-report.json）を名前で指す"
      },
      "tests/domains/hooks/test_unattended.py": {
        "words": ["区間"],
        "reason": "外部のランナーと同じ文字列に保つ見出し（## 区間の報告。contracts/hooks/unattended-report.json）を応答の例に書く"
      },
      "tests/checks/test_words.py": {
        "words": ["副命令", "版", "問い"],
        "reason": "禁止語の規則のテストが、廃止した語を書いた入力として挙げる"
      },
      "docs/field-test-records.md": {
        "words": ["台帳", "依頼"],
        "reason": "入れ替え（#3304）で 10 系から移した実地の検証の記録で、書いた時点の文のまま残す"
      },
      "src/ndf/checks/rules.json": {
        "words": ["入口", "雛形", "台帳", "実装レビュー", "構造改善", "後片付け", "区間", "契約", "節", "問い", "答え", "版", "副命令", "依頼", "枠", "印", "段", "置き場", "宣言", "土台", "配布", "その場で直す", "ミッション", "上限の中断", "主ディレクトリ", "作業ツリー", "元からの失敗", "共通層", "取り込ま", "取り込み", "取り込む", "取り込ん", "告知", "導入確認", "差し戻し", "戻り先", "手入れ", "控え", "提示物", "改修計画", "文脈量", "正本", "照合", "起こさ", "起こし", "越えない線", "途中の通知", "進行の記録", "進行側", "鍵", "閉じる語", "骨組み", "行き先"],
        "reason": "この除外のデータそのものが、外す語を持つ。設計レビューの項目の表と 11.x の対応表の見出しも、文書と同じ文字列に保つ"
      }
    }
  },
  "limits": {
    "readers": {
      "ndf.contracts.limits.policy": {"arg": "name", "index": 0},
      "ndf.contracts.limits.value": {"arg": "name", "index": 0},
      "ndf.contracts.limits.seconds": {"arg": "name", "index": 0},
      "ndf.contracts.limits.scaled": {"arg": "name", "index": 0},
      "ndf.contracts.limits.from_env": {"arg": "policy_name", "index": 2},
      "ndf.domains.hooks.tables.policy_value": {"arg": "name", "index": 0},
      "ndf.domains.hooks.tables.policy_row": {"arg": "name", "index": 0},
      "ndf.adapters.github._batches": {"arg": "batch", "index": 1},
      "ndf.adapters.github.GitHub.aliased": {"arg": "batch", "index": 1},
      "ndf.adapters.github.GitHub.nodes": {"arg": "batch", "index": 3},
      "ndf.adapters.github._page_cap": {"arg": "name", "index": 0},
      "ndf.adapters.github._Counted": {"arg": "cap", "index": 2},
      "ndf.adapters.training.Endpoint": {"arg": "policy", "index": 1},
      "ndf.adapters.write_gate._window": {"arg": "name", "index": 0},
      "ndf.domains.gws.call": {"arg": "limit_name", "index": 1},
      "ndf.domains.records.gws.auth_status": {"arg": "limit", "index": 0},
      "ndf.domains.relay.context_thresholds.thresholds.value": {"arg": "name", "index": 0},
      "ndf.process_group._grace": {"arg": "grace_key", "index": 0},
      "ndf.process_group.stop_group": {"arg": "grace_key", "index": 1},
      "ndf.process_group.stop_detached_group": {"arg": "grace_key", "index": 1},
      "ndf.slot_pool.weight_mib": {"arg": "kind", "index": 0, "template": "launch.weight.{}"}
    },
    "tables": ["ndf.contracts.limits.table", "ndf.contracts.limits.NDF_SETTINGS", "ndf.domains.hooks.tables.policies"],
    "whole": [
      {"module": "ndf.checks.limits_readers", "reason": "この規則そのもの。方針の読み手の指定だけを読む"},
      {"module": "ndf.contracts.cli", "reason": "事実の表が指す方針の名前の有無だけを確かめる"}
    ],
    "dynamic": [
      {"at": "ndf.adapters.agents.stall_seconds", "expr": "f\"monitor.stall.{agent}\"", "template": "monitor.stall.{}", "vocabulary": "domains/runtimes.json#/rows/*/id", "reason": "担当の CLI ごとの無進捗の許容を、担当の名前から引く"},
      {"at": "ndf.contracts.causes._policy_errors", "expr": "row.retry", "template": "{}", "vocabulary": "causes.json#/causes/*/retry", "reason": "停止理由の表の行が指す再試行の方針を引く"},
      {"at": "ndf.contracts.causes.policy_of", "expr": "row(kind).retry", "template": "{}", "vocabulary": "causes.json#/causes/*/retry", "reason": "停止理由の表の行が指す再試行の方針を引く"},
      {"at": "ndf.domains.crossrefactor.launch.phase_limit", "expr": "f\"monitor.phase.{phase}\"", "template": "monitor.phase.{}", "vocabulary": "domains/loop-phases.json#/rows/*/id", "reason": "工程の監視の上限を、工程の名前から引く"},
      {"at": "ndf.domains.hooks.budget.budget_for", "expr": "f\"hook.budget.{spec['budget']}\"", "template": "hook.budget.{}", "vocabulary": "hooks/runtimes.json#/runtimes/*/events/*/budget", "reason": "事象の予算を、ランタイムのコントラクト表の予算のキーから引く"},
      {"at": "ndf.domains.hooks.budget.budget_for", "expr": "f\"hook.budget.{spec['budget']}.{runtime}\"", "template": "hook.budget.{}.{1}", "vocabulary": "hooks/runtimes.json#/runtimes/*/events/*/budget", "reason": "ランタイムで違う事象の予算を、予算のキーとランタイムの名前から引く"},
      {"at": "ndf.domains.hooks.budget._pair_errors", "expr": "guard['limits']", "template": "{}", "vocabulary": "hooks/guards.json#/guards/*/limits/*", "reason": "guard の部品の上限を予算と比べる"}
    ]
  },
  "child_deps": {
    "max_per_slot": 2
  },
  "spec": {
    "rules": ["spec-docs", "spec-decl", "spec-io", "spec-skill", "spec-public", "review-items"],
    "generated": ["docs/contracts/*.md", "contracts/schemas/io/*.args.schema.json"],
    "review_items_source": "issues/issue-1142-design-review-routing.md",
    "review_items_columns": {"id": "項目", "text": "要旨", "routed_to": "行き先の子", "order": "順番", "kind": "新設か追補か", "requirement_line": "要求の行", "release": "版"},
    "correspondence_columns": {"id": "行", "routed_to": "11.x の行き先"}
  }
}
