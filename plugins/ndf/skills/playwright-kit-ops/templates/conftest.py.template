def pytest_collection_modifyitems(session, config, items):
    if not items:
        import warnings

        warnings.warn(
            "[pwk] tests/ にテストスクリプトが見つかりません。"
            "テストスクリプトを作成してから実行してください。",
            stacklevel=1,
        )
