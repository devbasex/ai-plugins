{
  "$defs": {
    "RepresentativeRepos": {
      "additionalProperties": false,
      "properties": {
        "kinds": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Kinds",
          "type": "array"
        },
        "paths": {
          "anyOf": [
            {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paths"
        },
        "redline": {
          "pattern": "^[CPR][1-9][0-9]*$",
          "title": "Redline",
          "type": "string"
        }
      },
      "required": [
        "kinds",
        "redline"
      ],
      "title": "RepresentativeRepos",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1,
      "title": "Version",
      "type": "integer"
    },
    "representative_repos": {
      "anyOf": [
        {
          "$ref": "#/$defs/RepresentativeRepos"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "version"
  ],
  "title": "NDF の代表のリポジトリの設定（.ndf/design.json）",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
