FROM ai-plugins-runtime-smoke-base

# 版・取得先・checksum は tests/runtime-smoke/cli-versions.env に書き、scripts/runtime-smoke-test.sh が
# build-arg で渡す。ARG に既定値を持たせない（版の出所を一覧の 1 つにする）。
# 公式のインストーラは最新の manifest だけを読むため使わず、manifest に載る版つきの url を取り、
# 一覧の sha512 で確かめて入れる。取得・checksum・版の照合のどれかが落ちたら像の作成を落とす。
ARG AGY_VERSION
ARG AGY_URL_X86_64
ARG AGY_URL_AARCH64
ARG AGY_SHA512_X86_64
ARG AGY_SHA512_AARCH64

RUN set -eu; \
  test -n "$AGY_VERSION"; \
  arch="$(uname -m)"; \
  case "$arch" in \
    x86_64) url="$AGY_URL_X86_64"; sha512="$AGY_SHA512_X86_64" ;; \
    aarch64) url="$AGY_URL_AARCH64"; sha512="$AGY_SHA512_AARCH64" ;; \
    *) echo "対応していない arch: $arch" >&2; exit 1 ;; \
  esac; \
  test -n "$url"; \
  test -n "$sha512"; \
  work="$(mktemp -d)"; \
  curl -fsSL -o "$work/agy.tar.gz" "$url"; \
  echo "$sha512  $work/agy.tar.gz" | sha512sum -c -; \
  tar -xzf "$work/agy.tar.gz" -C "$work" antigravity; \
  install -m 755 "$work/antigravity" /usr/local/bin/agy; \
  rm -rf "$work"; \
  actual="$(agy --version | grep -oE '[0-9]+(\.[0-9]+)+' | head -n 1)"; \
  [ "$actual" = "$AGY_VERSION" ] || { echo "agy の版が一覧と違う: $actual != $AGY_VERSION" >&2; exit 1; }
