# CLI の版の一覧: スモークの像へ入れる 4 ランタイムの CLI の版数・取得先・checksum。
# 版を上げるときに書き換える唯一の場所。手順は tests/runtime-smoke/README.md の「版を上げる」。
# 1 行 1 つの KEY=VALUE。値は引用符で囲まない。キーは Containerfile の ARG の名前と同じ。
# arch の名前は `uname -m` の値（x86_64 / aarch64）に揃える。

# claude: npm の @anthropic-ai/claude-code の版数
CLAUDE_CODE_VERSION=2.1.296

# codex: npm の @openai/codex の版数
CODEX_VERSION=0.162.1

# kiro: 版数と kirocli-<arch>-linux-musl.tar.gz の sha256
KIRO_CLI_VERSION=2.31.0
KIRO_CLI_SHA256_X86_64=3d0782f274f4180f4f5759ebb780fd46e8b9927261e5774dae1fd486f195cf5e
KIRO_CLI_SHA256_AARCH64=d309b7ce5368cbd01eeb9fc40f18da05ba3d4b39b2ce5457a7731eec9ea3de3c

# agy: 版数と manifest の url・sha512
AGY_VERSION=1.3.4
AGY_URL_X86_64=https://storage.googleapis.com/antigravity-public/antigravity-cli/1.3.4-5524158944247808/linux-x64/cli_linux_x64.tar.gz
AGY_URL_AARCH64=https://storage.googleapis.com/antigravity-public/antigravity-cli/1.3.4-5524158944247808/linux-arm/cli_linux_arm64.tar.gz
AGY_SHA512_X86_64=dbdacfc5a1d9874fbbea3a21026d3990b4728e2e3487fd0316dc53cae9a3091023f969425828f3e2e0fadda43cea07dd978ea96f4ca7c202adf2201f419c56dd
AGY_SHA512_AARCH64=24a1d463319701f4943b2d4932cb86ca34d60d2e9fedcd9018ca31809773d719f272512068911632db175d7233088551033bcecc0a2a56b1bcfa041269687eaf
