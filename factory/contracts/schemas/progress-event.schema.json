{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/devbasex/ai-plugins/blob/develop/factory/contracts/schemas/progress-event.schema.json",
  "title": "ProgressEvent",
  "description": "進捗の事象 1 件。確定仕様 docs/specifications/ndf-factory-service-boundary.md の「進捗の正本」と「進捗の事象の種類と受け口」。order_key と pr_ref は受け口が作るため含めない",
  "oneOf": [
    { "$ref": "#/$defs/JobStartedEvent" },
    { "$ref": "#/$defs/PhaseChangedEvent" },
    { "$ref": "#/$defs/StepRecordedEvent" },
    { "$ref": "#/$defs/AttentionEvent" },
    { "$ref": "#/$defs/GateReachedEvent" },
    { "$ref": "#/$defs/GateAnsweredEvent" },
    { "$ref": "#/$defs/UsageRecordedEvent" },
    { "$ref": "#/$defs/JobFinishedEvent" },
    { "$ref": "#/$defs/PrUpdatedEvent" },
    { "$ref": "#/$defs/CiUpdatedEvent" },
    { "$ref": "#/$defs/DecisionDelegatedEvent" },
    { "$ref": "#/$defs/IssueRequestedEvent" },
    { "$ref": "#/$defs/IssueRequestResolvedEvent" },
    { "$ref": "#/$defs/SectionStartedEvent" },
    { "$ref": "#/$defs/LoopLapClosedEvent" },
    { "$ref": "#/$defs/LoopStoppedEvent" },
    { "$ref": "#/$defs/ReleaseRequestedEvent" },
    { "$ref": "#/$defs/ReleasePresentedEvent" },
    { "$ref": "#/$defs/ReleaseProgressEvent" },
    { "$ref": "#/$defs/ReleaseSettledEvent" },
    { "$ref": "#/$defs/ReleaseAnsweredEvent" }
  ],
  "$defs": {
    "Identifier": {
      "description": "スプリントの実行・実行ジョブの識別子。order_key の区切りの # と冪等の鍵の区切りの : を含めない",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "RepoFullName": {
      "description": "GitHub のリポジトリ（owner/name）",
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "PullRequestNumber": {
      "type": "integer",
      "minimum": 1
    },
    "GateKind": {
      "description": "設計承認ゲート・リリース承認ゲート・判断",
      "type": "string",
      "enum": ["gate1", "gate2", "decision"]
    },
    "EventSource": {
      "type": "string",
      "enum": ["runner", "github", "api", "control"]
    },
    "EventCommon": {
      "description": "どの種類にも共通の列",
      "type": "object",
      "required": ["sprint_run_id", "idempotency_key", "type", "at", "source", "job_id", "schema_version", "payload"],
      "properties": {
        "sprint_run_id": { "$ref": "#/$defs/Identifier" },
        "idempotency_key": {
          "description": "重複の判定の鍵。出所ごとの形は受け口の照合が見る",
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "type": { "type": "string" },
        "at": {
          "description": "事象が起きた時刻（ISO 8601、UTC）。送り直しでも変えない",
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "source": { "$ref": "#/$defs/EventSource" },
        "job_id": {
          "description": "null は実行ジョブの外で起きた事象（github・api）",
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "schema_version": { "type": "integer", "const": 1 },
        "payload": { "type": "object" }
      }
    },
    "JobStartedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ndf_version", "start"],
      "properties": {
        "ndf_version": { "type": "string", "minLength": 1 },
        "start": { "type": "string", "enum": ["new", "resume", "loop", "release"] }
      }
    },
    "PhaseChangedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "issues"],
      "properties": {
        "phase": { "description": "フェーズの名前。5 つの名前（設計・実装・検査・取り込み・仕上げ）は src/phases.ts が持ち、ここでは列挙で縛らない", "type": "string", "minLength": 1 },
        "issues": { "type": "array", "items": { "type": "integer", "minimum": 1 } }
      }
    },
    "PullRequestRef": {
      "description": "このステップが作った・更新した Pull Request",
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "number"],
      "properties": {
        "repo": { "$ref": "#/$defs/RepoFullName" },
        "number": { "$ref": "#/$defs/PullRequestNumber" }
      }
    },
    "StepRecordedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "exit_code", "seconds", "summary"],
      "properties": {
        "step": { "type": "string", "minLength": 1 },
        "exit_code": { "type": "integer" },
        "seconds": { "type": "number", "minimum": 0 },
        "summary": { "type": "string" },
        "pull_request": { "$ref": "#/$defs/PullRequestRef" },
        "phase": {
          "description": "その工程が属するフェーズの名前。省いたときは同じ実行ジョブの直前の phase.changed から導く",
          "type": "string",
          "minLength": 1
        },
        "issues": {
          "description": "その工程が受け持つ課題。省いたときも空のときもスプリント全体の工程",
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "maxItems": 50
        },
        "files": {
          "description": "その工程の時間の窓のコミットが触ったファイル。省いたときは記録なし、空の配列は触らなかった",
          "type": "array",
          "items": { "$ref": "#/$defs/StepFile" },
          "maxItems": 100
        },
        "files_omitted": { "description": "上限で files から外した数", "type": "integer", "minimum": 0 },
        "commit_range": { "$ref": "#/$defs/CommitRange" },
        "decisions": {
          "description": "その工程の間に決めたこと。省いたときは記録なし、空の配列は決めたことが無かった",
          "type": "array",
          "items": { "$ref": "#/$defs/StepDecision" },
          "maxItems": 20
        },
        "output": { "$ref": "#/$defs/StepOutput" }
      }
    },
    "StepFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "added", "deleted"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 512 },
        "added": { "description": "null はバイナリ（行数が無い）", "type": ["integer", "null"], "minimum": 0 },
        "deleted": { "description": "null はバイナリ（行数が無い）", "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "CommitRange": {
      "description": "時間の窓のコミットの最初の親と最後のコミット",
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "to": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "StepDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "answer", "by"],
      "properties": {
        "question": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "answer": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "by": { "type": "string", "enum": ["ai", "user"] }
      }
    },
    "StepOutput": {
      "description": "作業の報告（report）かログ（log）。text は UTF-8 で 32,768 バイト以下で、truncated は上限で切ったこと",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text", "truncated"],
      "properties": {
        "kind": { "type": "string", "enum": ["report", "log"] },
        "text": { "type": "string", "maxLength": 32768 },
        "truncated": { "type": "boolean" }
      }
    },
    "AttentionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "summary"],
      "properties": {
        "reason": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" }
      }
    },
    "GateReachedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "pr_url", "material"],
      "properties": {
        "kind": { "$ref": "#/$defs/GateKind" },
        "pr_url": { "type": ["string", "null"], "format": "uri" },
        "material": { "description": "承認資料の本文", "type": "string" },
        "loop": { "$ref": "#/$defs/LoopRef" },
        "choices": {
          "description": "答えの選択肢の制限。リリースの実行が main へのマージの後に判断で止まったときは continue だけを載せる（#2439 の I63）",
          "type": "array",
          "items": { "type": "string", "enum": ["continue", "reject"] },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "LoopRef": {
      "description": "開発ループの実行のとき、ループの名前と周回の番号（#2347）",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "lap"],
      "properties": {
        "name": { "$ref": "#/$defs/LoopName" },
        "lap": { "type": "integer", "minimum": 1 }
      }
    },
    "LoopName": {
      "description": "NDF の開発ループの名前",
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z_-]{0,63}$"
    },
    "LoopPending": {
      "description": "人の判断待ちの課題（設計承認ゲートで MVV 判定が「従う」以外）",
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "reason", "lap"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "reason": { "type": "string", "maxLength": 4000 },
        "lap": { "type": "integer", "minimum": 1 }
      }
    },
    "SectionStartedPayload": {
      "description": "1 つの実行ジョブの中でランナーが claude -p を起動した（区間。#2347）",
      "type": "object",
      "additionalProperties": false,
      "required": ["section", "command"],
      "properties": {
        "section": { "description": "1 から数える", "type": "integer", "minimum": 1 },
        "command": { "description": "起動の指示。2,000 字で切る", "type": "string", "maxLength": 2000 }
      }
    },
    "LoopLapClosedPayload": {
      "description": "NDF の開発ループが締めた周回（.ndf/loop/<名>/loop.json の翻訳）",
      "type": "object",
      "additionalProperties": false,
      "required": ["loop", "lap", "issues", "result", "version", "cost_usd", "seconds", "pending"],
      "properties": {
        "loop": { "$ref": "#/$defs/LoopName" },
        "lap": { "type": "integer", "minimum": 1 },
        "issues": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "result": { "type": "string", "enum": ["完了", "失敗", "人へ戻した"] },
        "version": { "description": "開発版と本番の版。無ければ null", "type": ["string", "null"], "maxLength": 200 },
        "cost_usd": { "type": "number", "minimum": 0 },
        "seconds": { "type": "number", "minimum": 0 },
        "pending": { "type": "array", "items": { "$ref": "#/$defs/LoopPending" } }
      }
    },
    "LoopStopCondition": {
      "description": "NDF の開発ループの止まる条件",
      "type": "string",
      "enum": [
        "user_stop",
        "mvv_changed",
        "same_failure",
        "budget_laps",
        "budget_usd",
        "budget_hours",
        "no_issue",
        "outside_mvv",
        "gate2_returned",
        "refused"
      ]
    },
    "LoopStoppedPayload": {
      "description": "NDF の開発ループが止まる条件に当たった（loop.json の stop の翻訳）",
      "type": "object",
      "additionalProperties": false,
      "required": ["loop", "condition", "detail", "pending"],
      "properties": {
        "loop": { "$ref": "#/$defs/LoopName" },
        "condition": { "$ref": "#/$defs/LoopStopCondition" },
        "detail": { "description": "stop の残りの値の JSON", "type": "string", "maxLength": 4000 },
        "pending": { "type": "array", "items": { "$ref": "#/$defs/LoopPending" } }
      }
    },
    "GateAnsweredPayload": {
      "description": "本文は持たない。decision は kind が decision のときは持たず、ほかでは必須",
      "type": "object",
      "additionalProperties": false,
      "required": ["approval_request_id", "kind", "answered_by_account_id"],
      "properties": {
        "approval_request_id": { "type": "string", "minLength": 1 },
        "kind": { "$ref": "#/$defs/GateKind" },
        "decision": { "type": "string", "enum": ["approved", "rejected"] },
        "answered_by_account_id": { "type": "string", "minLength": 1 }
      },
      "if": { "properties": { "kind": { "const": "decision" } } },
      "then": { "not": { "required": ["decision"] } },
      "else": { "required": ["decision"] }
    },
    "UsageRecordedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "input_tokens", "output_tokens", "cost_usd", "step"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "cost_usd": { "type": "number", "minimum": 0 },
        "step": { "type": "string" }
      }
    },
    "JobFinishedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "summary"],
      "properties": {
        "result": { "type": "string", "enum": ["gate", "stopped", "done", "failed"] },
        "summary": { "type": "string" },
        "reason": {
          "description": "stopped の理由。section_limit は区間の上限、usage_limit は local の利用上限。release_requested は gate の理由で、手動の実行がリリースの依頼を出して答えを待つ（#2439）",
          "type": "string",
          "enum": ["section_limit", "usage_limit", "release_requested"]
        },
        "resets_at": {
          "description": "usage_limit のときだけ。利用上限のリセット時刻（読めなければ null）",
          "type": ["string", "null"],
          "format": "date-time"
        }
      },
      "if": { "required": ["resets_at"] },
      "then": { "required": ["reason"], "properties": { "reason": { "const": "usage_limit" } } }
    },
    "PrUpdatedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "number", "state"],
      "properties": {
        "repo": { "$ref": "#/$defs/RepoFullName" },
        "number": { "$ref": "#/$defs/PullRequestNumber" },
        "state": { "type": "string", "enum": ["open", "closed", "merged"] }
      }
    },
    "CiUpdatedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "pr_number", "name", "conclusion"],
      "properties": {
        "repo": { "$ref": "#/$defs/RepoFullName" },
        "pr_number": { "$ref": "#/$defs/PullRequestNumber" },
        "name": { "type": "string", "minLength": 1 },
        "conclusion": { "description": "null はまだ終わっていない", "type": ["string", "null"] }
      }
    },
    "DecisionDelegatedPayload": {
      "description": "承認ゲートの外の問い合わせを hook が止めた後に、AI が自分で下した判断（#2206）",
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "answer", "reason", "category"],
      "properties": {
        "question": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "answer": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "category": { "description": "止めたときの metadata.source。無ければ null", "type": ["string", "null"] }
      }
    },
    "IssueRequestedPayload": {
      "description": "実行のリポジトリと別のリポジトリへの起票の依頼（#2216）。起票はサービスが行い、ランナーは送るだけ",
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "title", "body"],
      "properties": {
        "repo": { "description": "起票先。token の repo と違うものだけを受ける", "$ref": "#/$defs/RepoFullName" },
        "title": { "type": "string", "minLength": 1, "maxLength": 256 },
        "body": { "type": "string", "minLength": 1, "maxLength": 50000 }
      }
    },
    "IssueRef": {
      "description": "サービスが起票した Issue の参照",
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "number", "url"],
      "properties": {
        "repo": { "$ref": "#/$defs/RepoFullName" },
        "number": { "type": "integer", "minimum": 1 },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "IssueRequestResolvedPayload": {
      "description": "起票の依頼 1 件ごとの結果（#2216）。filed は起票した Issue の参照を、drafted は下書きへ回した理由を持つ",
      "type": "object",
      "additionalProperties": false,
      "required": ["request_key", "outcome", "duplicate_of"],
      "properties": {
        "request_key": { "description": "依頼の冪等の鍵（<job_id>:<seq>）", "type": "string", "minLength": 1, "maxLength": 290 },
        "outcome": { "type": "string", "enum": ["filed", "drafted"] },
        "issue": { "$ref": "#/$defs/IssueRef" },
        "reason": {
          "type": "string",
          "enum": ["not_registered", "not_installed", "unsupported_tracker", "visibility", "secret_suspected", "limit_exceeded", "filing_failed"]
        },
        "duplicate_of": { "description": "同じ中身の最初の依頼の鍵。最初の依頼なら null", "type": ["string", "null"] }
      },
      "if": { "properties": { "outcome": { "const": "filed" } } },
      "then": { "required": ["issue"], "not": { "required": ["reason"] } },
      "else": { "required": ["reason"], "not": { "required": ["issue"] } }
    },
    "ReleaseLaneName": {
      "description": "並列のレーンの名前（Factory では loop-<ループの ID> / run-<実行の ID>。#2439）",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,140}$"
    },
    "ReleaseRequestId": {
      "description": "NDF が作るリリースの依頼の id（<レーンの名前>-r<乱数>）",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,160}$"
    },
    "ReleaseCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,64}$"
    },
    "ReleaseVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "NumberList": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 }
    },
    "ReleaseRequestedPayload": {
      "description": "実行がリリースの代わりに出したリリースの依頼（#2439）。NDF の置き場の requests/ の写し",
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "lane", "prs", "issues", "ndf_version", "requested_at"],
      "properties": {
        "request_id": { "$ref": "#/$defs/ReleaseRequestId" },
        "lane": { "$ref": "#/$defs/ReleaseLaneName" },
        "prs": { "$ref": "#/$defs/NumberList" },
        "issues": { "$ref": "#/$defs/NumberList" },
        "ndf_version": { "type": "string", "minLength": 1, "maxLength": 200 },
        "requested_at": { "type": "string", "format": "date-time" }
      }
    },
    "ReleasePresentedLane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane", "requested"],
      "properties": {
        "lane": { "$ref": "#/$defs/ReleaseLaneName" },
        "requested": { "description": "そのレーンがリリースの依頼を出したか", "type": "boolean" }
      }
    },
    "ReleasePresentedPayload": {
      "description": "リリースの実行が承認資料をそろえた提示（#2439）。auto は MVV 判定がリリース承認ゲートを通したとき真",
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "k", "sha", "version", "prs", "lanes", "added_prs", "auto"],
      "properties": {
        "seq": { "type": "integer", "minimum": 1 },
        "k": { "description": "提示の番号。出し直しは 2", "type": "integer", "enum": [1, 2] },
        "sha": { "$ref": "#/$defs/ReleaseCommit" },
        "version": { "$ref": "#/$defs/ReleaseVersion" },
        "prs": { "$ref": "#/$defs/NumberList" },
        "lanes": { "type": "array", "items": { "$ref": "#/$defs/ReleasePresentedLane" } },
        "added_prs": { "$ref": "#/$defs/NumberList" },
        "auto": { "type": "boolean" }
      }
    },
    "ReleaseProgressPayload": {
      "description": "リリースの実行のリリースが届いた段（#2439）",
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "stage"],
      "properties": {
        "seq": { "type": "integer", "minimum": 1 },
        "stage": { "type": "string", "enum": ["release_branch", "develop_merged", "prod_pr_opened", "main_merged", "tagged"] }
      }
    },
    "ReleaseSettledPayload": {
      "description": "リリースの実行の結果（#2439）",
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "result", "prs", "lanes"],
      "properties": {
        "seq": { "type": "integer", "minimum": 1 },
        "result": { "type": "string", "enum": ["released", "failed"] },
        "version": { "$ref": "#/$defs/ReleaseVersion" },
        "prod_pr_url": { "type": "string", "format": "uri" },
        "sha": { "$ref": "#/$defs/ReleaseCommit" },
        "prs": { "$ref": "#/$defs/NumberList" },
        "lanes": { "type": "array", "items": { "$ref": "#/$defs/ReleaseLaneName" } },
        "reason": { "type": "string", "maxLength": 4000 }
      }
    },
    "ReleaseAnsweredPayload": {
      "description": "Factory のオーガナイザーが範囲の実行へ返したリリースの答え（#2439）",
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "result"],
      "properties": {
        "seq": { "type": "integer", "minimum": 1 },
        "request_id": { "$ref": "#/$defs/ReleaseRequestId" },
        "result": { "type": "string", "enum": ["released", "rejected"] },
        "version": { "$ref": "#/$defs/ReleaseVersion" },
