{
  "name": "ndf-factory",
  "private": true,
  "workspaces": [
    "contracts",
    "web",
    "api",
    "runner"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint:contracts": "spectral lint contracts/openapi/*.yaml --ruleset contracts/openapi/.spectral.yaml --fail-severity warn",
    "check": "npm run lint:contracts && npm run check -w contracts && npm run check -w web && npm run check -w api && npm run check -w runner"
  },
  "devDependencies": {
    "@stoplight/spectral-cli": "^6.15.0"
  }
}
