{
  "name": "@ndf-factory/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:dummy": "vite --mode dummy",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:source": "node scripts/check-source.ts",
    "check:bundle": "node scripts/check-bundle.ts",
    "check": "npm run typecheck && npm run test && npm run check:source && vite build && npm run check:bundle",
    "e2e": "playwright test"
  },
  "dependencies": {
    "i18next": "^26.7.1",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.11",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "oxc-parser": "^0.156.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
