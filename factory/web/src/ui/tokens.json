{
  "color": {
    "base": { "$type": "color", "$value": "#ffffff", "$description": "画面の地" },
    "surface": { "$type": "color", "$value": "#f5f6f8", "$description": "帯・カード・表の見出しの地" },
    "text": { "$type": "color", "$value": "#1c2330", "$description": "本文" },
    "muted": { "$type": "color", "$value": "#5b6576", "$description": "補足の文" },
    "border": { "$type": "color", "$value": "#d5dae2", "$description": "線" },
    "primary": { "$type": "color", "$value": "#1f5fbf", "$description": "主の操作・リンク" },
    "on-primary": { "$type": "color", "$value": "{color.base}", "$description": "主の操作の上の文字" },
    "neutral": { "$type": "color", "$value": "#5b6576" },
    "neutral-bg": { "$type": "color", "$value": "#eceff3" },
    "info": { "$type": "color", "$value": "#1f5fbf" },
    "info-bg": { "$type": "color", "$value": "#e6eefa" },
    "success": { "$type": "color", "$value": "#1d7a3e" },
    "success-bg": { "$type": "color", "$value": "#e5f4ea" },
    "warning": { "$type": "color", "$value": "#8a5a00" },
    "warning-bg": { "$type": "color", "$value": "#fdf2dc" },
    "danger": { "$type": "color", "$value": "#b42318" },
    "danger-bg": { "$type": "color", "$value": "#fdeceb" },
    "on-danger": { "$type": "color", "$value": "{color.base}" }
  },
  "space": {
    "1": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
    "2": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "3": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
    "4": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
    "6": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
    "8": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "$value": ["system-ui", "-apple-system", "Hiragino Sans", "Noto Sans JP", "sans-serif"]
    },
    "mono": { "$type": "fontFamily", "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "monospace"] },
    "size": {
      "sm": { "$type": "dimension", "$value": { "value": 0.875, "unit": "rem" } },
      "md": { "$type": "dimension", "$value": { "value": 1, "unit": "rem" } },
      "lg": { "$type": "dimension", "$value": { "value": 1.25, "unit": "rem" } },
      "xl": { "$type": "dimension", "$value": { "value": 1.5, "unit": "rem" } }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    },
    "line-height": { "$type": "number", "$value": 1.6 }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
    "md": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "pill": { "$type": "dimension", "$value": { "value": 999, "unit": "px" } }
  },
  "size": {
    "touch": { "$type": "dimension", "$value": { "value": 44, "unit": "px" }, "$description": "押せる大きさの下限" },
    "content": { "$type": "dimension", "$value": { "value": 1080, "unit": "px" }, "$description": "本文の幅の上限" }
  }
}
